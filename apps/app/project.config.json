{
  "miniprogramRoot": "dist/weapp/",
  "projectname": "robowiki-app",
  "description": "RoboWiki 交互端（Taro）：目录、详情、评分/讨论、账号、投稿纠错",
  "appid": "wx13bffd77b0b597e2",
  "compileType": "miniprogram",
  "libVersion": "3.17.6",
  "setting": {
    "urlCheck": true,
    "es6": false,
    "enhance": false,
    "postcss": false,
    "minified": false,
    "minifyWXML": true,
    "minifyWXSS": true,
    "ignoreUploadUnusedFiles": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "packOptions": {
    "ignore": [
      {
        "value": "node_modules",
        "type": "folder"
      },
      {
        "value": "src",
        "type": "folder"
      }
    ],
    "include": []
  }
}
