{
  "name": "@robowiki/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RoboWiki 交互端（Vite + React 19 + Taro，微信小程序与 H5）",
  "scripts": {
    "dev:wx": "cross-env VITE_VPT_TARGET=wx vite",
    "dev:h5": "cross-env VITE_VPT_TARGET=h5 vite",
    "build:wx": "cross-env VITE_VPT_TARGET=wx vite build",
    "build:h5": "cross-env VITE_VPT_TARGET=h5 vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@robowiki/content": "workspace:*",
    "@robowiki/core": "workspace:*",
    "@robowiki/tokens": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "postcss-rule-unit-converter": "^0.3.0",
    "rolldown": "1.2.16",
    "typescript": "^5.9.0",
    "vite": "8.3.6",
    "vite-plugin-taro": "^0.8.7"
  }
}
