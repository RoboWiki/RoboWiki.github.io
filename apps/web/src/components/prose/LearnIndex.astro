---
import { getCollection, render } from 'astro:content'
import Prose from '@/layouts/Prose.astro'
import MaterialGrid from '@/components/prose/MaterialGrid.astro'
import { withBase } from '@/lib/utils'
import learnData from '@/data/learn.json'

const entries = await getCollection('learn')
const index = entries.find(e => e.id === 'index')
if (!index) throw new Error('learn/index.md 缺失')
const { Content } = await render(index)

const cards = (learnData.resources || []).map(a => ({
  title: a.title,
  href: a.web_path,
  meta: a.type === 'pdf' ? `${a.pages || '—'} 页 · ${a.level}` : `${a.minutes || '—'} 分钟 · ${a.level}`,
  tags: a.tags,
  what: a.summary,
  when: a.source,
}))

const reprint = learnData.reprint
---

<Prose title={index.data.title} description={index.data.description} eyebrow="指南" crumbs={[{ label: '指南' }]}>
  <Fragment slot="lead">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">文章</h2>
    <div class="mt-3">
      <MaterialGrid items={cards} />
    </div>

    <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">{reprint.title}</p>
      <p class="mt-1 text-xs leading-6 text-slate-600">{reprint.summary}</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-6 text-slate-600">
        {reprint.rules.map(rule => <li>{rule}</li>)}
      </ul>
      <a href={withBase(`${reprint.link}.html`)} class="mt-3 inline-block text-xs font-semibold text-blue-700 hover:underline">
        转载规范全文 →
      </a>
    </div>
  </Fragment>

  <Content />
</Prose>
