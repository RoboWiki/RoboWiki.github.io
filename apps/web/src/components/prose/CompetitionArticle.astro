---
import { getCollection, render } from 'astro:content'
import Prose from '@/layouts/Prose.astro'
import { withBase } from '@/lib/utils'

type Props = { id: string }

const GROUP_LABELS: Record<string, string> = {
  ec: '电控',
  hardware: '硬件',
  mechanical: '机械',
  pm: '项目管理',
  rl: '强化学习',
}

const { id } = Astro.props
const all = await getCollection('competitions')
const entry = all.find(e => e.id === id)
if (!entry) throw new Error(`competitions/${id}.md 缺失`)
const { Content } = await render(entry)

const [group] = entry.id.split('/')
const groupLabel = GROUP_LABELS[group] ?? '实战资料'
const isGroupIndex = !entry.id.includes('/') || entry.id.endsWith('/index')
const groupIndex = all.find(e => e.id === `${group}/index`) ?? all.find(e => e.id === group)
const groupHref = groupIndex ? `/competitions/${groupIndex.id}.html` : '/competitions.html'

const siblings = all
  .filter(e => e.id.startsWith(`${group}/`) && e.id !== entry.id && e.id !== groupIndex?.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))

const crumbs = isGroupIndex
  ? [{ label: '实战资料', href: '/competitions.html' }, { label: groupLabel }]
  : [
      { label: '实战资料', href: '/competitions.html' },
      { label: groupLabel, href: groupHref },
      { label: entry.data.title },
    ]
---

<Prose title={entry.data.title} description={entry.data.description} eyebrow={isGroupIndex ? `实战资料 · ${groupLabel}` : groupLabel} crumbs={crumbs}>
  <Content />

  <Fragment slot="after">
    {isGroupIndex && siblings.length > 0 && (
      <section class="mt-12 border-t border-line pt-6" aria-labelledby="group-articles">
        <h2 id="group-articles" class="text-sm font-semibold text-ink">本组文章</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {siblings.map(item => (
            <li>
              <a
                href={withBase(`/competitions/${item.id}.html`)}
                class="block h-full rounded-lg border border-line px-3 py-2 text-sm text-ink-2 hover:border-brand/40 hover:text-brand"
              >
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {!isGroupIndex && (
      <nav aria-label="返回模块" class="mt-12 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-6 text-sm font-medium">
        <a href={withBase(groupHref)} class="text-brand hover:underline">← 返回{groupLabel}</a>
        <a href={withBase('/competitions.html')} class="text-brand hover:underline">全部竞赛资料</a>
      </nav>
    )}
  </Fragment>
</Prose>
