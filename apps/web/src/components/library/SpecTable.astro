---
type Row = { label: string; value: string }
const {
  rows,
  title = '关键参数',
  id = 'specs',
  note,
  hint,
} = Astro.props as { rows: Row[]; title?: string; id?: string; note?: string | null; hint?: string }
const filled = rows.filter((row) => row.value !== '—').length
---

<section class="card p-5" aria-labelledby={id}>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id={id} class="text-sm font-semibold text-ink">{title}</h2>
    <span class="mono tabular text-xs text-ink-3">
      {filled} / {rows.length} 项有公开值
    </span>
  </div>
  {hint && <p class="mt-1.5 text-xs leading-5 text-ink-3">{hint}</p>}
  <dl class="mt-4 grid gap-x-8 sm:grid-cols-2">
    {rows.map((row) => (
      <div class="flex items-start justify-between gap-4 border-b border-line py-2 text-sm last:border-0">
        <dt class="text-ink-3">{row.label}</dt>
        <dd class="mono tabular text-right font-medium text-ink">
          {row.value === '—' ? <span class="text-ink-3">—</span> : row.value}
        </dd>
      </div>
    ))}
  </dl>
  {note && (
    <p class="mt-4 rounded-md border border-line bg-surface-2 p-3 text-sm leading-6 text-ink-2">{note}</p>
  )}
</section>
