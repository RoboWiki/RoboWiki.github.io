---
type Row = { label: string; value: string }
const {
  rows,
  title = '关键参数',
  id = 'specs',
  note,
  hint,
} = Astro.props as { rows: Row[]; title?: string; id?: string; note?: string | null; hint?: string }
---

<section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby={id}>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id={id} class="font-semibold text-slate-900">{title}</h2>
    <span class="text-xs text-slate-400">{rows.filter((row) => row.value !== '—').length} / {rows.length} 项有公开值</span>
  </div>
  {hint && <p class="mt-1 text-xs leading-5 text-slate-500">{hint}</p>}
  <dl class="mt-3 grid gap-x-6 sm:grid-cols-2">
    {rows.map((row) => (
      <div class="flex items-start justify-between gap-4 border-b border-slate-100 py-1.5 text-sm">
        <dt class="text-slate-500">{row.label}</dt>
        <dd class="text-right font-medium tabular-nums text-slate-800">{row.value}</dd>
      </div>
    ))}
  </dl>
  {note && <p class="mt-3 rounded-lg bg-slate-50 p-3 text-sm leading-6 text-slate-600">{note}</p>}
</section>
