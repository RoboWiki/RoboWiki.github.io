---
import Base from '@/layouts/Base.astro'
import { categoryLabel, imageUrl, parts, type CatalogPart } from '@/lib/catalog'
import { bestOfferPrice, formatPrice, partHref, withBase } from '@/lib/utils'

type Group = { key: string; label: string; slugs: string[] }
const { category, group } = Astro.props as { category: string; group: Group }
const groupParts = group.slugs
  .map(slug => parts.find(p => p.category === category && p.slug === slug))
  .filter(Boolean) as CatalogPart[]
const title = `${group.label} · ${categoryLabel(category)} · RoboWiki`
const description = `${categoryLabel(category)} · ${group.label}，共 ${groupParts.length} 个型号的参数、价格、来源与真实使用经验。`
const tierOf = (tier?: string) =>
  tier === 'A' ? 'tier tier-a' : tier === 'B' ? 'tier tier-b' : 'tier tier-c'
---

<Base title={title} description={description}>
  <nav class="mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-ink-3" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-brand">首页</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={withBase('/catalog.html')} class="hover:text-brand">部件库</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={withBase(`/parts/${category}.html`)} class="hover:text-brand">{categoryLabel(category)}</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <span class="text-ink-2" aria-current="page">{group.label}</span>
  </nav>

  <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{group.label}</h1>
      <p class="mt-1.5 text-sm text-ink-3">
        {categoryLabel(category)} · 共 <span class="mono tabular font-semibold text-ink">{groupParts.length}</span> 个型号
      </p>
    </div>
    <a href={`${withBase('/catalog.html')}?category=${category}`} class="text-sm font-medium text-brand hover:underline">
      在部件库中筛选 →
    </a>
  </header>

  <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
    {groupParts.map(p => (
      <li>
        <a href={partHref(p)} class="group flex h-full rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:ring-offset-2">
          <div class="card card-hover flex h-full w-full flex-col overflow-hidden transition duration-200 group-hover:-translate-y-0.5">
            <div class="relative flex h-32 shrink-0 items-center justify-center border-b border-line bg-surface-2">
              {p.image
                ? <img src={imageUrl(p)} alt={`${p.vendor} ${p.model}`} loading="lazy" class="h-full w-full object-contain p-4 transition-transform duration-300 group-hover:scale-[1.03]" />
                : <span class="px-4 text-center text-xs text-ink-3">暂无产品图</span>}
              {p.tier && <span class={`${tierOf(p.tier)} absolute left-2 top-2`}>{p.tier} 级</span>}
            </div>
            <div class="flex flex-1 flex-col gap-2 p-4">
              <div class="truncate text-[11px] text-ink-3">{p.vendor}</div>
              <div class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-ink">{p.model}</div>
              <div class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-2 text-xs">
                <span class="flex min-w-0 flex-col">
                  {(() => {
                    const offer = bestOfferPrice(p.offers)
                    const regular = typeof p.price === 'number' ? p.price : null
                    return (
                      <>
                        <span class={`mono tabular truncate font-medium ${offer !== null ? 'text-brand' : 'text-ink-2'}`}>
                          {formatPrice(offer ?? regular)}
                          {offer !== null && <span class="ml-1 text-[10px] font-normal">活动价</span>}
                        </span>
                        {offer !== null && regular !== null && offer < regular && (
                          <span class="mono tabular text-[10px] text-ink-3 line-through">参考 {formatPrice(regular)}</span>
                        )}
                      </>
                    )
                  })()}
                </span>
                <span class="text-ink-3">{p.verified ? '已核对' : ''}</span>
              </div>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>
