---
import Base from '@/layouts/Base.astro'
import Intro from '@/components/Intro.astro'
import RatingSummary from '@/components/RatingSummary'
import SeoJsonLd from '@/components/SeoJsonLd.astro'
import fs from 'node:fs'
import path from 'node:path'
import { categoryLabel, imageUrl, type CatalogPart } from '@/lib/catalog'
import { bestOfferPrice, formatPrice, withBase } from '@/lib/utils'
import semantics from '@/data/semantics.json'
import { formatSpecValue, specLabel as contentSpecLabel } from '@robowiki/content'
import { layerOfCategory } from '@/lib/layers'

const { part } = Astro.props as { part: CatalogPart }
const squareShare = `/share/parts/${part.category}/${part.slug}-square.jpg`
const squareShareFile = path.join(process.cwd(), 'public', squareShare)
const shareImage = imageUrl(part) && fs.existsSync(squareShareFile)
  ? withBase(squareShare)
  : imageUrl(part)

const sim = (() => {
  if (part.category !== 'actuator') return null
  const s = (part.specs ?? {}) as Record<string, unknown>
  const num = (v: unknown) => {
    const n = typeof v === 'number' ? v : Number(v)
    return Number.isFinite(n) ? n : null
  }
  const fmt = (v: number | null) => (v == null ? null : String(Number(v.toPrecision(6))))
  const peak = num(s.tau_peak_Nm)
  const rated = num(s.tau_rated_Nm)
  const mass = num(s.mass_kg)
  const inertia = num(s.armature_kgm2) ?? num(s.rotor_inertia_kgm2)
  const gear = num(s.gear)
  const rpm = num(s.speed_noload_rpm)
  const vel = rpm == null ? null : rpm * Math.PI / 30
  if (peak == null && rated == null && mass == null && inertia == null && vel == null) return null
  const p = fmt(peak) ?? 'TODO_peak'
  const v = fmt(vel) ?? 'TODO_velocity'
  const json = JSON.stringify({
    joint_name: 'TODO_joint',
    mass_kg: mass,
    armature_kgm2: inertia,
    effort_Nm: peak,
    velocity_rad_s: vel,
    gear,
  }, null, 2)
  const mjcf = `<!-- ${part.vendor} ${part.model}；替换 joint_name 与 range -->
<joint name="joint_name" type="hinge" range="-3.1416 3.1416" armature="${fmt(inertia) ?? 'TODO_inertia'}" limited="true"/>
<actuator>
  <motor name="joint_name_motor" joint="joint_name" gear="1" ctrlrange="-${p} ${p}"/>
</actuator>
<!-- 若 MJCF 用 gear=减速比，ctrlrange 改为 ±峰值扭矩/减速比；本机减速比 ${fmt(gear) ?? 'TODO'} -->`
  const urdf = `<!-- 替换 parent_link / child_link / origin / axis / 限位 -->
<joint name="joint_name" type="revolute">
  <parent link="parent_link"/>
  <child link="child_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-3.1416" upper="3.1416" effort="${p}" velocity="${v}"/>
  <dynamics damping="0.05" friction="0.01"/>
</joint>
<!-- child link inertial：mass=${fmt(mass) ?? 'TODO_mass'} kg；ixx=iyy=izz=${fmt(inertia) ?? 'TODO_inertia'} -->`
  return { json, mjcf, urdf }
})()
type FieldMeta = { label?: string; unit?: string; meaning?: string; missing_means?: string }
const fieldSemantics = (semantics as { field_semantics?: Record<string, FieldMeta> }).field_semantics ?? {}
// 语义表优先；目录里出现的新字段（尚未写进 semantics.json）用内容包兜底，
// 至少把单位后缀剥掉、把 snake_case 变成可读词，而不是原样抛出 key。
const specLabel = (key: string) => fieldSemantics[key]?.label || contentSpecLabel(key).label
const specUnit = (key: string) => fieldSemantics[key]?.unit || contentSpecLabel(key).unit
const specMeaning = (key: string) => fieldSemantics[key]?.meaning ?? ''
type SpecLink = { href: string; text: string }
type SpecRow = { key: string; label: string; value: string; unit: string; meaning: string; links?: SpecLink[] }
const isScalar = (v: unknown) => ['string', 'number', 'boolean'].includes(typeof v)
// 这些字段在「资料与仓库」里单独渲染成可点链接，不再进参数表。
const LINK_SPEC_KEYS = new Set(['doc_url', 'doc_pdf', 'repo_urls', 'urdf_urls', 'repo_license'])
const isUrl = (v: string) => /^https?:\/\//i.test(v.trim())
// 少数舵机把 gear 当「齿轮材质」用（钢齿 / 金属齿），不能显示成减速比。
const isNumericText = (v: unknown) => typeof v === 'number' || (typeof v === 'string' && /^[\d.:\s]+$/.test(v))
// 数据里的 PDF 地址有的带空格和中文，href 需要转义，但不能二次转义已有的 %xx。
const safeHref = (url: string) => url.trim().replace(/[^\x21-\x7E]+/g, chunk => encodeURIComponent(chunk))

/** 参数表里的链接只展示可读短名，完整 URL 放 title，避免把一长串地址塞进右栏。 */
const shortUrl = (url: string): string => {
  try {
    const parsed = new URL(url)
    const host = parsed.hostname.replace(/^www\./, '')
    const rawPath = parsed.pathname.replace(/^\/|\/$/g, '')
    let path = rawPath
    try { path = decodeURIComponent(rawPath) } catch { /* 保留原编码 */ }
    if (/(^|\.)(github|gitee)\.com$/.test(host)) return path || host
    return `${host}${path ? `/${path}` : ''}`
  } catch {
    return url
  }
}
const linkText = (key: string, url: string) => (key === 'doc_pdf' ? '查看 PDF' : shortUrl(url))
/** 单位不重复追加；减速比的 :1 直接贴成 9:1，避免显示成「9 :1」。 */
const withUnit = (key: string, text: string, unit: string): { value: string; unit: string } => {
  if (!unit || text.includes(unit)) return { value: text, unit: '' }
  if (key === 'gear' && unit === ':1') {
    return /^[\d.]+$/.test(text) ? { value: `${text}:1`, unit: '' } : { value: text, unit: '' }
  }
  return { value: text, unit }
}

/**
 * 参数值有三种形态：标量、数组、对象。
 * 直接 String() 会把对象渲染成 [object Object]（曾出现在 155 个页面上）：
 * - 标量 → 一行
 * - 字符串/数字数组 → 顿号连接
 * - 扁平对象（芯片的 params）→ 拆成多行
 * - 价格阶梯等对象数组 → 单独表格，不进参数表
 */
const toSpecRows = (specs: Record<string, unknown> = {}): SpecRow[] => {
  const rows: SpecRow[] = []
  for (const [key, value] of Object.entries(specs)) {
    if (LINK_SPEC_KEYS.has(key)) continue
    if (value === null || value === undefined || value === '') continue
    const label = key === 'connector_wire' && typeof value === 'string' && !/\d\s*(?:cm|mm|m)\b/i.test(value)
      ? '接线 / 接口'
      : key === 'gear' && !isNumericText(value) ? '齿轮材质' : specLabel(key)
    const meaning = specMeaning(key)
    if (Array.isArray(value)) {
      if (value.length && value.every(isScalar)) {
        if (value.every(item => typeof item === 'string' && isUrl(item))) {
          rows.push({
            key, label, value: '', unit: '', meaning,
            links: value.map(item => ({ href: safeHref(item as string), text: linkText(key, item as string) })),
          })
        } else {
          const text = value.map(item => formatSpecValue(item)).join('、')
          rows.push({ key, label, ...withUnit(key, text, specUnit(key)), meaning })
        }
      }
      continue
    }
    if (typeof value === 'object') {
      const entries = Object.entries(value as Record<string, unknown>)
      if (entries.length && entries.every(([, v]) => isScalar(v) || v === null)) {
        for (const [subKey, subValue] of entries) {
          if (subValue === null || subValue === undefined || subValue === '') continue
          rows.push({ key: `${key}.${subKey}`, label: subKey, value: formatSpecValue(subValue), unit: '', meaning: '' })
        }
      }
      continue
    }
    if (typeof value === 'string' && isUrl(value)) {
      rows.push({ key, label, value: '', unit: '', meaning, links: [{ href: safeHref(value), text: linkText(key, value) }] })
      continue
    }
    const text = formatSpecValue(value)
    rows.push({ key, label, ...withUnit(key, text, specUnit(key)), meaning })
  }
  return rows
}

const allRows = toSpecRows(part.specs as Record<string, unknown>)
const specEntries = allRows.slice(0, 40)
const allSpecs = Object.entries(part.specs || {})
const missing = allSpecs.filter(([, v]) => v === null || v === undefined || v === '').length
const repoLicense = part.specs?.repo_license as string | null | undefined
type PartLink = { kind: string; url: string }
const partLinks: PartLink[] = []
const pushLink = (kind: string, raw: unknown) => {
  const url = String(raw ?? '').trim()
  if (!/^https?:\/\//i.test(url)) return
  if (partLinks.some(link => link.url === url)) return
  partLinks.push({ kind, url })
}
pushLink('资料页', part.specs?.doc_url)
pushLink('数据表', part.specs?.doc_pdf)
for (const url of (part.specs?.repo_urls as string[] | undefined) ?? []) pushLink('仓库', url)
for (const url of (part.specs?.urdf_urls as string[] | undefined) ?? []) pushLink('URDF', url)
type Offer = {
  title?: string
  kind?: string
  price?: number | null
  discount?: number | string | null
  condition?: string | null
  url?: string | null
  expires?: string | null
  source?: string | null
  demo?: boolean
}
const today = new Date().toISOString().slice(0, 10)
const offers = ((part.offers ?? []) as Offer[])
  .filter(o => o && !o.demo && (!o.expires || o.expires >= today))
const bestOffer = bestOfferPrice(part.offers as Array<Record<string, unknown>>)
const regularReference = typeof part.price === 'number' && Number.isFinite(part.price) ? part.price : null
const showCompare = bestOffer !== null && regularReference !== null && bestOffer < regularReference
const offerLink = (url?: string | null) => (url && /^https?:\/\//i.test(url) ? url : '')
const partPath = `/parts/${part.category}/${part.slug}.html`
const title = `${part.vendor} ${part.model} · RoboWiki`
const description = `${part.vendor} ${part.model} 的参数、来源、评分与真实使用经验。`
const layer = layerOfCategory(part.category)

// 顶部统计格不能写死成电机字段：芯片没有扭矩，硬显示 null 等于告诉用户「这里没数据」。
// 按一张全局优先级表取「确实有值」的字段，取不到就不显示这一格。
const STAT_PRIORITY: Array<{ key: string; label: string; unit: string }> = [
  { key: 'tau_peak_Nm', label: '峰值扭矩', unit: 'N·m' },
  { key: 'tau_rated_Nm', label: '额定扭矩', unit: 'N·m' },
  { key: 'gear', label: '减速比', unit: ':1' },
  { key: 'mass_kg', label: '质量', unit: 'kg' },
  { key: 'voltage_V', label: '母线电压', unit: 'V' },
  { key: 'power_w', label: '功率', unit: 'W' },
  { key: 'speed_rated_rpm', label: '额定转速', unit: 'rpm' },
  { key: 'range_m', label: '量程', unit: 'm' },
  { key: 'fps', label: '帧率', unit: 'fps' },
  { key: 'od_mm', label: '外径', unit: 'mm' },
]
const specSource = (part.specs ?? {}) as Record<string, unknown>
const keyStats = STAT_PRIORITY
  .filter(item => {
    const value = specSource[item.key]
    if (value === null || value === undefined || value === '') return false
    if (item.key === 'gear' && !isNumericText(value)) return false
    return true
  })
  .slice(0, 3)
  .map(item => ({ label: item.label, ...withUnit(item.key, formatSpecValue(specSource[item.key]), item.unit) }))
---

<Base title={title} description={description} image={shareImage}>
  <SeoJsonLd type="Product" title={`${part.vendor} ${part.model}`}
    description={`${part.model} 的参数、来源、评分与真实使用经验。`}
    url={partPath} image={shareImage} />

  <nav class="mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-ink-3" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-brand">首页</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={withBase('/catalog.html')} class="hover:text-brand">部件库</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={`${withBase('/catalog.html')}?category=${part.category}`} class="hover:text-brand">{categoryLabel(part.category)}</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <span class="text-ink-2" aria-current="page">{part.model}</span>
  </nav>

  <header class="card grid gap-6 p-5 sm:p-6 lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)]">
    <div class="flex h-52 items-center justify-center overflow-hidden rounded-md border border-line bg-surface-2 lg:h-full">
      {part.image
        ? <img src={imageUrl(part)} alt={`${part.vendor} ${part.model}`} class="h-full w-full object-contain p-4" />
        : (
          <span class="flex flex-col items-center gap-1.5 text-xs text-ink-3">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4" y="7" width="16" height="12" rx="2" />
              <path d="M12 3v4M9 12h.01M15 12h.01" stroke-linecap="round" />
            </svg>
            暂无产品图
          </span>
        )}
    </div>

    <div class="flex min-w-0 flex-col">
      <div class="flex flex-wrap items-center gap-1.5" data-guide="part-badges">
        <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-xs text-ink-2">{categoryLabel(part.category)}</span>
        {layer && (
          <a
            href={withBase(`/layers/${layer.id}.html`)}
            class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-xs text-ink-3 transition-colors hover:border-line-strong hover:text-brand"
          >
            {layer.index} {layer.name}
          </a>
        )}
        {part.subtypeLabel && <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-xs text-ink-2">{part.subtypeLabel}</span>}
      </div>
      <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{part.model}</h1>
      <p class="mt-1 text-sm text-ink-3">{part.vendor}</p>

      <dl class="mt-5 flex flex-wrap gap-2">
        {keyStats.map(s => (
          <div class="min-w-[7.5rem] rounded-md border border-line bg-surface-2 px-3.5 py-2.5">
            <dt class="text-xs text-ink-3">{s.label}</dt>
            <dd class="mono tabular mt-0.5 text-sm font-semibold text-ink">
              {s.value}
              {s.unit && <span class="ml-0.5 text-xs font-normal text-ink-3">{s.unit}</span>}
            </dd>
          </div>
        ))}
        <div class="min-w-[7.5rem] rounded-md border border-line bg-surface-2 px-3.5 py-2.5">
          <dt class="text-xs text-ink-3">
            {bestOffer !== null ? '优惠价' : '参考价'}
          </dt>
          <dd class="mt-0.5 flex flex-wrap items-baseline gap-x-1.5">
            <span class={`mono tabular text-sm font-semibold ${bestOffer !== null ? 'text-brand' : 'text-ink'}`}>
              {formatPrice(bestOffer ?? regularReference)}
            </span>
            {showCompare && (
              <span class="mono tabular text-xs text-ink-3">参考 {formatPrice(regularReference)}</span>
            )}
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="space-y-4">
      {part.notes && (
        <section class="card p-5 sm:p-6" aria-labelledby="notes">
          <h2 id="notes" class="text-base font-bold tracking-tight text-ink">简介</h2>
          <Intro text={part.notes} class="mt-3" />
        </section>
      )}

      {offers.length > 0 && (
        <section class="card p-5" aria-labelledby="offers">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="offers" class="text-sm font-semibold text-ink">渠道优惠 / 优惠价</h2>
            <span class="mono tabular text-xs text-ink-3">{offers.length} 条</span>
          </div>
          <ul class="mt-3 space-y-3">
            {offers.map(offer => (
              <li class="rounded-md border border-line bg-surface-2 p-3.5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="text-sm font-semibold text-ink">{offer.title || '渠道活动'}</p>
                  {offer.price != null && (
                    <span class="flex flex-wrap items-baseline gap-x-1.5">
                      <span class="mono tabular text-sm font-semibold text-brand">¥{Number(offer.price).toLocaleString('zh-CN')}</span>
                      {regularReference !== null && Number(offer.price) < regularReference && (
                        <span class="mono tabular text-xs text-ink-3 ">参考 {formatPrice(regularReference)}</span>
                      )}
                    </span>
                  )}
                </div>
                {offer.condition && <p class="mt-1.5 whitespace-pre-line text-sm leading-6 text-ink-2">{offer.condition}</p>}
                <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-3">
                  {offer.expires && <span>有效期至 {offer.expires}</span>}
                  {offer.source && <span>来源：{offer.source}</span>}
                  {offer.kind && <span>类型：{offer.kind}</span>}
                  {offerLink(offer.url) && (
                    <a href={offerLink(offer.url)} target="_blank" rel="noopener" class="font-medium text-brand hover:underline">查看活动 →</a>
                  )}
                </div>
                {offer.url && !offerLink(offer.url) && <p class="mt-1 text-xs text-ink-3">渠道：{offer.url}</p>}
              </li>
            ))}
          </ul>
          <p class="mt-3 text-xs leading-5 text-ink-3">
            优惠价通常有资格限制（如学生、参赛队、首购等），不是所有用户都能享受；价格、资格与截止时间以下单页面为准。本站不卖货、不收佣金。
          </p>
        </section>
      )}

      {part.builds && part.builds.length > 0 && (
        <section class="card p-5" aria-labelledby="builds">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="builds" class="text-sm font-semibold text-ink">包含此部件的全开源方案</h2>
            <span class="mono tabular text-xs text-ink-3">{part.builds.length} 套</span>
          </div>
          <p class="mt-1.5 text-xs leading-6 text-ink-3">
            这些整机公开了 BOM，并把该部件精确对到了站内条目；点进去看整机参数、开源仓库与 BOM 来源。
          </p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {part.builds.map(b => (
              <li>
                <a
                  href={withBase(b.url)}
                  class="group flex items-center justify-between gap-3 rounded-md border border-line bg-surface-2 px-3.5 py-2.5 transition-colors hover:border-line-strong hover:bg-surface-3"
                >
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-semibold text-ink group-hover:text-brand">{b.name}</span>
                    <span class="mt-0.5 block truncate text-xs text-ink-3">全开源 · 已发布 BOM</span>
                  </span>
                  <span class="shrink-0 text-xs font-medium text-brand" aria-hidden="true">查看方案 →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {sim && (
        <section class="card p-5" aria-labelledby="sim">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="sim" class="text-sm font-semibold text-ink">仿真参数（MJCF / URDF）</h2>
            <span class="text-xs text-ink-3">数值来自公开参数；TODO 需按整机替换</span>
          </div>
          <p class="mt-1.5 text-xs leading-6 text-ink-3">
            复制后替换关节名、父子连杆、轴向与限位。峰值扭矩按 datasheet 峰值填写，速度按空载转速换算为 rad/s。
          </p>
          <div class="mt-3 grid gap-3 lg:grid-cols-2">
            <div class="min-w-0 rounded-md border border-line bg-surface-2">
              <div class="flex items-center justify-between border-b border-line px-3 py-2">
                <span class="text-xs font-semibold text-ink">MJCF</span>
                <button type="button" data-copy-target="sim-mjcf" class="inline-flex h-7 items-center rounded-md border border-line bg-surface px-2.5 text-xs font-medium text-brand hover:border-brand/50">复制 MJCF</button>
              </div>
              <pre id="sim-mjcf" class="max-h-64 overflow-auto px-3 py-2 text-xs leading-5 text-ink-2">{sim.mjcf}</pre>
            </div>
            <div class="min-w-0 rounded-md border border-line bg-surface-2">
              <div class="flex items-center justify-between border-b border-line px-3 py-2">
                <span class="text-xs font-semibold text-ink">URDF</span>
                <button type="button" data-copy-target="sim-urdf" class="inline-flex h-7 items-center rounded-md border border-line bg-surface px-2.5 text-xs font-medium text-brand hover:border-brand/50">复制 URDF</button>
              </div>
              <pre id="sim-urdf" class="max-h-64 overflow-auto px-3 py-2 text-xs leading-5 text-ink-2">{sim.urdf}</pre>
            </div>
          </div>
          <details class="mt-3 rounded-md border border-line bg-surface-2">
            <summary class="cursor-pointer list-none px-3 py-2 text-xs font-medium text-ink-2">参数 JSON</summary>
            <div class="border-t border-line">
              <div class="flex justify-end px-3 pt-2">
                <button type="button" data-copy-target="sim-json" class="inline-flex h-7 items-center rounded-md border border-line bg-surface px-2.5 text-xs font-medium text-brand hover:border-brand/50">复制 JSON</button>
              </div>
              <pre id="sim-json" class="max-h-48 overflow-auto px-3 pb-3 text-xs leading-5 text-ink-2">{sim.json}</pre>
            </div>
          </details>
        </section>
      )}

      <section class="card" aria-labelledby="specs">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line px-5 py-4">
          <h2 id="specs" class="text-sm font-semibold text-ink">公开参数</h2>
          <span class="mono tabular text-xs text-ink-3">
            {specEntries.length} 项有值{missing > 0 && ` · ${missing} 项为 null`}
          </span>
        </div>
        <dl class="grid gap-x-8 px-5 py-4 sm:grid-cols-2">
          {specEntries.map(row => (
            <div class="flex items-start justify-between gap-4 border-b border-line py-2.5 text-sm last:border-0">
              <dt class="shrink-0" title={row.meaning || undefined}>
                <span class="text-ink-2">{row.label}</span>
                {row.label !== row.key && !row.key.includes('.') && (
                  <span class="mono ml-1.5 text-xs text-ink-3">{row.key}</span>
                )}
              </dt>
              <dd class="mono tabular min-w-0 break-words text-right font-medium text-ink">
                {row.links?.length ? (
                  <span class="inline-flex max-w-full flex-wrap justify-end gap-x-2 gap-y-0.5">
                    {row.links.map(link => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener"
                        title={link.href}
                        class="max-w-[220px] truncate align-bottom text-brand hover:underline"
                      >
                        {link.text} ↗
                      </a>
                    ))}
                  </span>
                ) : (
                  <>{row.value}{row.unit && <span class="ml-1 text-xs font-normal text-ink-3">{row.unit}</span>}</>
                )}
              </dd>
            </div>
          ))}
        </dl>
        {specEntries.length === 0 && (
          <p class="px-5 pb-5 text-sm text-ink-3">这个条目还没有公开参数，欢迎补充厂商手册中的原始值。</p>
        )}
      </section>

      {partLinks.length > 0 && (
        <section class="card p-5" aria-labelledby="links">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="links" class="text-sm font-semibold text-ink">资料与仓库</h2>
            <span class="mono text-xs text-ink-3">
              {repoLicense ? `许可：${repoLicense}` : '厂商资料 / 开源项目'}
            </span>
          </div>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {partLinks.map(link => (
              <li class="min-w-0">
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  class="flex min-h-9 items-center gap-2 rounded-md border border-line bg-surface-2 px-3 py-1.5 text-sm transition-colors hover:border-line-strong hover:text-brand"
                >
                  <span class="shrink-0 rounded border border-line bg-surface px-1.5 py-0.5 text-xs text-ink-3">{link.kind}</span>
                  <span class="min-w-0 truncate text-ink-2">{link.url.replace(/^https?:\/\/(www\.)?/, '')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20">
      <section id="reviews" class="card scroll-mt-24 p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-sm font-semibold text-ink">实际使用</h2>
          <a
            href={`https://github.com/RoboWiki/RoboWiki/issues?q=${encodeURIComponent(`is:issue ${part.id}`)}`}
            target="_blank" rel="noopener"
            class="text-xs font-medium text-brand hover:underline"
          >
            全部 issue <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="mt-3">
          <RatingSummary client:load partId={part.id} category={part.category} />
        </div>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">数据口径</h2>
        <ul class="mt-3 space-y-2 text-sm leading-6 text-ink-3">
          <li>缺失显示 <span class="mono">null</span>，表示厂商未公布，不是 0。</li>
          <li>参数均按厂商手册或官方数据表订正过，并保留来源与核对日期。</li>
          <li>评分少于 3 条时只显示样本，不给确定结论。</li>
        </ul>
        <a href={withBase('/method.html')} class="mt-3 inline-flex text-sm font-medium text-brand hover:underline">
          阅读方法与来源 →
        </a>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">和别的比一比</h2>
        <p class="mt-2 text-sm leading-6 text-ink-3">
          把这个条目和另外 1–3 个部件并排看，差异项会自动标出来。已加入的部件会保留，最多 4 个。
        </p>
        <button
          type="button"
          data-compare-add={part.id}
          data-compare-href={withBase('/compare.html')}
          class="mt-3 inline-flex h-11 items-center rounded-md border border-line px-3 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2 sm:h-9"
        >
          加入对比
        </button>
        <p data-compare-status role="status" aria-live="polite" class="mt-2 text-xs text-warning" hidden></p>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">发现错误？</h2>
        <p class="mt-2 text-sm leading-6 text-ink-3">参数写错、价格过期、链接失效都可以直接提纠正，进入下一个 data-v* 版本。</p>
        <a
          href={withBase('/submit.html')}
          class="mt-3 inline-flex h-9 items-center rounded-md border border-line px-3 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2"
        >
          提交纠正
        </a>
      </section>
    </aside>
  </div>

  <script is:inline>
    // 对比托盘存在 localStorage，直接跳 ?ids= 会覆盖用户已选的其他部件。
    // 这里按 id 去重后追加，写回再跳转；满 4 个就只提示、不跳。
    (() => {
      const KEY = 'rw-compare'
      const MAX = 4
      document.querySelectorAll('[data-compare-add]').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.getAttribute('data-compare-add') || ''
          const href = button.getAttribute('data-compare-href') || '/compare.html'
          const status = document.querySelector('[data-compare-status]')
          const notify = (text) => {
            if (!status) return
            status.textContent = text
            status.hidden = false
          }
          if (!id) return
          let list = []
          try {
            const raw = localStorage.getItem(KEY)
            const parsed = raw ? JSON.parse(raw) : []
            if (Array.isArray(parsed)) list = parsed.filter((item) => typeof item === 'string')
          } catch {
            // 存储里是坏数据时按空列表处理，不让它挡住加入对比。
          }
          if (!list.includes(id) && list.length >= MAX) {
            notify('最多对比 4 个')
            return
          }
          if (!list.includes(id)) list.push(id)
          list = list.slice(0, MAX)
          try {
            localStorage.setItem(KEY, JSON.stringify(list))
          } catch {
            notify('浏览器不允许写入本地存储，无法保留对比清单')
            return
          }
          window.location.href = href
        })
      })
    })()
  </script>

  <script is:inline>
    // 仿真参数一键复制：clipboard 不可用时退回选中文本，避免 HTTP/旧内核下点了没反应。
    (() => {
      document.querySelectorAll('[data-copy-target]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-copy-target')
          const el = id && document.getElementById(id)
          if (!el) return
          const text = el.textContent || ''
          const label = btn.textContent
          try {
            await navigator.clipboard.writeText(text)
          } catch {
            const range = document.createRange()
            range.selectNodeContents(el)
            const sel = window.getSelection()
            sel?.removeAllRanges()
            sel?.addRange(range)
            try { document.execCommand('copy') } catch {}
            sel?.removeAllRanges()
          }
          btn.textContent = '已复制'
          setTimeout(() => { btn.textContent = label }, 1600)
        })
      })
    })()
  </script>
</Base>
