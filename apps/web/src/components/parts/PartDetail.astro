---
import Base from '@/layouts/Base.astro'
import RatingSummary from '@/components/RatingSummary'
import SeoJsonLd from '@/components/SeoJsonLd.astro'
import { categoryLabel, imageUrl, type CatalogPart } from '@/lib/catalog'
import { formatPrice, withBase } from '@/lib/utils'
import semantics from '@/data/semantics.json'
import { layerOfCategory } from '@/lib/layers'

const { part } = Astro.props as { part: CatalogPart }
type FieldMeta = { label?: string; unit?: string; meaning?: string; missing_means?: string }
const fieldSemantics = (semantics as { field_semantics?: Record<string, FieldMeta> }).field_semantics ?? {}
const specLabel = (key: string) => fieldSemantics[key]?.label ?? key
const specUnit = (key: string) => fieldSemantics[key]?.unit ?? ''
const specMeaning = (key: string) => fieldSemantics[key]?.meaning ?? ''
type SpecRow = { key: string; label: string; value: string; unit: string; meaning: string }
const isScalar = (v: unknown) => ['string', 'number', 'boolean'].includes(typeof v)

/**
 * 参数值有三种形态：标量、数组、对象。
 * 直接 String() 会把对象渲染成 [object Object]（曾出现在 155 个页面上）：
 * - 标量 → 一行
 * - 字符串/数字数组 → 顿号连接
 * - 扁平对象（芯片的 params）→ 拆成多行
 * - 价格阶梯等对象数组 → 单独表格，不进参数表
 */
const toSpecRows = (specs: Record<string, unknown> = {}): SpecRow[] => {
  const rows: SpecRow[] = []
  for (const [key, value] of Object.entries(specs)) {
    if (value === null || value === undefined || value === '') continue
    if (Array.isArray(value)) {
      if (value.length && value.every(isScalar)) {
        rows.push({ key, label: specLabel(key), value: value.join('、'), unit: '', meaning: specMeaning(key) })
      }
      continue
    }
    if (typeof value === 'object') {
      const entries = Object.entries(value as Record<string, unknown>)
      if (entries.length && entries.every(([, v]) => isScalar(v) || v === null)) {
        for (const [subKey, subValue] of entries) {
          if (subValue === null || subValue === undefined || subValue === '') continue
          rows.push({ key: `${key}.${subKey}`, label: subKey, value: String(subValue), unit: '', meaning: '' })
        }
      }
      continue
    }
    rows.push({ key, label: specLabel(key), value: String(value), unit: specUnit(key), meaning: specMeaning(key) })
  }
  return rows
}

const allRows = toSpecRows(part.specs as Record<string, unknown>)
const specEntries = allRows.slice(0, 40)
const allSpecs = Object.entries(part.specs || {})
const missing = allSpecs.filter(([, v]) => v === null || v === undefined || v === '').length
const commits = (part.specs?.repo_urls as string[] | undefined) ?? []
const repoLicense = part.specs?.repo_license as string | null | undefined
const partPath = `/parts/${part.category}/${part.slug}.html`
const title = `${part.vendor} ${part.model} · RoboWiki`
const description = `${part.vendor} ${part.model} 的参数、来源、评分与真实使用经验。`
const tierClass = part.tier === 'A' ? 'tier tier-a' : part.tier === 'B' ? 'tier tier-b' : 'tier tier-c'
const layer = layerOfCategory(part.category)

// 顶部统计格不能写死成电机字段：芯片没有扭矩，硬显示 null 等于告诉用户「这里没数据」。
// 按一张全局优先级表取「确实有值」的字段，取不到就不显示这一格。
const STAT_PRIORITY: Array<{ key: string; label: string; unit: string }> = [
  { key: 'tau_peak_Nm', label: '峰值扭矩', unit: 'N·m' },
  { key: 'tau_rated_Nm', label: '额定扭矩', unit: 'N·m' },
  { key: 'gear', label: '减速比', unit: ':1' },
  { key: 'mass_kg', label: '质量', unit: 'kg' },
  { key: 'voltage_V', label: '母线电压', unit: 'V' },
  { key: 'power_w', label: '功率', unit: 'W' },
  { key: 'speed_rated_rpm', label: '额定转速', unit: 'rpm' },
  { key: 'range_m', label: '量程', unit: 'm' },
  { key: 'fps', label: '帧率', unit: 'fps' },
  { key: 'od_mm', label: '外径', unit: 'mm' },
]
const specSource = (part.specs ?? {}) as Record<string, unknown>
const keyStats = STAT_PRIORITY
  .filter(item => specSource[item.key] !== null && specSource[item.key] !== undefined && specSource[item.key] !== '')
  .slice(0, 3)
  .map(item => ({ label: item.label, value: specSource[item.key] as string | number, unit: item.unit }))
---

<Base title={title} description={description} image={imageUrl(part)}>
  <SeoJsonLd type="Product" title={`${part.vendor} ${part.model}`}
    description={`${part.model} 的参数、来源、评分与真实使用经验。`}
    url={partPath} image={imageUrl(part)} />

  <nav class="mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-ink-3" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-brand">首页</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={withBase('/catalog.html')} class="hover:text-brand">部件库</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={`${withBase('/catalog.html')}?category=${part.category}`} class="hover:text-brand">{categoryLabel(part.category)}</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <span class="text-ink-2" aria-current="page">{part.model}</span>
  </nav>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="space-y-4">
      <header class="card overflow-hidden">
        <div class="grid gap-5 p-5 sm:grid-cols-[220px_minmax(0,1fr)] sm:p-6">
          <div class="flex h-44 items-center justify-center rounded-md border border-line bg-surface-2">
            {part.image
              ? <img src={imageUrl(part)} alt={`${part.vendor} ${part.model}`} class="h-full w-full object-contain p-4" />
              : <span class="text-xs text-ink-3">暂无产品图</span>}
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-[11px] text-ink-2">{categoryLabel(part.category)}</span>
              {layer && (
                <a
                  href={withBase(`/layers/${layer.id}.html`)}
                  class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-[11px] text-ink-3 transition-colors hover:border-line-strong hover:text-brand"
                >
                  {layer.index} {layer.name}
                </a>
              )}
              {part.subtypeLabel && <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-[11px] text-ink-2">{part.subtypeLabel}</span>}
              {part.tier && <span class={tierClass}>来源 {part.tier} 级</span>}
              {part.verified && <span class="tier tier-a">已核对</span>}
            </div>
            <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{part.model}</h1>
            <p class="mt-1 text-sm text-ink-3">{part.vendor}</p>

            <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-4">
              {keyStats.map(s => (
                <div class="bg-surface px-3 py-2.5">
                  <dt class="text-[11px] text-ink-3">{s.label}</dt>
                  <dd class="mono tabular mt-0.5 text-sm font-semibold text-ink">
                    {s.value ?? <span class="text-ink-3">null</span>}
                    {s.value != null && <span class="ml-0.5 text-[11px] font-normal text-ink-3">{s.unit}</span>}
                  </dd>
                </div>
              ))}
              <div class="bg-surface px-3 py-2.5">
                <dt class="text-[11px] text-ink-3">参考价</dt>
                <dd class="mono tabular mt-0.5 text-sm font-semibold text-ink">{formatPrice(part.price)}</dd>
              </div>
            </dl>

            {part.notes && (
              <p class="mt-4 border-l-2 border-brand/40 pl-3 text-[13px] leading-6 text-ink-2">{part.notes}</p>
            )}
          </div>
        </div>
      </header>

      <section class="card" aria-labelledby="specs">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line px-5 py-4">
          <h2 id="specs" class="text-sm font-semibold text-ink">公开参数</h2>
          <span class="mono tabular text-xs text-ink-3">
            {specEntries.length} 项有值{missing > 0 && ` · ${missing} 项为 null`}
          </span>
        </div>
        <dl class="grid gap-x-8 px-5 py-4 sm:grid-cols-2">
          {specEntries.map(row => (
            <div class="flex items-start justify-between gap-4 border-b border-line py-2 text-sm last:border-0">
              <dt class="shrink-0" title={row.meaning || undefined}>
                <span class="text-ink-2">{row.label}</span>
                {row.label !== row.key && !row.key.includes('.') && (
                  <span class="mono ml-1.5 text-[11px] text-ink-3">{row.key}</span>
                )}
              </dt>
              <dd class="mono tabular min-w-0 break-words text-right font-medium text-ink">
                {row.value}{row.unit && <span class="ml-1 text-[11px] font-normal text-ink-3">{row.unit}</span>}
              </dd>
            </div>
          ))}
        </dl>
        {specEntries.length === 0 && (
          <p class="px-5 pb-5 text-sm text-ink-3">这个条目还没有公开参数，欢迎补充厂商手册中的原始值。</p>
        )}
      </section>

      {commits.length > 0 && (
        <section class="card p-5" aria-labelledby="repos">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="repos" class="text-sm font-semibold text-ink">开源实现</h2>
            <span class="mono text-[11px] text-ink-3">
              许可：{repoLicense ?? '未标注'}
            </span>
          </div>
          <ul class="mt-3 space-y-2">
            {commits.map((url: string) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener"
                  class="mono block truncate text-[13px] text-brand hover:underline"
                >
                  {url.replace(/^https?:\/\/(www\.)?github\.com\//, '')}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20">
      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">实际使用</h2>
        <div class="mt-3">
          <RatingSummary client:load partId={part.id} />
        </div>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">数据口径</h2>
        <ul class="mt-3 space-y-2 text-[13px] leading-6 text-ink-3">
          <li>缺失显示 <span class="mono">null</span>，表示厂商未公布，不是 0。</li>
          <li>来源等级表示可信度：A 逐项对过手册，B 二手整理，C 仅线索。</li>
          <li>评分少于 3 条时只显示样本，不给确定结论。</li>
        </ul>
        <a href={withBase('/method.html')} class="mt-3 inline-flex text-[13px] font-medium text-brand hover:underline">
          阅读方法与来源 →
        </a>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">和别的比一比</h2>
        <p class="mt-2 text-[13px] leading-6 text-ink-3">把这个条目和另外 1–3 个部件并排看，差异项会自动标出来。</p>
        <a
          href={`${withBase('/compare.html')}?ids=${part.id}`}
          class="mt-3 inline-flex h-9 items-center rounded-md border border-line px-3 text-[13px] font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2"
        >
          加入对比
        </a>
      </section>

      <section class="card p-5">
        <h2 class="text-sm font-semibold text-ink">发现错误？</h2>
        <p class="mt-2 text-[13px] leading-6 text-ink-3">参数写错、价格过期、链接失效都可以直接提纠正，进入下一个 data-v* 版本。</p>
        <a
          href={withBase('/submit.html')}
          class="mt-3 inline-flex h-9 items-center rounded-md border border-line px-3 text-[13px] font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2"
        >
          提交纠正
        </a>
      </section>
    </aside>
  </div>
</Base>
