---
/**
 * 岛屿（client:only）的静态兜底。
 *
 * client:only 的组件只在浏览器里渲染，一旦 JS chunk 缺失、脚本报错或用户禁用 JS，
 * 页面就只剩页头——正文空白。这里先用 Astro 静态渲染一份骨架，岛屿挂载后由
 * IslandProvider 里的 effect 移除 [data-island-fallback]；若岛屿始终没起来，骨架
 * 会一直留着，至少页面不空、有可点的出口。
 */
type Props = {
  label?: string
  /** 骨架卡片数；0 表示只给一张提示卡（详情/表单类页面） */
  rows?: number
}

const { label = '正在加载…', rows = 3 } = Astro.props as Props
const skeletons = Array.from({ length: rows }, (_, i) => i)
const lines = ['w-full', 'w-11/12', 'w-2/3']
---
<div data-island-fallback class="min-h-[24rem]" aria-busy="true">
  {rows > 0 && (
    <div class="mb-3 flex flex-wrap items-center gap-2 border-b border-line pb-3" aria-hidden="true">
      <div class="h-8 w-16 animate-pulse rounded-full bg-surface-3" />
      <div class="h-8 w-16 animate-pulse rounded-full bg-surface-3" />
      <div class="h-8 w-20 animate-pulse rounded-full bg-surface-3" />
      <div class="ml-auto h-8 w-44 animate-pulse rounded-full bg-surface-3" />
    </div>
  )}

  {skeletons.map(i => (
    <div class="card mb-3 animate-pulse p-4" aria-hidden="true">
      <div class="flex items-start gap-3">
        <div class="h-[68px] w-9 shrink-0 rounded-full bg-surface-3" />
        <div class="min-w-0 flex-1 space-y-2">
          <div class="h-4 w-24 rounded-full bg-surface-3" />
          <div class={`h-4 rounded bg-surface-3 ${i % 2 ? 'w-3/5' : 'w-4/5'}`} />
          <div class="h-3 w-full rounded bg-surface-3" />
          <div class="h-3 w-2/5 rounded bg-surface-3" />
          <div class="flex gap-3 pt-1">
            <div class="h-3 w-24 rounded bg-surface-3" />
            <div class="h-3 w-12 rounded bg-surface-3" />
            <div class="h-3 w-12 rounded bg-surface-3" />
          </div>
        </div>
      </div>
    </div>
  ))}

  {rows === 0 && (
    <div class="card animate-pulse p-6" aria-hidden="true">
      <div class="h-6 w-40 rounded bg-surface-3" />
      <div class="mt-3 space-y-2">
        {lines.map(w => <div class={`h-3 rounded bg-surface-3 ${w}`} />)}
      </div>
    </div>
  )}

  <p class="mt-3 text-xs text-ink-3">{label}</p>
  <p class="mt-1 text-xs leading-6 text-ink-3">
    长时间没有内容？可以先去看
    <a href="/catalog.html" class="text-brand underline underline-offset-2">部件库</a>，或了解
    <a href="/submit.html" class="text-brand underline underline-offset-2">怎么投稿</a>。
  </p>

  <noscript>
    <p class="mt-2 rounded-md border border-warning/35 bg-warning-soft p-3 text-sm leading-6 text-warning">
      社区内容需要启用 JavaScript 才能加载，上面的入口链接不受影响。
    </p>
  </noscript>
</div>
