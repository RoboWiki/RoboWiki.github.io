---
import { withBase } from '@/lib/utils'

type Item = { label: string; href?: string }
const { items } = Astro.props as { items: Item[] }
---
<nav aria-label="面包屑" class="mb-4 text-[12px] text-ink-3">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-line-strong">/</span>}
        {item.href
          ? <a href={withBase(item.href)} class="transition-colors hover:text-ink">{item.label}</a>
          : <span aria-current="page" class="text-ink-2">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
