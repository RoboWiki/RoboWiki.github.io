---
import Base from './Base.astro'
import { withBase } from '@/lib/utils'

type Crumb = { label: string; href?: string }
type Props = { title: string; description?: string; crumbs?: Crumb[]; eyebrow?: string }

const { title, description, crumbs = [], eyebrow } = Astro.props
---

<Base title={`${title} · RoboWiki`} description={description}>
  <div class="mx-auto max-w-3xl">
    <nav aria-label="面包屑" class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
      <a href={withBase('/')} class="hover:text-blue-700">首页</a>
      {crumbs.map(c => (
        <>
          <span aria-hidden="true">/</span>
          {c.href ? (
            <a href={withBase(c.href)} class="hover:text-blue-700">{c.label}</a>
          ) : (
            <span class="text-slate-700" aria-current="page">{c.label}</span>
          )}
        </>
      ))}
    </nav>

    {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">{eyebrow}</p>}
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">{title}</h1>
    {description && <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">{description}</p>}

    <div class="mt-6 empty:hidden">
      <slot name="lead" />
    </div>

    <div class="prose-body mt-6 max-w-3xl">
      <slot />
    </div>

    <slot name="after" />
  </div>
</Base>

<style is:global>
  .prose-body {
    color: #1e293b;
    font-size: 0.95rem;
    line-height: 1.85;
  }
  .prose-body > :first-child { margin-top: 0; }
  .prose-body :where(h2, h3, h4) {
    margin: 2rem 0 0.75rem;
    color: #020617;
    font-weight: 700;
    line-height: 1.35;
    scroll-margin-top: 5rem;
  }
  .prose-body h2 { font-size: 1.35rem; }
  .prose-body h3 { font-size: 1.1rem; }
  .prose-body h4 { font-size: 1rem; }
  .prose-body :where(p, ul, ol, blockquote, table, pre) { margin-block: 0.9rem; }
  .prose-body :where(ul, ol) { padding-left: 1.35rem; }
  .prose-body ul { list-style: disc; }
  .prose-body ol { list-style: decimal; }
  .prose-body li { margin-block: 0.3rem; }
  .prose-body li > ul, .prose-body li > ol { margin-block: 0.25rem; }
  .prose-body a {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: #bfdbfe;
  }
  .prose-body a:hover { text-decoration-color: #1d4ed8; }
  .prose-body strong { color: #020617; font-weight: 650; }
  .prose-body blockquote {
    border-left: 3px solid #bfdbfe;
    background: #f8fafc;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.75rem 1rem;
    color: #334155;
    font-size: 0.9rem;
  }
  .prose-body blockquote > :first-child { margin-top: 0; }
  .prose-body blockquote > :last-child { margin-bottom: 0; }
  .prose-body :where(code) {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 0.35rem;
    padding: 0.05rem 0.3rem;
    font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prose-body pre {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 0.6rem;
    padding: 0.9rem 1rem;
    font-size: 0.82rem;
    line-height: 1.7;
    background: #f8fafc;
  }
  .prose-body pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .prose-body table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .prose-body :where(th, td) {
    border: 1px solid #e2e8f0;
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .prose-body th { background: #f8fafc; color: #0f172a; font-weight: 650; white-space: nowrap; }
  .prose-body tbody tr:nth-child(even) { background: #fcfdff; }
  .prose-body hr { margin-block: 2rem; border: 0; border-top: 1px solid #e2e8f0; }
  .prose-body img { max-width: 100%; height: auto; border-radius: 0.5rem; }
</style>
