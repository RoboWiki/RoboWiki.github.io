---
import '../styles/global.css'
import { BASE, withBase } from '@/lib/utils'

type Props = { title?: string; description?: string; accountHref?: string; image?: string }
const appLoginHref = '/app/#/pages/login/index'
const {
  title = 'RoboWiki · 机器人硬件选型底稿',
  description = '部件、材料、整机与真实使用经验的开放资料库。',
  accountHref = appLoginHref,
  image = '',
} = Astro.props

const rawPath = Astro.url.pathname
const path = BASE && rawPath.startsWith(BASE) ? (rawPath.slice(BASE.length) || '/') : rawPath
const canonical = new URL(withBase(path), Astro.site ?? Astro.url).href
type NavItem = { href: string; label: string; match?: string[]; external?: boolean }
const nav: NavItem[] = [
  { href: '/', label: '首页' },
  { href: '/catalog.html', label: '部件库', match: ['/catalog', '/parts'] },  { href: 'https://robowiki.org.cn/robots', label: '整机库', external: true },
  { href: 'https://robowiki.org.cn/materials', label: '材质库', external: true },
  { href: 'https://robowiki.org.cn/learn/', label: '指南', external: true },
]

const isCurrent = (item: NavItem) => {
  if (item.external) return false
  const targets = item.match?.length ? item.match : [item.href]
  return targets.some(t => (t === '/' ? path === '/' : path.startsWith(t)))
}
const linkClass = (current: boolean) =>
  `inline-flex items-center rounded-lg px-3 py-1.5 text-sm transition-colors ${
    current ? 'bg-slate-100 font-medium text-slate-900' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
  }`
const menuLinkClass = (current: boolean) =>
  `flex min-h-11 items-center justify-between gap-2 rounded-lg px-3 text-sm ${
    current ? 'bg-slate-100 font-medium text-slate-900' : 'text-slate-700 hover:bg-slate-50'
  }`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="RoboWiki" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link">跳到主要内容</a>

    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
      <div class="relative mx-auto flex h-14 max-w-6xl items-center gap-2 px-3 sm:gap-4 sm:px-4">
        <a href={withBase('/')} class="flex shrink-0 items-center gap-2 font-bold tracking-tight" aria-label="RoboWiki 首页">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-blue-600 text-xs text-white" aria-hidden="true">RW</span>
          <span>RoboWiki</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
          {nav.map(item => (
            <a
              href={withBase(item.href)}
              class={linkClass(isCurrent(item))}
              aria-current={isCurrent(item) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
          <a
            href="https://github.com/RoboWiki"
            class="hidden h-9 items-center gap-1 rounded-lg px-3 text-sm text-slate-600 hover:bg-slate-50 sm:inline-flex"
            target="_blank"
            rel="noopener"
          >
            GitHub<span class="sr-only">（新窗口打开）</span>
          </a>
          <a
            href={accountHref}
            class="inline-flex h-11 items-center rounded-lg bg-slate-900 px-3 text-sm font-medium text-white hover:bg-slate-700 sm:h-9"
          >
            账号
          </a>

          <details class="mobile-nav md:hidden">
            <summary
              class="grid h-11 w-11 place-items-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-50"
              aria-label="打开导航菜单"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div class="mobile-nav-panel absolute right-3 top-full z-50 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-2">
              <nav aria-label="移动导航">
                <ul class="space-y-0.5">
                  {nav.map(item => (
                    <li>
                      <a
                        href={withBase(item.href)}
                        class={menuLinkClass(isCurrent(item))}
                        aria-current={isCurrent(item) ? 'page' : undefined}
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener' : undefined}
                      >
                        <span>{item.label}</span>
                        {item.external && <span class="text-xs text-slate-400" aria-hidden="true">↗</span>}
                        {isCurrent(item) && <span class="text-xs text-blue-700">当前</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <div class="mt-2 space-y-0.5 border-t border-slate-100 pt-2">
                <a
                  href={accountHref}
                  class="flex min-h-11 items-center justify-between rounded-lg px-3 text-sm font-medium text-slate-900 hover:bg-slate-50"
                >
                  登录 / 注册<span class="text-xs text-slate-400" aria-hidden="true">↗</span>
                </a>
                <a
                  href="https://github.com/RoboWiki"
                  class="flex min-h-11 items-center justify-between rounded-lg px-3 text-sm text-slate-600 hover:bg-slate-50"
                  target="_blank"
                  rel="noopener"
                >
                  GitHub<span class="text-xs text-slate-400" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
        <p>RoboWiki · 数据带来源，口径可追溯，不卖零件不收佣金。</p>
        <p>GPL-3.0 · 内容与数据来源见页面底部说明</p>
      </div>
    </footer>

    <script>
      // Small enhancement for the <details> menu: close on outside click / Escape.
      const menu = document.querySelector<HTMLDetailsElement>('details.mobile-nav')
      if (menu) {
        const summary = menu.querySelector<HTMLElement>('summary')
        document.addEventListener('click', event => {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false
        })
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false
            summary?.focus()
          }
        })
      }
    </script>
  </body>
</html>
