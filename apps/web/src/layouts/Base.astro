---
import '../styles/global.css'
import Comments from '@/components/comments/Comments'
import { BASE, withBase } from '@/lib/utils'
import { DISCUSSION, POSITIONING, WEB_NAV } from '@robowiki/content'

type Props = { title?: string; description?: string; accountHref?: string; image?: string; noindex?: boolean }
const {
  title = 'RoboWiki · 机器人制作全流程工程知识库',
  description = `${POSITIONING.short}：以「机械—硬件—嵌入式—算法」四层能力为骨架，以系统集成能力为大脑，社区共建部件选型与评价、加工与采购经验、教程、案例与开源索引。`,
  accountHref = withBase('/account.html'),
  image = '',
  noindex = false,
} = Astro.props

const rawPath = Astro.url.pathname
const stripped = BASE && rawPath.startsWith(BASE) ? (rawPath.slice(BASE.length) || '/') : rawPath
// build.format:'file' 让首页产物是 index.html，但对外 canonical 用目录 URL，
// 避免 /next/ 与 /next/index.html 两份内容互为重复页。
const path = stripped.replace(/\/index\.html$/, '/')
const canonical = new URL(withBase(path), Astro.site ?? Astro.url).href
// 讨论串按旧站路径存库：parts/actuator/xxx、learn/control-chain。
const commentsPage = path === '/' ? 'index' : path.replace(/^\//, '').replace(/\.html$/, '')
// 工具型页面（搜索、对比、路径选择、开源索引）不挂讨论区：那里没有可讨论的对象。
const showComments = !/^(admin|login|account|community|post|top|u|404|search|compare|start|open|paths)/.test(commentsPage)
// 一级入口与小程序共用一份：学习 / 方案 / 部件 / 社区 / 采购。
const nav = WEB_NAV

const isCurrent = (item: (typeof WEB_NAV)[number]) => {
  const targets = item.match?.length ? item.match : [item.href]
  return targets.some(t => (t === '/' ? path === '/' : path.startsWith(t)))
}
const linkClass = (current: boolean) =>
  `inline-flex items-center rounded-md px-3 py-1.5 text-[13px] transition-colors ${
    current
      ? 'bg-brand-soft font-semibold text-brand'
      : 'text-ink-2 hover:bg-surface-3 hover:text-ink'
  }`
const menuLinkClass = (current: boolean) =>
  `flex min-h-11 items-center justify-between gap-2 rounded-md px-3 text-sm ${
    current ? 'bg-brand-soft font-semibold text-brand' : 'text-ink-2 hover:bg-surface-3'
  }`

const footerGroups = [
  {
    title: '找东西',
    links: [
      { href: '/catalog.html', label: '部件库' },
      { href: '/equipment.html', label: '设备库' },
      { href: '/builds.html', label: '方案库' },
      { href: '/materials.html', label: '材质与工艺' },
      { href: '/suppliers.html', label: '采购库' },
    ],
  },
  {
    title: '学习与参与',
    links: [
      { href: '/start.html', label: '学习路径' },
      { href: '/community.html', label: '社区' },
      { href: '/tools.html', label: '工具链' },
      { href: '/open.html', label: '开源索引' },
      { href: '/submit.html', label: '参与投稿' },
    ],
  },
  {
    title: '关于',
    links: [
      { href: '/method.html', label: '方法与来源' },
      { href: '/semantics.html', label: '参数口径' },
      { href: '/sources.html', label: '来源清单' },
      { href: '/notice.html', label: '免责声明' },
    ],
  },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <meta property="og:site_name" content="RoboWiki" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <script is:inline>
      // 主题在首帧前落定，避免闪白。默认跟随系统。
      (() => {
        try {
          const saved = localStorage.getItem('rw-theme')
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.classList.toggle('dark', dark)
        } catch {}
      })()
    </script>
  </head>
  <body class="min-h-screen bg-bg text-ink antialiased">
    <a href="#main" class="skip-link">跳到主要内容</a>

    <header class="sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur-md">
      <div class="relative mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
        <a href={withBase('/')} class="flex shrink-0 items-center gap-2.5" aria-label="RoboWiki 首页">
          <img
            src={withBase('/logo-mark.png')}
            alt=""
            width="40"
            height="28"
            class="h-7 w-10 object-contain dark:invert"
          />
          <span class="flex flex-col leading-none">
            <span class="text-[15px] font-bold tracking-tight text-ink">RoboWiki</span>
            <span class="mt-0.5 hidden text-[10px] font-medium tracking-wide text-ink-3 sm:block">
              机器人制作工程知识库
            </span>
          </span>
        </a>

        <nav class="ml-2 hidden items-center gap-0.5 lg:flex" aria-label="主导航">
          {nav.map(item => (
            <a
              href={withBase(item.href)}
              class={linkClass(isCurrent(item))}
              aria-current={isCurrent(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
          <form action={withBase('/search.html')} method="get" role="search" class="hidden xl:block">
            <label for="site-search" class="sr-only">搜索全站：部件、方案、材料、工具、渠道、文档</label>
            <div class="relative">
              <svg
                viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                aria-hidden="true" class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-ink-3"
              >
                <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
              </svg>
              <input
                id="site-search"
                name="q"
                type="search"
                placeholder="搜索全站 · 型号 / 厂商 / 品类"
                autocomplete="off"
                class="h-9 w-56 rounded-md border border-line bg-surface-2 pl-8 pr-3 text-[13px] text-ink transition-[width,border-color,background-color] duration-200 placeholder:text-ink-3 focus:w-72 focus:border-brand focus:bg-surface focus:outline-none"
              />
            </div>
          </form>

          <a
            href="https://github.com/RoboWiki/RoboWiki"
            target="_blank"
            rel="noopener"
            class="grid h-9 w-9 place-items-center rounded-md border border-line text-ink-2 transition-colors hover:bg-surface-3 hover:text-ink"
            aria-label="GitHub 仓库"
            title="GitHub 仓库"
          >
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.15c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
            </svg>
          </a>

          <button
            type="button"
            id="theme-toggle"
            class="grid h-9 w-9 place-items-center rounded-md border border-line text-ink-2 transition-colors hover:bg-surface-3 hover:text-ink"
            aria-label="切换深色模式"
            title="切换深色模式"
          >
            <svg class="hidden dark:block" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke-linecap="round" />
            </svg>
            <svg class="block dark:hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
            </svg>
          </button>

          <a
            href={accountHref}
            class="inline-flex h-9 items-center rounded-md bg-brand px-3.5 text-[13px] font-semibold text-brand-fg transition-colors hover:bg-brand-hover"
          >
            账号
          </a>

          <details class="mobile-nav lg:hidden">
            <summary
              class="grid h-9 w-9 place-items-center rounded-md border border-line text-ink-2 hover:bg-surface-3"
              aria-label="打开导航菜单"
            >
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div class="mobile-nav-panel absolute right-3 top-full z-50 mt-2 w-64 rounded-lg border border-line bg-surface p-2">
              <form action={withBase('/search.html')} method="get" role="search" class="p-1">
                <label for="mobile-search" class="sr-only">搜索全站</label>
                <input
                  id="mobile-search"
                  name="q"
                  type="search"
                  placeholder="搜索全站 · 型号 / 厂商"
                  autocomplete="off"
                  class="h-9 w-full rounded-md border border-line bg-surface-2 px-3 text-[13px] text-ink placeholder:text-ink-3 focus:border-brand focus:bg-surface focus:outline-none"
                />
              </form>
              <nav aria-label="移动导航">
                <ul class="space-y-0.5">
                  {nav.map(item => (
                    <li>
                      <a
                        href={withBase(item.href)}
                        class={menuLinkClass(isCurrent(item))}
                        aria-current={isCurrent(item) ? 'page' : undefined}
                      >
                        <span class="min-w-0">
                          <span class="block">{item.label}</span>
                          {item.desc && <span class="block text-[11px] font-normal text-ink-3">{item.desc}</span>}
                        </span>
                        {isCurrent(item) && <span class="text-xs text-brand">当前</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <div class="mt-2 space-y-0.5 border-t border-line pt-2">
                <a
                  href={withBase('/submit.html')}
                  class="flex min-h-11 items-center justify-between rounded-md px-3 text-sm text-ink-2 hover:bg-surface-3"
                >
                  参与投稿<span class="text-xs text-ink-3" aria-hidden="true">→</span>
                </a>
                <a
                  href="https://github.com/RoboWiki/RoboWiki"
                  class="flex min-h-11 items-center justify-between rounded-md px-3 text-sm text-ink-2 hover:bg-surface-3"
                  target="_blank"
                  rel="noopener"
                >
                  GitHub 仓库<span class="text-xs text-ink-3" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
      <slot />
      {showComments && (
        <details id="discussion" class="group mt-10">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-lg border border-line bg-surface px-5 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-surface-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"
          >
            <span class="flex min-w-0 flex-col gap-0.5">
              <span>{DISCUSSION.title}与纠错</span>
              <span class="text-[11px] font-normal text-ink-3">{DISCUSSION.collapsedHint}</span>
            </span>
            <span
              class="grid h-6 w-6 shrink-0 place-items-center rounded-md border border-line text-ink-3 transition-transform group-open:rotate-180"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="mt-3">
            <Comments client:idle page={commentsPage} />
          </div>
        </details>
      )}
    </main>

    <footer class="mt-20 border-t border-line bg-surface">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
          <div>
            <div class="flex items-center gap-2.5">
              <img
                src={withBase('/logo-mark.png')}
                alt=""
                width="36"
                height="24"
                class="h-6 w-9 object-contain dark:invert"
              />
              <span class="text-sm font-bold text-ink">RoboWiki</span>
            </div>
            <p class="mt-3 max-w-xs text-xs leading-6 text-ink-3">
              面向机器人制作全流程的可追溯工程知识库。四层能力打底，系统集成收口，社区共建。不卖零件、不收佣金。
            </p>
          </div>
          {footerGroups.map(group => (
            <nav aria-label={group.title}>
              <h2 class="text-xs font-semibold tracking-wide text-ink uppercase">{group.title}</h2>
              <ul class="mt-3 space-y-2">
                {group.links.map(link => (
                  <li>
                    <a href={withBase(link.href)} class="text-[13px] text-ink-2 transition-colors hover:text-brand">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
        <div class="mt-8 flex flex-col gap-2 border-t border-line pt-5 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between">
          <p>AGPL-3.0 · 厂商手册与商品图版权归原方</p>
          <p class="mono">数据带来源 · 口径可追溯 · 缺失写 null</p>
        </div>
      </div>
    </footer>

    <script>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}))
      }

      // 主题切换：写入 localStorage，切换 <html class="dark">。
      const toggle = document.getElementById('theme-toggle')
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark')
        try {
          localStorage.setItem('rw-theme', dark ? 'dark' : 'light')
        } catch {}
        toggle.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式')
      })

      // Small enhancement for the <details> menu: close on outside click / Escape.
      const menu = document.querySelector<HTMLDetailsElement>('details.mobile-nav')
      if (menu) {
        const summary = menu.querySelector<HTMLElement>('summary')
        document.addEventListener('click', event => {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false
        })
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false
            summary?.focus()
          }
        })
      }

      // 通知链接带 #comment-2 / #c2，但讨论区默认收起：先展开，再等 React 渲染后滚过去。
      const discussion = document.getElementById('discussion')
      if (discussion && /^#(?:comment-|c)\d+$/.test(location.hash)) {
        discussion.open = true
        const jump = () => {
          const matched = location.hash.match(/^#(?:comment-|c)(\d+)$/)
          if (!matched) return false
          const target =
            document.getElementById(`comment-${matched[1]}`) || document.getElementById(`c${matched[1]}`)
          if (!target) return false
          target.scrollIntoView({ block: 'center' })
          return true
        }
        // 评论列表是 client:idle 岛屿，首帧通常还没有节点：按 300/1200/2500ms 重试。
        if (!jump()) {
          requestAnimationFrame(jump)
          ;[300, 1200, 2500].forEach(ms => setTimeout(jump, ms))
        }
      }
    </script>
  </body>
</html>
