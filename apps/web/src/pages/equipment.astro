---
import Base from '@/layouts/Base.astro'
import EquipmentExplorer from '@/components/EquipmentExplorer'
import { catalog, parts as allParts } from '@/lib/catalog'
import { withBase } from '@/lib/utils'

// 设备库是独立一级入口，不再寄生在部件库的品类筛选里：
// 这里只装 equipment 一个品类，页面标题、统计、筛选项全部按设备口径。
const equipmentParts = allParts.filter(p => p.category === 'equipment')
const equipmentMeta = (catalog.categories || []).find(c => c.id === 'equipment')
const subtypes = Object.entries(equipmentMeta?.subtypes || {}).map(([id, label]) => ({ id, label }))
const vendors = new Set(equipmentParts.map(p => p.vendor).filter(Boolean)).size
const officialCount = equipmentParts.filter(p => p.tier === 'A').length
const stats = [
  { label: '设备', value: equipmentParts.length },
  { label: '子类', value: subtypes.length },
  { label: '厂商', value: vendors },
  { label: '官方核对', value: officialCount },
]
---

<Base
  title="设备库 · RoboWiki"
  description="做机器人用的工具与仪器：3D 打印机、激光切割与雕刻、焊台与热风枪、可调电源、测量仪器，参数按官方页面核对。"
>
  <header class="mb-6">
    <nav class="text-xs text-ink-3" aria-label="面包屑">
      <a href={withBase('/')} class="hover:text-ink">首页</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-ink-2">设备库</span>
    </nav>

    <div class="mt-3 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">做机器人的工具，单独一库。</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-3">
          进机器人身体的是部件库；用来把机器人做出来的，在这里。
          参数按厂商官方页面逐项核对，缺的写 null，不拿电商页凑数。
          按 <span class="font-medium text-ink">加工设备 / 焊接与返修 / 电源 / 测量仪器 / 调试与工具</span> 五族十六类筛，也能直接按厂商找。
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <a href={withBase('/catalog.html')} class="font-medium text-brand hover:underline">去找机器人零件 →</a>
          <a href={withBase('/suppliers.html')} class="text-ink-2 hover:text-brand">加工与采购去采购库</a>
        </div>
      </div>
      <dl class="grid shrink-0 grid-cols-4 gap-px overflow-hidden rounded-md border border-line bg-line">
        {stats.map(s => (
          <div class="bg-surface px-3 py-2.5">
            <dt class="text-xs text-ink-3">{s.label}</dt>
            <dd class="mono tabular mt-0.5 text-lg font-bold text-ink">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <EquipmentExplorer client:load parts={equipmentParts} subtypes={subtypes} />
</Base>
