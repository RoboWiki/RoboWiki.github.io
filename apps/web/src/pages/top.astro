---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/community/Breadcrumbs.astro'
import LeaderboardIsland from '@/components/community/leaderboard'
---
<Base
  title="贡献榜 · RoboWiki"
  description="按声望排序的 RoboWiki 社区贡献者：实测、答疑与维护数据都会涨声望。"
>
  <Breadcrumbs items={[
    { label: '首页', href: '/' },
    { label: '社区', href: '/community.html' },
    { label: '贡献榜' },
  ]} />
  <div class="mb-4">
    <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">社区</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">贡献榜</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
      按声望排序（收到的赞之和）。写实测、回答问题都会涨。
    </p>
  </div>
  <LeaderboardIsland client:only="react" />
</Base>

