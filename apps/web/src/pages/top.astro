---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/community/Breadcrumbs.astro'
import IslandFallback from '@/components/community/IslandFallback.astro'
import LeaderboardIsland from '@/components/community/leaderboard'
---
<Base
  title="贡献榜 · RoboWiki"
  description="按声望排序的 RoboWiki 社区贡献者：实测、答疑与维护数据都会涨声望。"
>
  <Breadcrumbs items={[
    { label: '首页', href: '/' },
    { label: '社区', href: '/community.html' },
    { label: '贡献榜' },
  ]} />

  <header class="mb-4 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">社区</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink sm:text-[34px]">贡献榜</h1>
    <p class="mt-2 text-sm leading-6 text-ink-2">
      按声望排序（收到的赞之和）。写实测、回答问题都会涨。
    </p>
  </header>

  <div class="min-h-[60vh]">
    <IslandFallback label="正在加载贡献榜…" rows={3} />
    <LeaderboardIsland client:only="react" />
  </div>
</Base>
