---
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'
import semantics from '@/data/semantics.json'
import protocolData from '@/data/protocols.json'

const rules = [
  {
    rule: '每行保留来源与核对日期',
    body: '来源优先厂商手册、官方数据表与官方仓库；公开网页只作补充。',
    why: '让读者知道这个数敢不敢直接用于设计',
  },
  {
    rule: '口径字段必须声明',
    body: 'tau_basis（peak / rated）、inertia_basis（rotor / output）、current_basis 缺一个，该行就不能参与跨厂商比较。',
    why: '同一物理量在不同口径下能差 19 倍',
  },
  {
    rule: '缺失写成缺失',
    body: '未公布记作 —，不是 0、不是「不支持」，也不拿同类件填补；不要假设额定 = 峰值 / 2。',
    why: '把「不知道」当「0」会让排序失真',
  },
  {
    rule: '同一字段不混源',
    body: '同一行的数值必须同源；厂商官网与手册冲突时两条都留着，标「来源冲突」，不改数值。',
    why: '拼出来的峰值/额定比没有物理意义',
  },
  {
    rule: '改动留提案',
    body: '字段改动先成为提案（旧值、新值、依据、来源链接、提交人），审核通过后由 worker 开 PR，发布 data-v* release 后才更新目录。',
    why: '任何一个数都能回答「谁、什么时候、凭什么改的」',
  },
]
const refusals = [
  '不灌示例评价：编出来的「实测」比空着坏得多。',
  '不改数值来掩盖冲突：两个来源冲突就都留着并标注。',
  '不为过校验编一个峰值：手册只给额定，峰值就写 —。',
  '不混用电调口径：不同源的数据不拼成一个「峰值/额定比」。',
]
const chain = ['提案：旧值 / 新值 / 依据 / 来源链接', '审核：口径与来源复核', 'PR：worker 自动开、人工合并', '发布：data-v* release 更新目录']
const toc = [
  { id: 'tiers', label: '来源与核对' },
  { id: 'rules', label: '字段溯源规则' },
  { id: 'missing', label: '缺失与三态判定' },
  { id: 'comparability', label: '可比性' },
  { id: 'refuse', label: '拒绝做的事' },
  { id: 'chain', label: '追溯链' },
]
---

<Base title="数据来源 · RoboWiki" description="字段溯源规则、缺失语义与拒绝做的事：每个数字都要能指回一手来源。">
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <a href={withBase('/method.html')} class="transition-colors hover:text-brand">方法</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">数据来源</span>
    </nav>

    <header class="max-w-3xl">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-brand uppercase">数据来源</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">能不能指回一手来源，是唯一的准入条件。</h1>
      <p class="mt-3 text-sm leading-7 text-ink-2">
        字段定义与复核阈值见<a href={withBase('/semantics.html')} class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">参数口径</a>；
        授权与版权规则见<a href={withBase('/notice.html')} class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">免责声明与许可</a>。
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2 text-[11px] text-ink-3">
        <span class="mono rounded border border-line bg-surface px-1.5 py-0.5">source_tier</span>
        <span class="tier tier-a">A</span>
        <span class="tier tier-b">B</span>
        <span class="tier tier-c">C</span>
        <span class="ml-1">三级标记核对程度，不是质量评分。</span>
      </div>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
      <div class="min-w-0 space-y-10">
        <section aria-labelledby="tiers">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">01</span>
            <h2 id="tiers" class="text-lg font-bold tracking-tight text-ink">来源与核对</h2>
            <span class="ml-auto text-[11px] text-ink-3">每条都可追溯</span>
          </div>

          <div class="card p-4 text-sm leading-7 text-ink-2">
            所有条目都已按厂商手册或官方数据表订正，不再标注 A/B/C 等级。每条记录保留来源、最近核对日期与公开链接；查不到的值写 null，不用二手数字填补。
          </div>

          <p class="mt-3 border-l-2 border-line-strong pl-3 text-xs leading-6 text-ink-3">
            来源不明时保留 null，不参与比较。
          </p>
        </section>

        <section aria-labelledby="rules">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">02</span>
            <h2 id="rules" class="text-lg font-bold tracking-tight text-ink">字段溯源规则</h2>
            <span class="ml-auto text-[11px] text-ink-3">{rules.length} 条</span>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[40rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="w-[13rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">规则</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">怎么做</th>
                  <th scope="col" class="w-[16rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">为什么</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {rules.map((r, i) => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3">
                      <span class="mono block text-[10px] text-ink-3">R{String(i + 1).padStart(2, '0')}</span>
                      <span class="mt-1 block text-xs font-semibold leading-5 text-ink">{r.rule}</span>
                    </td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{r.body}</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-3">{r.why}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="missing">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">03</span>
            <h2 id="missing" class="text-lg font-bold tracking-tight text-ink">缺失与三态判定</h2>
            <span class="ml-auto text-[11px] text-ink-3">null ≠ no</span>
          </div>

          <div class="flex flex-wrap gap-2">
            {semantics.trinary.values.map(v => (
              <span class="mono rounded-full border border-line bg-surface-2 px-3 py-1 text-xs font-semibold text-ink-2">{v}</span>
            ))}
          </div>

          <div class="prose mt-4 max-w-none">
            <p>{semantics.trinary.why}</p>
            <ul>
              {semantics.trinary.rules.map(rule => <li>{rule}</li>)}
            </ul>
          </div>
        </section>

        <section aria-labelledby="comparability">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">04</span>
            <h2 id="comparability" class="text-lg font-bold tracking-tight text-ink">同一张表里能不能放一起比</h2>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[36rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="w-16 px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">等级</th>
                  <th scope="col" class="w-[11rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">名称</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">条件</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {semantics.comparability.map(c => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3">
                      <span class="mono inline-flex h-6 min-w-6 items-center justify-center rounded border border-line bg-surface-3 px-1 text-xs font-bold text-ink-2">{c.grade}</span>
                    </td>
                    <td class="px-3 py-3 text-xs font-semibold leading-5 text-ink">{c.name}</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{c.condition}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="refuse">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">05</span>
            <h2 id="refuse" class="text-lg font-bold tracking-tight text-ink">我们拒绝做的事</h2>
          </div>

          <ul class="grid gap-2 sm:grid-cols-2" role="list">
            {refusals.map(r => (
              <li class="flex gap-2 rounded-lg border border-line bg-surface p-3 text-xs leading-6 text-ink-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-danger" aria-hidden="true" />
                <span>{r}</span>
              </li>
            ))}
          </ul>

          <p class="mt-4 text-xs leading-6 text-ink-3">
            协议与总线口径的来源：{protocolData._meta.source}（核对于 {protocolData._meta.checked}），
            详见<a href={withBase('/semantics.html')} class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">参数口径 · 协议语义</a>。
          </p>
        </section>

        <section aria-labelledby="chain">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">06</span>
            <h2 id="chain" class="text-lg font-bold tracking-tight text-ink">每个数字的追溯链</h2>
          </div>

          <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4" role="list">
            {chain.map((step, i) => (
              <li class="card flex flex-col gap-1.5 p-3">
                <span class="mono text-[10px] font-semibold text-brand">STEP {i + 1}</span>
                <span class="text-xs leading-6 text-ink-2">{step}</span>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <aside aria-labelledby="toc-title" class="min-w-0">
        <nav class="lg:sticky lg:top-24" aria-labelledby="toc-title">
          <p id="toc-title" class="text-[11px] font-semibold tracking-[0.14em] text-ink-3 uppercase">本页目录</p>
          <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-1 lg:border-l lg:border-line lg:pl-3">
            {toc.map((item, i) => (
              <li class="min-w-0">
                <a href={`#${item.id}`} class="group flex items-baseline gap-2 rounded-sm py-0.5 text-[13px] text-ink-2 transition-colors hover:text-brand">
                  <span class="mono text-[10px] text-ink-3 group-hover:text-brand">{String(i + 1).padStart(2, '0')}</span>
                  <span class="truncate">{item.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-4 hidden border-t border-line pt-3 text-[11px] leading-5 text-ink-3 lg:block">
            机器可读全文：<a href={withBase('/api/v1/semantics')} class="mono text-brand hover:underline">/api/v1/semantics</a>
          </p>
        </nav>
      </aside>
    </div>
  </div>
</Base>
