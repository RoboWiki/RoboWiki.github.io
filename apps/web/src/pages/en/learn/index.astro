---
import Base from '@/layouts/Base.astro'
---
<Base title="Learn · RoboWiki" description="How the data, tiers, ratings and pages fit together.">
  <section class="mx-auto max-w-3xl space-y-4 py-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-950">Learn</h1>
    <p class="text-base leading-7 text-slate-600">
      The guide section is Chinese-first. The core article explains how the data, source tiers,
      ratings and page structure fit together.
    </p>
    <a href="/learn/index.html" class="inline-flex h-11 items-center rounded-lg bg-slate-900 px-5 text-sm font-medium text-white hover:bg-slate-700">Open the guides →</a>
  </section>
</Base>
