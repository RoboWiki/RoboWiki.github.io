---
import Base from '@/layouts/Base.astro'
---
<Base title="Contributors · RoboWiki" description="People who checked, measured and wrote the data.">
  <section class="mx-auto max-w-3xl space-y-4 py-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink">Contributors</h1>
    <p class="text-base leading-7 text-ink-2">
      These are the people who checked vendor manuals, measured parts and wrote the notes.
      The leaderboard counts sourced contributions, not edits.
    </p>
    <a href="/contributors.html" class="inline-flex h-11 items-center rounded-lg bg-brand px-5 text-sm font-medium text-brand-fg hover:bg-slate-700">Open the contributor list →</a>
  </section>
</Base>
