---
import Base from '@/layouts/Base.astro'
---
<Base title="Parts library · RoboWiki" description="Robot parts with sourced specs and real user ratings.">
  <section class="mx-auto max-w-3xl space-y-4 py-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink">Parts library</h1>
    <p class="text-base leading-7 text-ink-2">
      The full catalog is rendered by the Chinese site. Every part page keeps the same structure:
      sourced specs, missing values shown as “—”, source metadata, and real user ratings.
    </p>
    <a href="/catalog.html" class="inline-flex h-11 items-center rounded-lg bg-brand px-5 text-sm font-medium text-brand-fg hover:bg-slate-700">Open the parts library →</a>
  </section>
</Base>
