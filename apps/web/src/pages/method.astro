---
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'
import semantics from '@/data/semantics.json'

const steps = [
  { n: 1, title: '先看来源等级', body: 'A 逐项核对厂商手册；B 公开网页；C 二手转述。等级决定这个数能不能直接用于设计。' },
  { n: 2, title: '再看口径字段', body: 'tau_basis 是 peak 还是 rated、inertia_basis 是 rotor 还是 output；口径不明就不参与比较。' },
  { n: 3, title: '缺的当缺的', body: '— 是「没公布」，不是「不支持」，也不是 0。三态里 unknown 既不算兼容也不算不兼容。' },
  { n: 4, title: '最后才比派生量', body: '扭矩密度、峰值/额定比、反射惯量占比是结果不是原因：用来发现异常，不用来选型。' },
]
const governance = [
  { title: '来源等级', body: 'A / B / C 三级标记核对程度；缺来源记「来源不明」，不参与比较。', href: '/sources.html', cta: '来源与溯源规则' },
  { title: '口径唯一事实源', body: `字段语义写在 semantics.json（当前版本 ${semantics.version}），静态站、后端与 MCP 都读这一份。`, href: '/semantics.html', cta: '字段口径与红线' },
  { title: '改动留痕', body: '每次字段改动先成为提案（旧值、新值、依据、来源链接），审核后开 PR，发布 data-v* release 才更新目录。', href: '/sources.html', cta: '追溯链' },
  { title: '授权与撤下', body: 'GPL-3.0 发布；厂商手册与图片归原方，权利人要求撤下就先下架、后讨论。', href: '/notice.html', cta: '免责声明与许可' },
]
const toc = [
  { id: 'rating', label: '评级方法' },
  { id: 'comparability', label: '可比性' },
  { id: 'red-lines', label: '六条物理红线' },
  { id: 'governance', label: '数据治理' },
  { id: 'supplier', label: '七个问题' },
  { id: 'layers', label: '四层能力怎么用' },
]
---

<Base title="方法与来源 · RoboWiki" description="评级方法、三态判定、可比性等级、六条物理红线与数据治理规则。">
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">方法与来源</span>
    </nav>

    <header class="max-w-3xl">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-brand uppercase">方法</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">先说怎么判，再谈推荐。</h1>
      <p class="mt-3 text-sm leading-7 text-ink-2">
        本站不排序「最好」，只说明「这个数字在什么口径下、什么来源等级下、能不能比」。
        评级由证据等级 + 口径可比性共同决定，缺一就不给结论。
      </p>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
      <div class="min-w-0 space-y-10">
        <section aria-labelledby="rating">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">01</span>
            <h2 id="rating" class="text-lg font-bold tracking-tight text-ink">评级方法：四步走</h2>
            <span class="ml-auto text-[11px] text-ink-3">顺序不可跳</span>
          </div>

          <ol class="grid gap-3 sm:grid-cols-2" role="list">
            {steps.map(s => (
              <li class="card flex flex-col gap-2 p-4">
                <div class="flex items-baseline gap-2.5">
                  <span class="mono text-2xl font-bold leading-none text-brand/35" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
                  <h3 class="text-sm font-semibold text-ink">{s.title}</h3>
                </div>
                <p class="text-xs leading-6 text-ink-2">{s.body}</p>
              </li>
            ))}
          </ol>

          <div class="mt-3 flex flex-wrap items-center gap-2 border-l-2 border-line-strong pl-3 text-xs text-ink-3">
            <span class="font-medium text-ink-2">判定只有三种结论：</span>
            {semantics.trinary.values.map(v => (
              <span class="mono rounded-full border border-line bg-surface-2 px-2.5 py-0.5 font-semibold text-ink-2">{v}</span>
            ))}
            <span>— unknown 表示证据不足，既不计入兼容也不计入不兼容。</span>
          </div>
        </section>

        <section aria-labelledby="comparability">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">02</span>
            <h2 id="comparability" class="text-lg font-bold tracking-tight text-ink">可比性：能不能放进同一张表</h2>
            <span class="ml-auto text-[11px] text-ink-3">A → D</span>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[36rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="w-16 px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">等级</th>
                  <th scope="col" class="w-[11rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">名称</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">条件</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {semantics.comparability.map(c => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3">
                      <span class="mono inline-flex h-6 min-w-6 items-center justify-center rounded border border-line bg-surface-3 px-1 text-xs font-bold text-ink-2">{c.grade}</span>
                    </td>
                    <td class="px-3 py-3 text-xs font-semibold leading-5 text-ink">{c.name}</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{c.condition}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="red-lines">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">03</span>
            <h2 id="red-lines" class="text-lg font-bold tracking-tight text-ink">六条物理红线</h2>
            <span class="ml-auto text-[11px] text-ink-3">{semantics.red_lines.length} 条</span>
          </div>

          <ul class="divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface" role="list">
            {semantics.red_lines.map(rl => (
              <li class="flex flex-col gap-1.5 px-4 py-3 transition-colors hover:bg-surface-2 sm:flex-row sm:items-baseline sm:gap-x-3">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 sm:w-[19rem] sm:shrink-0">
                  <span class="mono rounded border border-line bg-surface-3 px-1.5 py-0.5 text-[10px] font-semibold text-ink-3">{rl.id}</span>
                  <span class="text-sm font-semibold text-ink">{rl.name}</span>
                  {rl.review_above != null && (
                    <span class="mono text-[11px] text-warning">
                      {rl.review_above} {rl.unit ?? ''} 需复核{rl.absurd_above != null ? ` · ${rl.absurd_above} 不可信` : ''}
                    </span>
                  )}
                </div>
                <p class="min-w-0 flex-1 text-xs leading-6 text-ink-2">{rl.how_to_check}</p>
              </li>
            ))}
          </ul>

          <p class="mt-3 text-xs leading-6 text-ink-3">
            公式、常见做法与缺失含义见
            <a href={withBase('/semantics.html')} class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">参数口径 · 六条物理红线</a>。
          </p>
        </section>

        <section aria-labelledby="governance">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">04</span>
            <h2 id="governance" class="text-lg font-bold tracking-tight text-ink">数据治理</h2>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {governance.map(g => (
              <article class="card flex flex-col p-4">
                <h3 class="text-sm font-semibold text-ink">{g.title}</h3>
                <p class="mt-2 text-xs leading-6 text-ink-2">{g.body}</p>
                <a
                  href={withBase(g.href)}
                  class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline"
                >
                  {g.cta}<span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="supplier">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">05</span>
            <h2 id="supplier" class="text-lg font-bold tracking-tight text-ink">问供应商的七个问题</h2>
          </div>

          <p class="text-xs leading-6 text-ink-3">写不进技术协议的参数，验收时不具备约束力。</p>

          <ol class="mt-3 divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface" role="list">
            {semantics.supplier_questions.map((q, i) => (
              <li class="flex items-baseline gap-3 px-4 py-2.5">
                <span class="mono w-6 shrink-0 text-[11px] font-semibold text-ink-3">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-xs leading-6 text-ink-2">{q}</span>
              </li>
            ))}
          </ol>

          <nav aria-label="相关页面" class="mt-5 flex flex-wrap gap-2">
            <a href={withBase('/semantics.html')} class="chip">参数口径与协议语义</a>
            <a href={withBase('/sources.html')} class="chip">来源清单与溯源规则</a>
            <a href={withBase('/notice.html')} class="chip">免责声明与许可</a>
            <a href={withBase('/submit.html')} class="chip">参与投稿</a>
          </nav>
        </section>

        <section aria-labelledby="layers" class="mt-12 scroll-mt-24">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">06</span>
            <h2 id="layers" class="text-lg font-bold tracking-tight text-ink">四层能力怎么用</h2>
          </div>

          <p class="max-w-3xl text-sm leading-7 text-ink-2">
            「机械结构—电气与嵌入式—算法控制—系统集成」是<b class="text-ink">设计评审的检查表</b>，不是浏览路径。
            一个电机同时属于机械（扭矩、法兰）和电气（母线电压、驱动），把它归到唯一一层只会误导。
            正确的用法是在方案定下来之后，按四层各过一遍，问自己有没有漏项。
          </p>

          <ol class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
            {[
              { n: '01', name: '机械结构', ask: '扭矩与转速有余量吗？传动背隙能接受吗？材料和工艺做得出吗？' },
              { n: '02', name: '电气与嵌入式', ask: '峰值电流与母线压降够吗？总线带宽和节点数超标了吗？主控实时性够吗？' },
              { n: '03', name: '算法控制', ask: '传感器的频率与精度满足控制器吗？标定和噪声验证过吗？算力预算够吗？' },
              { n: '04', name: '系统集成', ask: '整机质量与重心可接受吗？预算冲突时砍谁？出问题能定位到哪一层？' },
            ].map(item => (
              <li class="card p-4">
                <div class="flex items-center gap-2">
                  <span class="mono text-[11px] font-semibold text-brand">{item.n}</span>
                  <span class="text-[13px] font-semibold text-ink">{item.name}</span>
                </div>
                <p class="mt-1.5 text-[12px] leading-5 text-ink-3">{item.ask}</p>
              </li>
            ))}
          </ol>

          <p class="mt-4 text-xs leading-6 text-ink-3">
            评审顺序建议自上而下：先算机械余量，再核电气是否撑得住，然后确认算法需求没有超出传感器能力，最后看整机装不装得下。
          </p>
        </section>
      </div>

      <aside aria-labelledby="toc-title" class="min-w-0">
        <nav class="lg:sticky lg:top-24" aria-labelledby="toc-title">
          <p id="toc-title" class="text-[11px] font-semibold tracking-[0.14em] text-ink-3 uppercase">本页目录</p>
          <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-1 lg:border-l lg:border-line lg:pl-3">
            {toc.map((item, i) => (
              <li class="min-w-0">
                <a href={`#${item.id}`} class="group flex items-baseline gap-2 rounded-sm py-0.5 text-[13px] text-ink-2 transition-colors hover:text-brand">
                  <span class="mono text-[10px] text-ink-3 group-hover:text-brand">{String(i + 1).padStart(2, '0')}</span>
                  <span class="truncate">{item.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-4 hidden border-t border-line pt-3 text-[11px] leading-5 text-ink-3 lg:block">
            口径唯一事实源：<span class="mono text-ink-2">semantics.json</span>
            <span class="mono block">v{semantics.version}</span>
          </p>
        </nav>
      </aside>
    </div>
  </div>
</Base>
