---
import Base from '@/layouts/Base.astro'
import suppliersData from '@/data/suppliers.json'
import { withBase } from '@/lib/utils'

type Signal = 'good' | 'mixed' | 'bad' | 'unknown' | 'fast' | 'slow' | 'low' | 'mid' | 'high' | 'yes' | 'no'
type Supplier = {
  id: string
  name: string
  display_name?: string | null
  shop_type?: string | null
  category?: string | null
  services?: string[]
  listing?: string | null
  grade?: string | null
  channel?: string | null
  signals?: Record<string, Signal>
  quality_raw?: string | null
  punctual_raw?: string | null
  price_raw?: string | null
  invoice_raw?: string | null
  notes?: string | null
  reason?: string | null
  reported_at?: string | null
}

const suppliers = (suppliersData.suppliers || []) as unknown as Supplier[]
const total = suppliers.length
const redCount = suppliers.filter(s => s.listing === '红榜').length
const invoiceCount = suppliers.filter(s => s.signals?.invoice === 'yes').length
const fastCount = suppliers.filter(s => s.signals?.punctual === 'fast').length
const lowPriceCount = suppliers.filter(s => s.signals?.price === 'low').length

// 采购库的两个划分轴：①采购加工品类（shop_type）②有没有坑。
// 「有坑」= 上过黑榜，或社区原话点名质量有坑；其余记「未见坑」（不等于背书）。
const hasPitfall = (s: Supplier) => s.listing === '黑榜' || s.signals?.quality === 'bad'
const pitfallCount = suppliers.filter(hasPitfall).length

const TYPE_ORDER = [
  '电子元件 / 模块',
  '标准件 / 紧固件',
  '标准件 / 五金',
  '轴承 / 传动',
  'CNC / 车铣',
  '钣金 / 激光切割',
  'CNC / 钣金综合',
  '3D打印 / 手板',
  '线切割 / 焊接 / 表面处理',
  '机械加工 / 其他',
  '工具 / 仪表',
  '材料 / 耗材',
  '包胶 / 轮',
  '杂项 / 耗材',
  '踩雷记录',
]
const typeCounts = new Map<string, number>()
for (const item of suppliers) {
  const type = item.shop_type || '其他'
  typeCounts.set(type, (typeCounts.get(type) || 0) + 1)
}
const types = [...typeCounts.entries()]
  .sort((a, b) => {
    const ia = TYPE_ORDER.indexOf(a[0])
    const ib = TYPE_ORDER.indexOf(b[0])
    return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib) || b[1] - a[1]
  })
const services = [...new Set(suppliers.flatMap(s => (s.services || []).filter(x => x !== '风险记录')))]
  .map(service => ({ service, count: suppliers.filter(s => (s.services || []).includes(service)).length }))
  .sort((a, b) => b.count - a.count)

const listingTone = (listing?: string | null) =>
  listing === '红榜'
    ? 'border-success/30 bg-success-soft text-success'
    : listing === '黑榜'
      ? 'border-danger/30 bg-danger-soft text-danger'
      : 'border-line bg-surface-2 text-ink-3'
const listingBar = (listing?: string | null) =>
  listing === '红榜' ? 'bg-success' : listing === '黑榜' ? 'bg-danger' : ''

const signalLabel: Record<string, Record<string, string>> = {
  quality: { good: '质量稳', mixed: '质量一般', bad: '质量有坑', unknown: '未评' },
  punctual: { fast: '交期快', mixed: '交期一般', slow: '要催', unknown: '未评' },
  price: { low: '价格低', mid: '价格中', high: '价格高', unknown: '未评' },
  invoice: { yes: '可开票', no: '不开票', unknown: '未评' },
}
const rawOrSignal = (raw: string | null | undefined, signals: Record<string, Signal> | undefined, key: string) =>
  raw || signalLabel[key]?.[signals?.[key] || 'unknown'] || '未评'

const feedback = (item: Supplier) => [item.reason, item.notes].filter(Boolean).join('\n').trim()
const fullFeedback = (item: Supplier) => [item.reason, item.notes].filter(Boolean).join('\n').trim()
const feedbackChars = (item: Supplier) => fullFeedback(item).replace(/\s+/g, '').length
const searchText = (item: Supplier) =>
  [
    item.name, item.display_name, item.shop_type, item.category, item.notes, item.reason,
    ...(item.services || []), item.quality_raw, item.punctual_raw, item.price_raw, item.invoice_raw,
  ].filter(Boolean).join(' ').toLowerCase()
---

<Base
  title="采购库 · RoboWiki"
  description={`${total} 家机器人零件与加工店铺：先按加工品类找店，再按红榜、踩坑、开票、交期、价格筛选采购目的，直接看社区评价原文。`}
>
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">采购库</span>
    </nav>

    <header>
      <p class="text-xs font-semibold tracking-[0.14em] text-brand uppercase">采购库</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
        按加工品类找店，先看有没有坑。
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-ink-2">
        先按<span class="font-medium text-ink">买什么</span>（加工品类）缩小范围，再按<span class="font-medium text-ink">怎么买</span>
        挑出符合自己采购目的的记录：红榜优先、避开有坑、需要开票、交期快、价格低。
        每张卡保留社区原话里的质量、交期、价格、发票和踩雷原因，不做“适合所有人”的抽象推荐。
      </p>

      <dl class="mt-6 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-4">
        <div class="bg-surface px-4 py-3"><dt class="text-xs text-ink-3">收录店铺</dt><dd class="mono mt-1 text-xl font-bold text-ink">{total}</dd></div>
        <div class="bg-surface px-4 py-3"><dt class="text-xs text-ink-3">红榜</dt><dd class="mono mt-1 text-xl font-bold text-success">{redCount}</dd></div>
        <div class="bg-surface px-4 py-3"><dt class="text-xs text-ink-3">有坑</dt><dd class="mono mt-1 text-xl font-bold text-danger">{pitfallCount}</dd></div>
        <div class="bg-surface px-4 py-3"><dt class="text-xs text-ink-3">可开票</dt><dd class="mono mt-1 text-xl font-bold text-ink">{invoiceCount}</dd></div>
      </dl>
    </header>

    <form id="supplier-filters" class="card mt-6 p-4" role="search" aria-label="筛选采购库">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <input
          id="sup-q"
          type="search"
          data-guide="suppliers-search"
          placeholder="搜索店名、工艺或评价原文，例如：钣金、轴承、拖工期"
          class="h-10 w-full rounded-md border border-line bg-surface px-3 text-sm text-ink placeholder:text-ink-3 focus-visible:border-brand focus-visible:outline-none sm:flex-1"
          autoComplete="off"
        />
        <p id="sup-count" class="mono text-xs text-ink-3 sm:ml-auto" aria-live="polite">显示 {total} / {total} 家</p>
      </div>

      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-2">
          <span id="sup-type-label" class="w-14 shrink-0 pt-1.5 text-xs font-semibold text-ink-3">买什么</span>
          <div class="chip-row min-w-0 flex-1" role="group" aria-labelledby="sup-type-label">
            <button type="button" class="chip is-active" data-type-chip="" aria-pressed="true">
              全部<span class="mono text-xs opacity-60">{total}</span>
            </button>
            {types.map(([type, count]) => (
              <button type="button" class="chip" data-type-chip={type} aria-pressed="false">
                {type}<span class="mono text-xs opacity-60">{count}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="flex items-start gap-2">
          <span id="sup-purpose-label" class="w-14 shrink-0 pt-1.5 text-xs font-semibold text-ink-3">怎么买</span>
          <div class="chip-row min-w-0 flex-1" role="group" aria-labelledby="sup-purpose-label">
            <button type="button" class="chip is-active" data-purpose="" aria-pressed="true">不限</button>
            <button type="button" class="chip" data-purpose="listing:红榜" aria-pressed="false">
              红榜优先<span class="mono text-xs opacity-60">{redCount}</span>
            </button>
            <button type="button" class="chip" data-purpose="pitfall:no" aria-pressed="false">
              未见坑<span class="mono text-xs opacity-60">{total - pitfallCount}</span>
            </button>
            <button type="button" class="chip" data-purpose="pitfall:yes" aria-pressed="false">
              避开有坑<span class="mono text-xs opacity-60">{pitfallCount}</span>
            </button>
            <button type="button" class="chip" data-purpose="invoice:yes" aria-pressed="false">
              可开票<span class="mono text-xs opacity-60">{invoiceCount}</span>
            </button>
            <button type="button" class="chip" data-purpose="punctual:fast" aria-pressed="false">
              交期快<span class="mono text-xs opacity-60">{fastCount}</span>
            </button>
            <button type="button" class="chip" data-purpose="price:low" aria-pressed="false">
              价格低<span class="mono text-xs opacity-60">{lowPriceCount}</span>
            </button>
          </div>
        </div>

        <div class="flex items-start gap-2">
          <span id="sup-service-label" class="w-14 shrink-0 pt-1.5 text-xs font-semibold text-ink-3">工艺能力</span>
          <div class="chip-row min-w-0 flex-1" role="group" aria-labelledby="sup-service-label">
            <button type="button" class="chip is-active" data-service="" aria-pressed="true">全部</button>
            {services.slice(0, 12).map(({ service, count }) => (
              <button type="button" class="chip" data-service={service} aria-pressed="false">
                {service}<span class="mono text-xs opacity-60">{count}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </form>

    <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-xs leading-6 text-amber-900">
      「质量、交期、价格、发票」来自社区原话，是某次交易的记录，不是量化评分；同一家店不同批次可能完全不同。
      红黑榜不展示填写人、掌柜 ID、店铺链接或联系方式。
    </p>

    <div id="supplier-empty" class="card mt-6 p-10 text-center" hidden>
      <p class="text-sm font-semibold text-ink">没有匹配的店铺</p>
      <p class="mt-1 text-xs leading-5 text-ink-3">换一个品类、采购目的、工艺能力或关键词试试。</p>
    </div>

    <ul class="mt-6 grid grid-cols-1 items-start gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
      {suppliers.map(item => {
        const signals = item.signals || {}
        const raw = feedback(item)
        const full = fullFeedback(item)
        const name = item.display_name || item.name
        const initials = name.replace(/\s+/g, '').slice(0, 2).toUpperCase()
        let hue = 200
        for (let i = 0; i < name.length; i += 1) hue = (hue * 31 + name.charCodeAt(i)) % 360
        return (
          <li
            data-supplier
            data-type={item.shop_type || '其他'}
            data-services={(item.services || []).join(' ')}
            data-listing={item.listing || ''}
            data-pitfall={hasPitfall(item) ? 'yes' : 'no'}
            data-invoice={signals.invoice === 'yes' ? 'yes' : 'no'}
            data-punctual={signals.punctual || ''}
            data-price={signals.price || ''}
            data-search={searchText(item)}
            class="min-w-0"
          >
            <article class="card card-hover relative flex h-full flex-col overflow-hidden">
              {item.listing && <span class={`absolute inset-x-0 top-0 h-[3px] ${listingBar(item.listing)}`} aria-hidden="true" />}

              <div class="flex items-start gap-3 p-4 pb-3">
                <div
                  class="grid h-14 w-14 shrink-0 place-items-center rounded-lg text-[18px] font-extrabold"
                  style={`background-color: hsl(${hue} 70% 93%); color: hsl(${hue} 45% 30%)`}
                  aria-hidden="true"
                >
                  {initials}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="truncate text-base font-semibold leading-6 text-ink" title={name}>{name}</h3>
                  <p class="truncate text-xs leading-5 text-ink-3">
                    {item.shop_type || '其他'}{item.channel ? ` · ${item.channel}` : ''}
                  </p>
                  <div class="mt-1.5 flex flex-wrap gap-1">
                    <span class={`inline-flex rounded-full border px-2 py-px text-xs font-semibold leading-5 ${
                      hasPitfall(item)
                        ? 'border-danger/30 bg-danger-soft text-danger'
                        : 'border-line bg-surface-2 text-ink-3'
                    }`}>
                      {hasPitfall(item) ? '有坑' : '未见坑'}
                    </span>
                    <span class={`inline-flex rounded-full border px-2 py-px text-xs font-semibold leading-5 ${listingTone(item.listing)}`}>
                      {item.listing || '未入榜'}
                    </span>
                    {item.grade && <span class="inline-flex rounded-full border border-line bg-surface-2 px-2 py-px text-xs leading-5 text-ink-2">{item.grade}</span>}
                  </div>
                </div>
              </div>

              <div class="flex flex-1 flex-col gap-2.5 px-4 pb-4">
                {full && (
                  <div class="rounded-md border border-line bg-surface-2/60 p-2.5">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class={`text-xs font-semibold ${item.listing === '黑榜' ? 'text-danger' : 'text-ink-3'}`}>
                        {item.listing === '黑榜' ? '踩雷记录' : '社区评价'}
                      </span>
                      <span class="mono text-xs text-ink-3">{feedbackChars(item)} 字</span>
                    </div>
                    <p
                      data-feedback
                      id={`fb-${item.id}`}
                      class={`m-0 mt-1 whitespace-pre-line line-clamp-4 text-xs leading-5 ${item.listing === '黑榜' ? 'text-danger' : 'text-ink-2'}`}
                    >
                      {raw}
                    </p>
                    {feedbackChars(item) > 50 && (
                      <button
                        type="button"
                        data-feedback-toggle
                        aria-expanded="false"
                        aria-controls={`fb-${item.id}`}
                        class="mt-1.5 inline-flex h-7 items-center gap-1 rounded-full border border-line bg-surface px-2.5 text-xs font-medium text-brand hover:border-brand/50"
                      >
                        <span data-feedback-label>展开完整评价</span>
                        <span aria-hidden="true">↓</span>
                      </button>
                    )}
                  </div>
                )}

                <div class="flex flex-wrap gap-1">
                  {(item.services || []).filter(s => s !== '风险记录').slice(0, 2).map(service => (
                    <span class="inline-flex rounded-full border border-line bg-surface-2 px-2 py-px text-xs text-ink-2">{service}</span>
                  ))}
                  {(item.services || []).filter(s => s !== '风险记录').length > 2 && (
                    <span class="inline-flex rounded-full border border-line bg-surface-2 px-2 py-px text-xs text-ink-3">
                      +{(item.services || []).filter(s => s !== '风险记录').length - 2}
                    </span>
                  )}
                </div>

                <dl class="grid grid-cols-2 gap-x-3 gap-y-1 rounded-md border border-line bg-surface-2 px-2.5 py-2 text-xs leading-4">
                  <div><dt class="text-xs text-ink-3">质量</dt><dd class="line-clamp-1 text-ink-2" title={rawOrSignal(item.quality_raw, signals, 'quality')}>{rawOrSignal(item.quality_raw, signals, 'quality')}</dd></div>
                  <div><dt class="text-xs text-ink-3">交期</dt><dd class="line-clamp-1 text-ink-2" title={rawOrSignal(item.punctual_raw, signals, 'punctual')}>{rawOrSignal(item.punctual_raw, signals, 'punctual')}</dd></div>
                  <div><dt class="text-xs text-ink-3">价格</dt><dd class="line-clamp-1 text-ink-2" title={rawOrSignal(item.price_raw, signals, 'price')}>{rawOrSignal(item.price_raw, signals, 'price')}</dd></div>
                  <div><dt class="text-xs text-ink-3">发票</dt><dd class="line-clamp-1 text-ink-2" title={rawOrSignal(item.invoice_raw, signals, 'invoice')}>{rawOrSignal(item.invoice_raw, signals, 'invoice')}</dd></div>
                </dl>

                <p class="mt-auto text-xs text-ink-3">
                  {item.reported_at ? `反馈 ${item.reported_at}` : '社区记录'}
                </p>
              </div>
            </article>
          </li>
        )
      })}
    </ul>

    <p class="mt-10 rounded-md border border-line bg-surface-2 p-4 text-xs leading-6 text-ink-3">
      店铺名来自社区表与公开名录；链接、掌柜 ID、填写人和联系方式均已移除。记录仅供参考，不代表本站推荐或背书。
    </p>
  </div>
</Base>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-supplier]'))
  const q = document.getElementById('sup-q') as HTMLInputElement | null
  const count = document.getElementById('sup-count')
  const empty = document.getElementById('supplier-empty')

  // 评价展开/收起：默认 4 行；长评价才渲染按钮，不靠测量高度隐藏。
  const FEEDBACK_CLAMP = 'line-clamp-4'

  for (const card of cards) {
    const body = card.querySelector<HTMLElement>('[data-feedback]')
    const btn = card.querySelector<HTMLButtonElement>('[data-feedback-toggle]')
    const label = card.querySelector<HTMLElement>('[data-feedback-label]')
    if (!body || !btn || !label) continue
    const toggle = () => {
      const next = body.dataset.expanded !== 'true'
      body.dataset.expanded = String(next)
      body.classList.toggle(FEEDBACK_CLAMP, !next)
      btn.setAttribute('aria-expanded', String(next))
      label.textContent = next ? '收起评价' : '展开完整评价'
      body.classList.toggle('cursor-pointer', !next)
    }
    btn.addEventListener('click', toggle)
    // 点被截断的评价正文也能展开，扩大有效点击区
    body.addEventListener('click', () => {
      if (body.dataset.expanded !== 'true') toggle()
    })
  }

  const typeChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-type-chip]'))
  const serviceChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-service]'))
  const purposeChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-purpose]'))

  let activeType = ''
  let activeService = ''
  // 采购目的：每组中最多选一个（坑 / 榜单 / 发票 / 交期 / 价格），组间可叠加。
  const activePurposes = new Map<string, string>()

  const sync = (chips: HTMLButtonElement[], isActive: (chip: HTMLButtonElement) => boolean) => {
    for (const chip of chips) {
      const on = isActive(chip)
      chip.classList.toggle('is-active', on)
      chip.setAttribute('aria-pressed', String(on))
    }
  }

  const isPurposeOn = (chip: HTMLButtonElement) => {
    const raw = chip.dataset.purpose || ''
    if (!raw) return activePurposes.size === 0
    const [key, val] = raw.split(':')
    return activePurposes.get(key) === val
  }

  const matchesPurposes = (card: HTMLElement) => {
    for (const [key, val] of activePurposes) {
      if (key === 'pitfall' && card.dataset.pitfall !== val) return false
      if (key === 'listing' && card.dataset.listing !== val) return false
      if (key === 'invoice' && card.dataset.invoice !== 'yes') return false
      if (key === 'punctual' && card.dataset.punctual !== val) return false
      if (key === 'price' && card.dataset.price !== val) return false
    }
    return true
  }

  const apply = () => {
    const needle = (q?.value || '').trim().toLowerCase()
    let shown = 0
    for (const card of cards) {
      const hitType = !activeType || card.dataset.type === activeType
      const hitService = !activeService || (card.dataset.services || '').split(' ').includes(activeService)
      const hitQuery = !needle || (card.dataset.search || '').includes(needle)
      const visible = hitType && hitService && hitQuery && matchesPurposes(card)
      card.hidden = !visible
      if (visible) shown += 1
    }
    if (count) count.textContent = `显示 ${shown} / ${cards.length} 家`
    if (empty) empty.hidden = shown !== 0
  }

  typeChips.forEach(chip => chip.addEventListener('click', () => {
    activeType = chip.dataset.typeChip || ''
    sync(typeChips, item => (item.dataset.typeChip || '') === activeType)
    apply()
  }))

  serviceChips.forEach(chip => chip.addEventListener('click', () => {
    activeService = activeService === (chip.dataset.service || '') ? '' : (chip.dataset.service || '')
    sync(serviceChips, item => (item.dataset.service || '') === activeService)
    apply()
  }))

  purposeChips.forEach(chip => chip.addEventListener('click', () => {
    const raw = chip.dataset.purpose || ''
    if (!raw) {
      activePurposes.clear()
    } else {
      const [key, val] = raw.split(':')
      if (activePurposes.get(key) === val) activePurposes.delete(key)
      else activePurposes.set(key, val)
    }
    sync(purposeChips, isPurposeOn)
    apply()
  }))

  q?.addEventListener('input', apply)
  apply()

</script>
