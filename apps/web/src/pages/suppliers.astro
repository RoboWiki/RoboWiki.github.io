---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import { Badge } from '@/components/ui/badge'
import suppliersData from '@/data/suppliers.json'
import { withBase } from '@/lib/utils'

type Supplier = {
  id: string
  name: string
  display_name?: string | null
  category?: string | null
  fine?: string | null
  kind?: string | null
  listing?: string | null
  grade?: string | null
  reason?: string | null
  notes?: string | null
  channel?: string | null
  process?: string | null
  quality?: string | null
  punctual?: string | null
  price_level?: string | null
  invoice?: string | null
  tier?: string | null
  reported_at?: string | null
  reports?: number
  origin?: string | null
}

const suppliers = suppliersData.suppliers as unknown as Supplier[]
const total = suppliers.length

const categories = [...new Set(suppliers.map(item => item.category || '未分类'))]
  .map(category => ({
    category,
    items: suppliers.filter(item => (item.category || '未分类') === category),
  }))
  .sort((a, b) => b.items.length - a.items.length)

const grades = ['全新', '拆机'].map(grade => ({
  grade,
  count: suppliers.filter(item => item.grade === grade).length,
}))
const ungraded = suppliers.filter(item => !item.grade).length
const listingCounts = ['红榜', '黑榜'].map(listing => ({
  listing,
  count: suppliers.filter(item => item.listing === listing).length,
}))
const unlisted = suppliers.filter(item => !item.listing).length

const searchText = (item: Supplier) =>
  [
    item.display_name,
    item.name,
    item.category,
    item.fine,
    item.listing,
    item.grade,
    item.reason,
    item.notes,
    item.channel,
    item.process,
    item.quality,
    item.punctual,
    item.price_level,
    item.invoice,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase()

const listingClass = (listing?: string | null) =>
  listing === '红榜'
    ? 'border-transparent bg-emerald-50 text-emerald-700'
    : listing === '黑榜'
      ? 'border-transparent bg-red-50 text-red-700'
      : 'border-slate-200 text-slate-500'
const metaEntries = (item: Supplier) =>
  [
    ['细分', item.fine || item.process],
    ['渠道', item.channel],
    ['质量反馈', item.quality],
    ['交期', item.punctual],
    ['价格档', item.price_level],
    ['发票', item.invoice],
  ].filter(([, value]) => Boolean(value)) as Array<[string, string]>
---

<Base
  title="渠道与加工 · RoboWiki"
  description={`${total} 条机器人零件与加工渠道的社区记录：按品类与榜单分组，标注成色、原因与反馈时间。`}
>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '软件与渠道', href: '/software.html' }, { label: '渠道库' }]} />

  <header class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">渠道库</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">买过的人怎么说，比店铺首页怎么写更可靠。</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
      {total} 条社区记录，按品类分组。红黑榜为社区匿名填写（已去除掌柜 ID 与店铺链接），记录的是某次购买经历，不是本站的推荐或背书；下单前请自行核验。
    </p>
    <p class="mt-2 text-xs text-slate-400">数据快照：{suppliersData.meta.generated_at.slice(0, 10)} · 共 {suppliersData.meta.record_count} 条</p>
  </header>

  <form id="supplier-filters" class="mb-4 rounded-xl border border-slate-200 bg-white p-4" role="search" aria-label="筛选渠道">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <label for="sup-q" class="text-xs font-medium text-slate-600">搜索</label>
        <input
          id="sup-q"
          type="search"
          name="q"
          placeholder="店名、品类、工艺、反馈内容"
          class="mt-1 flex h-9 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm shadow-sm placeholder:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        />
      </div>
      <div>
        <label for="sup-cat" class="text-xs font-medium text-slate-600">品类</label>
        <select id="sup-cat" class="mt-1 flex h-9 w-full rounded-lg border border-slate-200 bg-white px-2 text-sm">
          <option value="">全部品类</option>
          {categories.map(category => <option value={category.category}>{category.category}（{category.items.length}）</option>)}
        </select>
      </div>
      <div>
        <label for="sup-grade" class="text-xs font-medium text-slate-600">成色</label>
        <select id="sup-grade" class="mt-1 flex h-9 w-full rounded-lg border border-slate-200 bg-white px-2 text-sm">
          <option value="">全部成色</option>
          {grades.map(grade => <option value={grade.grade}>{grade.grade}（{grade.count}）</option>)}
          <option value="__none">未标注（{ungraded}）</option>
        </select>
      </div>
      <div>
        <label for="sup-listing" class="text-xs font-medium text-slate-600">榜单</label>
        <select id="sup-listing" class="mt-1 flex h-9 w-full rounded-lg border border-slate-200 bg-white px-2 text-sm">
          <option value="">全部记录</option>
          {listingCounts.map(listing => <option value={listing.listing}>{listing.listing}（{listing.count}）</option>)}
          <option value="__none">未入榜（{unlisted}）</option>
        </select>
      </div>
    </div>
    <p id="sup-count" class="mt-3 text-xs text-slate-500" aria-live="polite">显示 {total} / {total} 家</p>
  </form>

  <div class="space-y-10">
    {categories.map(category => (
      <section
        id={`cat-${category.category}`}
        data-supplier-section
        aria-labelledby={`cat-${category.category}-title`}
        class="scroll-mt-20"
      >
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-2">
          <h2 id={`cat-${category.category}-title`} class="text-xl font-bold tracking-tight text-slate-950">{category.category}</h2>
          <span class="text-xs text-slate-400">{category.items.length} 家</span>
        </div>
        <ul class="grid grid-cols-1 gap-3 lg:grid-cols-2" role="list">
          {category.items.map(item => (
            <li
              data-supplier
              data-cat={item.category || '未分类'}
              data-grade={item.grade || ''}
              data-listing={item.listing || ''}
              data-search={searchText(item)}
            >
              <article class="flex h-full flex-col gap-2 rounded-xl border border-slate-200 bg-white p-4">
                <div class="flex flex-wrap items-center gap-1.5">
                  <h3 class="mr-auto text-base font-semibold text-slate-900">{item.display_name || item.name}</h3>
                  {item.listing ? (
                    <Badge className={listingClass(item.listing)}>{item.listing}</Badge>
                  ) : (
                    <Badge variant="outline">未入榜</Badge>
                  )}
                  {item.grade && <Badge variant="secondary">{item.grade}</Badge>}
                  {item.tier && <Badge variant="outline">来源 {item.tier}</Badge>}
                </div>

                <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                  <span>{item.category || '未分类'}</span>
                  {(item.fine || item.process) && <span>· {item.fine || item.process}</span>}
                  {item.channel && <span>· {item.channel}</span>}
                  {item.reported_at && <span>· {item.reported_at}</span>}
                  {item.reports && item.reports > 1 && <span>· {item.reports} 条反馈</span>}
                </div>

                <p class="text-sm leading-6 text-slate-700">
                  {item.reason || item.notes || '社区未留下文字说明。'}
                </p>
                {item.reason && item.notes && <p class="text-xs leading-5 text-slate-500">补充：{item.notes}</p>}

                {metaEntries(item).length > 0 && (
                  <dl class="mt-auto grid grid-cols-2 gap-x-4 gap-y-1 border-t border-slate-100 pt-2 text-xs sm:grid-cols-3">
                    {metaEntries(item).map(([label, value]) => (
                      <div class="flex gap-1">
                        <dt class="shrink-0 text-slate-400">{label}</dt>
                        <dd class="truncate text-slate-600" title={value}>{value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </article>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p class="mt-10 rounded-xl border border-slate-200 bg-white p-4 text-xs leading-6 text-slate-500">
    记录来自社区匿名填写，可能过时、片面或带主观判断；「红榜」只表示这次买得顺利，「黑榜」只表示这次出了问题，都不构成对商家的担保或指控。发现错误欢迎在
    <a href={withBase('/submit.html')} class="mx-1 text-blue-700 hover:underline">投稿页</a>纠正。
  </p>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#supplier-filters')
  const query = document.querySelector<HTMLInputElement>('#sup-q')
  const category = document.querySelector<HTMLSelectElement>('#sup-cat')
  const grade = document.querySelector<HTMLSelectElement>('#sup-grade')
  const listing = document.querySelector<HTMLSelectElement>('#sup-listing')
  const count = document.querySelector<HTMLElement>('#sup-count')
  const cards = [...document.querySelectorAll<HTMLElement>('[data-supplier]')]
  const sections = [...document.querySelectorAll<HTMLElement>('[data-supplier-section]')]

  const apply = () => {
    const term = (query?.value || '').trim().toLowerCase()
    const cat = category?.value || ''
    const gradeValue = grade?.value || ''
    const listingValue = listing?.value || ''
    let shown = 0
    for (const card of cards) {
      const matchesTerm = !term || (card.dataset.search || '').includes(term)
      const matchesCat = !cat || card.dataset.cat === cat
      const matchesGrade = !gradeValue ||
        (gradeValue === '__none' ? !card.dataset.grade : card.dataset.grade === gradeValue)
      const matchesListing = !listingValue ||
        (listingValue === '__none' ? !card.dataset.listing : card.dataset.listing === listingValue)
      const visible = matchesTerm && matchesCat && matchesGrade && matchesListing
      card.classList.toggle('hidden', !visible)
      if (visible) shown += 1
    }
    for (const section of sections) {
      const anyVisible = [...section.querySelectorAll<HTMLElement>('[data-supplier]')].some(card => !card.classList.contains('hidden'))
      section.classList.toggle('hidden', !anyVisible)
    }
    if (count) count.textContent = `显示 ${shown} / ${cards.length} 家`
  }

  form?.addEventListener('submit', event => event.preventDefault())
  for (const control of [query, category, grade, listing]) {
    control?.addEventListener('input', apply)
    control?.addEventListener('change', apply)
  }
</script>
