---
// 旧地址：/robots/<slug>.html → /builds/<slug>.html
import robotsData from '@/data/robots.json'

export function getStaticPaths() {
  const robots = robotsData.robots as unknown as { _slug: string }[]
  return robots.map(robot => ({ params: { slug: robot._slug } }))
}

const { slug } = Astro.params
const base = import.meta.env.BASE_URL
const target = `${base}builds/${slug}.html`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>页面已迁移 · RoboWiki</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-bg text-ink">
    <p class="text-sm">
      该机型页已迁移到方案库，正在跳转…… 若没有自动跳转，请点
      <a class="text-brand underline" href={target}>这里</a>。
    </p>
  </body>
</html>
