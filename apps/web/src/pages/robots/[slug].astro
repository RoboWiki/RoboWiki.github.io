---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import SpecTable from '@/components/library/SpecTable.astro'
import { specRows } from '@/components/library/specs'
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import robotsData from '@/data/robots.json'
import { formatPrice, withBase } from '@/lib/utils'

type Robot = {
  id: string
  subtype_label?: string | null
  vendor: string
  vendor_cn?: string | null
  model: string
  title: string
  url?: string | null
  price_cny?: number | null
  source_tier?: string | null
  verified?: number
  last_checked?: string | null
  specs: Record<string, unknown>
  notes?: string | null
  origin?: string | null
  _slug: string
}

export function getStaticPaths() {
  const robots = robotsData.robots as unknown as Robot[]
  return robots.map(robot => ({ params: { slug: robot._slug }, props: { robot } }))
}

const { robot } = Astro.props as { robot: Robot }
const text = (value: unknown) => (typeof value === 'string' && value ? value : null)
const display = (value: unknown) => (value === null || value === undefined || value === '' ? '—' : String(value))
const list = (value: unknown) => (Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [])
const image = text(robot.specs.image_url)
const docUrl = text(robot.specs.doc_url)
const docPdf = text(robot.specs.doc_pdf)
const license = text(robot.specs.repo_license)
const repos = list(robot.specs.repo_urls)
const urdfs = list(robot.specs.urdf_urls)
const linkClass = 'break-all text-blue-700 hover:underline'
---

<Base
  title={`${robot.vendor} ${robot.model} · 整机库 · RoboWiki`}
  description={`${robot.vendor} ${robot.model} 的公开参数、价格、开源仓库与来源。`}
  image={image ? withBase(image) : undefined}
>
  <Breadcrumbs
    items={[
      { label: '首页', href: '/' },
      { label: '整机库', href: '/robots.html' },
      { label: robot.model },
    ]}
  />

  <header class="mb-6 grid gap-5 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-[220px_minmax(0,1fr)]">
    <div class="flex h-44 items-center justify-center rounded-xl bg-slate-50">
      {image ? (
        <img src={withBase(image)} alt={`${robot.vendor} ${robot.model}`} class="h-full w-full object-contain p-4" />
      ) : (
        <span class="text-xs text-slate-400">暂无产品图</span>
      )}
    </div>
    <div>
      <div class="flex flex-wrap items-center gap-1.5">
        {robot.subtype_label && <Badge variant="secondary">{robot.subtype_label}</Badge>}
        {robot.source_tier && <Badge variant="outline">来源 {robot.source_tier} 级</Badge>}
        <Badge variant={robot.verified ? 'success' : 'secondary'}>{robot.verified ? '已核对' : '待复核'}</Badge>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{robot.model}</h1>
      <p class="mt-1 text-sm text-slate-500">{robot.vendor_cn || robot.vendor}</p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div>
          <div class="text-xs text-slate-500">自由度</div>
          <div class="mt-1 font-semibold tabular-nums">{display(robot.specs.dof)}</div>
        </div>
        <div>
          <div class="text-xs text-slate-500">整机质量</div>
          <div class="mt-1 font-semibold tabular-nums">
            {robot.specs.mass_kg == null ? '—' : `${display(robot.specs.mass_kg)} kg`}
          </div>
        </div>
        <div>
          <div class="text-xs text-slate-500">续航</div>
          <div class="mt-1 font-semibold">{display(robot.specs.endurance_h)}</div>
        </div>
        <div>
          <div class="text-xs text-slate-500">参考价</div>
          <div class="mt-1 font-semibold tabular-nums">{formatPrice(robot.price_cny)}</div>
        </div>
      </div>
    </div>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-6">
      {robot.notes && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="notes">
          <h2 id="notes" class="font-semibold text-slate-900">简介</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{robot.notes}</p>
        </section>
      )}

      <SpecTable
        id="specs"
        title="关键参数"
        rows={specRows('robot', robot.specs)}
        hint="厂商未公布或未核到的字段显示 —，不用推算值填空。"
      />

      {(repos.length > 0 || urdfs.length > 0 || docUrl || docPdf) && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="repos">
          <h2 id="repos" class="font-semibold text-slate-900">仓库与文档</h2>
          {license && <p class="mt-1 text-xs text-slate-500">仓库许可：{license}。商用或再分发前请逐个仓库核对许可条款。</p>}
          <ul class="mt-3 space-y-2 text-sm" role="list">
            {repos.map(url => (
              <li>
                <span class="mr-2 text-xs text-slate-400">仓库</span>
                <a href={url} target="_blank" rel="noopener" class={linkClass}>{url}<span class="sr-only">（新窗口打开）</span></a>
              </li>
            ))}
            {urdfs.map(url => (
              <li>
                <span class="mr-2 text-xs text-slate-400">URDF</span>
                <a href={url} target="_blank" rel="noopener" class={linkClass}>{url}<span class="sr-only">（新窗口打开）</span></a>
              </li>
            ))}
            {docUrl && (
              <li>
                <span class="mr-2 text-xs text-slate-400">文档</span>
                <a href={docUrl} target="_blank" rel="noopener" class={linkClass}>{docUrl}<span class="sr-only">（新窗口打开）</span></a>
              </li>
            )}
            {docPdf && (
              <li>
                <span class="mr-2 text-xs text-slate-400">手册</span>
                <a href={docPdf} target="_blank" rel="noopener" class={linkClass}>{docPdf}<span class="sr-only">（新窗口打开）</span></a>
              </li>
            )}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-4">
      <Card>
        <CardContent className="space-y-3 text-sm">
          <h2 class="font-semibold text-slate-900">数据口径</h2>
          <dl class="space-y-2">
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">来源等级</dt>
              <dd class="font-medium">{robot.source_tier ? `${robot.source_tier} 级` : '—'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">核对状态</dt>
              <dd class="font-medium">{robot.verified ? '已核对' : '待复核'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">最近核对</dt>
              <dd class="font-medium tabular-nums">{robot.last_checked || '—'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">参考价</dt>
              <dd class="font-medium tabular-nums">{formatPrice(robot.price_cny)}</dd>
            </div>
          </dl>
          {robot.origin && <p class="rounded-lg bg-slate-50 p-3 text-xs leading-5 text-slate-600">{robot.origin}</p>}
          {robot.url && (
            <a href={robot.url} target="_blank" rel="noopener" class="inline-flex text-blue-700 hover:underline">
              厂商页面<span class="sr-only">（新窗口打开）</span> ↗
            </a>
          )}
          <a href={withBase('/method.html')} class="block border-t border-slate-100 pt-3 text-xs text-slate-500 hover:text-blue-700">
            来源等级怎么算 →
          </a>
        </CardContent>
      </Card>
    </aside>
  </div>
</Base>
