---
// 旧地址：软件库已并入「工具链」，这里只做静态跳转。
const base = import.meta.env.BASE_URL
const target = `${base}tools.html`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>页面已迁移 · RoboWiki</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-bg text-ink">
    <p class="text-sm">
      软件库已并入「工具链」，正在跳转…… 若没有自动跳转，请点
      <a class="text-brand underline" href={target}>这里</a>。
    </p>
  </body>
</html>
