---
import Base from '@/layouts/Base.astro'
import learnData from '@/data/learn.json'
import { withBase } from '@/lib/utils'

type Resource = {
  id: string
  slug: string
  type: string
  title: string
  summary: string
  topics: string[]
  tags: string[]
  level: string
  lang?: string | null
  source: string
  authors?: string[]
  year?: number | null
  date?: string | null
  pages?: number | null
  file_url?: string | null
  cover_url?: string | null
  note_slug?: string | null
  license?: string | null
  source_url?: string | null
  web_path: string
}

const resources = (learnData.resources || []) as Resource[]

export function getStaticPaths() {
  const list = (learnData.resources || []) as Resource[]
  return list
    .filter(r => r.type === 'pdf' && r.file_url)
    .map(resource => ({ params: { slug: resource.slug }, props: { resource } }))
}

const { resource } = Astro.props as { resource: Resource }
const related = resources
  .filter(r => r.slug !== resource.slug && (r.topics || []).some(t => (resource.topics || []).includes(t)))
  .slice(0, 6)
const noteSlug = resource.note_slug || ''
const authors = (resource.authors || []).filter(Boolean).join('、')
const langLabel = resource.lang === 'en' ? '英文' : '中文'
const facts = [
  { label: '页数', value: resource.pages ? `${resource.pages} 页` : '—' },
  { label: '年份', value: resource.year ? String(resource.year) : '—' },
  { label: '语言', value: langLabel },
  { label: '难度', value: resource.level || '—' },
]
const pdfHref = withBase(resource.file_url || '')
---

<Base title={`${resource.title} · 教程库 · RoboWiki`} description={resource.summary}>
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <a href={withBase('/learn/index.html')} class="transition-colors hover:text-brand">教程库</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">{resource.title}</span>
    </nav>

    <header class="grid gap-5 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
      <div class="hidden overflow-hidden rounded-lg border border-line bg-surface-2 sm:block">
        {resource.cover_url
          ? <img src={withBase(resource.cover_url)} alt={`${resource.title}封面`} class="h-60 w-full object-cover object-top" />
          : <div class="grid h-60 place-items-center text-xs text-ink-3">PDF</div>}
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-xs text-ink-2">PDF</span>
          {(resource.topics || []).map(topic => (
            <span class="rounded-full border border-brand/30 bg-brand-soft px-2 py-0.5 text-xs text-brand">{topic}</span>
          ))}
          <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-xs text-ink-3">{resource.level}</span>
        </div>
        <h1 class="mt-3 text-2xl font-extrabold leading-tight tracking-tight text-ink sm:text-3xl">{resource.title}</h1>
        <p class="mt-2 text-sm text-ink-2">
          {resource.source}{authors ? ` · ${authors}` : ''}{resource.year ? ` · ${resource.year}` : ''}
        </p>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-ink-2">{resource.summary}</p>

        <div class="mt-5 flex flex-wrap gap-2">
          <a href={pdfHref} target="_blank" rel="noopener" class="inline-flex h-10 items-center rounded-md bg-brand px-4 text-sm font-semibold text-brand-fg hover:bg-brand-hover">
            阅读 PDF<span aria-hidden="true" class="ml-1">↗</span>
          </a>
          <a href={pdfHref} download class="inline-flex h-10 items-center rounded-md border border-line bg-surface px-4 text-sm font-medium text-ink hover:border-line-strong">
            下载
          </a>
          {noteSlug && (
            <a href={withBase(`/learn/${noteSlug}.html`)} class="inline-flex h-10 items-center rounded-md border border-line bg-surface px-4 text-sm font-medium text-ink hover:border-line-strong">
              本站导读
            </a>
          )}
        </div>
      </div>
    </header>

    <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-4">
      {facts.map(f => (
        <div class="bg-surface-2 px-4 py-3">
          <dt class="text-xs text-ink-3">{f.label}</dt>
          <dd class="mono tabular mt-1 text-sm font-semibold text-ink">{f.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <section class="card overflow-hidden" aria-labelledby="reader">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-3">
          <h2 id="reader" class="text-sm font-bold text-ink">在线阅读</h2>
          <a href={pdfHref} target="_blank" rel="noopener" class="text-xs font-medium text-brand hover:underline">新窗口打开 ↗</a>
        </div>
        <iframe src={`${pdfHref}#view=FitH`} title={`${resource.title} PDF`} class="h-[78vh] w-full bg-surface-2"></iframe>
        <div class="border-t border-line px-4 py-3 text-xs leading-5 text-ink-3">
          阅读器不可用时，请使用上方「阅读 PDF / 下载」。文件由本站托管，版权归原作者。
        </div>
      </section>

      <aside class="space-y-4">
        <section class="card p-4" aria-labelledby="meta">
          <h2 id="meta" class="text-sm font-bold text-ink">资料信息</h2>
          <dl class="mt-2 space-y-2 text-xs leading-5">
            <div class="flex justify-between gap-3"><dt class="text-ink-3">来源</dt><dd class="text-right text-ink-2">{resource.source}</dd></div>
            {authors && <div class="flex justify-between gap-3"><dt class="text-ink-3">作者</dt><dd class="text-right text-ink-2">{authors}</dd></div>}
            <div class="flex justify-between gap-3"><dt class="text-ink-3">日期</dt><dd class="text-right text-ink-2">{resource.date || resource.year || '—'}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-ink-3">许可</dt><dd class="text-right text-ink-2">{resource.license || '—'}</dd></div>
          </dl>
          {resource.source_url && (
            <a href={resource.source_url} target="_blank" rel="noopener" class="mt-3 inline-flex text-xs font-medium text-brand hover:underline">
              官方来源 ↗
            </a>
          )}
        </section>

        <section class="card p-4" aria-labelledby="tags">
          <h2 id="tags" class="text-sm font-bold text-ink">标签</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {(resource.tags || []).map(tag => (
              <span class="rounded border border-line bg-surface-2 px-1.5 py-0.5 text-xs text-ink-2">{tag}</span>
            ))}
          </div>
        </section>

        {noteSlug && (
          <section class="card p-4" aria-labelledby="note">
            <h2 id="note" class="text-sm font-bold text-ink">本站导读</h2>
            <p class="mt-2 text-xs leading-6 text-ink-2">不想先翻完整份 PDF，可以先看整理后的结论与例子。</p>
            <a href={withBase(`/learn/${noteSlug}.html`)} class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline">
              读本站导读<span aria-hidden="true">→</span>
            </a>
          </section>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-8" aria-labelledby="related">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2">
          <h2 id="related" class="text-lg font-bold tracking-tight text-ink">同方向资料</h2>
          <a href={withBase('/learn/index.html')} class="text-xs font-medium text-brand hover:underline">全部资料 →</a>
        </div>
        <ul class="mt-3 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {related.map(r => (
            <li class="min-w-0">
              <a href={withBase(r.web_path)} class="card card-hover flex h-full flex-col gap-1.5 p-3">
                <span class="text-xs font-semibold text-brand">{r.type === 'pdf' ? 'PDF' : '笔记'}</span>
                <span class="line-clamp-2 text-sm font-semibold leading-5 text-ink">{r.title}</span>
                <span class="text-xs text-ink-3">{r.source}{r.year ? ` · ${r.year}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
