---
import { getCollection, render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'
import learnData from '@/data/learn.json'

const entries = await getCollection('learn')
const index = entries.find(e => e.id === 'index')
if (!index) throw new Error('learn/index.md 缺失')
const { Content } = await render(index)

const cards = learnData.articles.map(a => ({
  title: a.title,
  href: `/learn/${a.slug}.html`,
  meta: `${a.level} · ${a.minutes} 分钟`,
  tags: a.tags,
  what: a.summary,
}))
const reprint = learnData.reprint
---

<Base title={`${index.data.title} · RoboWiki`} description={index.data.description}>
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">指南</span>
    </nav>

    <header class="max-w-3xl">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-brand uppercase">指南</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{index.data.title}</h1>
      {index.data.description && <p class="mt-3 text-sm leading-7 text-ink-2">{index.data.description}</p>}
      <p class="mono mt-3 text-[11px] text-ink-3">
        内容快照 {learnData.updated_at} · {cards.length} 篇站内文章
      </p>
    </header>

    <section class="mt-8" aria-labelledby="articles">
      <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
        <h2 id="articles" class="text-lg font-bold tracking-tight text-ink">文章</h2>
        <span class="ml-auto text-[11px] text-ink-3">什么时候看：第一次做机器人、准备下单之前。</span>
      </div>

      <ul class="grid list-none gap-3 p-0 sm:grid-cols-2" role="list">
        {cards.map(card => (
          <li class="min-w-0">
            <a href={withBase(card.href)} class="card card-hover group flex h-full flex-col gap-2.5 p-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
                <h3 class="text-[15px] font-semibold leading-6 text-ink transition-colors group-hover:text-brand">{card.title}</h3>
                <span class="mono shrink-0 text-[11px] text-ink-3">{card.meta}</span>
              </div>
              <p class="text-xs leading-6 text-ink-2">{card.what}</p>
              <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-1">
                {card.tags.map(tag => (
                  <span class="rounded border border-line bg-surface-2 px-1.5 py-0.5 text-[11px] text-ink-2">{tag}</span>
                ))}
                <span class="ml-auto text-[11px] font-medium text-brand" aria-hidden="true">阅读 →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-4 rounded-lg border border-line bg-surface-2 p-4" aria-labelledby="reprint">
      <h2 id="reprint" class="text-sm font-semibold text-ink">{reprint.title}</h2>
      <p class="mt-1 text-xs leading-6 text-ink-2">{reprint.summary}</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-6 text-ink-2">
        {reprint.rules.map(rule => <li>{rule}</li>)}
      </ul>
      <a
        href={withBase(`${reprint.link}.html`)}
        class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline"
      >
        转载规范全文<span aria-hidden="true">→</span>
      </a>
    </section>

    <div class="prose mt-10 max-w-3xl [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24 [&_table]:block [&_table]:overflow-x-auto">
      <Content />
    </div>
  </div>
</Base>
