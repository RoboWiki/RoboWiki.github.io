---
import { getCollection, render } from 'astro:content'
import Prose from '@/layouts/Prose.astro'
import LearnIndex from '@/components/prose/LearnIndex.astro'
import { withBase } from '@/lib/utils'

export async function getStaticPaths() {
  const entries = await getCollection('learn')
  // `index` maps to /learn/index.html; the flat /learn.html layout also renders it for old bookmarks.
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const isIndex = entry.id === 'index'
const { Content } = isIndex ? { Content: null } : await render(entry)
const siblings = (await getCollection('learn'))
  .filter(e => e.id !== 'index' && e.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))
---

{isIndex ? (
  <LearnIndex />
) : (
  <Prose
    title={entry.data.title}
    description={entry.data.description}
    eyebrow="指南"
    crumbs={[{ label: '指南', href: '/learn/index.html' }, { label: entry.data.title }]}
  >
    <Content />

    <Fragment slot="after">
      <nav aria-label="其它指南" class="mt-12 border-t border-slate-200 pt-6">
        <h2 class="text-sm font-semibold text-slate-900">接着读</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          <li>
            <a
              href={withBase('/learn/index.html')}
              class="block rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-blue-300 hover:text-blue-700"
            >
              指南总览 · 从零开始学
            </a>
          </li>
          {siblings.map(s => (
            <li>
              <a
                href={withBase(`/learn/${s.id}.html`)}
                class="block rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 hover:border-blue-300 hover:text-blue-700"
              >
                {s.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </Fragment>
  </Prose>
)}
