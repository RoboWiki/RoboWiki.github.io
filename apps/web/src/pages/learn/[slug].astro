---
import { getCollection, render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import GuideLanding from './_GuideLanding.astro'
import { withBase } from '@/lib/utils'

export async function getStaticPaths() {
  const entries = await getCollection('learn')
  // `index` maps to /learn/index.html; the flat /learn.html layout also renders it for old bookmarks.
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const isIndex = entry.id === 'index'
const rendered = isIndex ? null : await render(entry)
const ArticleContent = rendered?.Content
const siblings = (await getCollection('learn'))
  .filter(e => e.id !== 'index' && e.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))

const toc = (rendered?.headings ?? []).filter(h => h.depth === 2 || h.depth === 3)
---

{isIndex ? (
  <GuideLanding />
) : (
  <Base title={`${entry.data.title} · RoboWiki`} description={entry.data.description}>
    <div class="mx-auto max-w-6xl">
      <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
        <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
        <span aria-hidden="true" class="text-line-strong">/</span>
        <a href={withBase('/learn/index.html')} class="transition-colors hover:text-brand">教程库</a>
        <span aria-hidden="true" class="text-line-strong">/</span>
        <span class="text-ink-2" aria-current="page">{entry.data.title}</span>
      </nav>

      <header class="max-w-3xl">
        <p class="text-xs font-semibold tracking-[0.14em] text-brand uppercase">教程库</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{entry.data.title}</h1>
        {entry.data.description && <p class="mt-3 text-sm leading-7 text-ink-2">{entry.data.description}</p>}
      </header>

      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
        <article class="min-w-0">
          <div class="prose max-w-[44rem] [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24 [&_table]:block [&_table]:overflow-x-auto">
            {ArticleContent && <ArticleContent />}
          </div>

          <nav aria-label="其它教程" class="mt-12 max-w-3xl border-t border-line pt-6">
            <h2 class="text-sm font-semibold text-ink">接着读</h2>
            <ul class="mt-3 grid list-none gap-2 p-0 sm:grid-cols-2" role="list">
              <li class="min-w-0">
                <a
                  href={withBase('/learn/index.html')}
                  class="card card-hover flex h-full flex-col gap-1 px-3 py-2.5"
                >
                  <span class="text-sm font-medium text-ink">教程库总览 · 经典资料与导读</span>
                  <span class="text-xs leading-5 text-ink-3">第一次做机器人要做的五件事</span>
                </a>
              </li>
              {siblings.map(s => (
                <li class="min-w-0">
                  <a
                    href={withBase(`/learn/${s.id}.html`)}
                    class="card card-hover flex h-full flex-col gap-1 px-3 py-2.5"
                  >
                    <span class="text-sm font-medium text-ink">{s.data.title}</span>
                    {s.data.description && (
                      <span class="line-clamp-2 text-xs leading-5 text-ink-3">{s.data.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </article>

        {toc.length > 1 && (
          <aside aria-labelledby="toc-title" class="min-w-0">
            <nav class="lg:sticky lg:top-24" aria-labelledby="toc-title">
              <p id="toc-title" class="text-xs font-semibold tracking-[0.14em] text-ink-3 uppercase">本篇目录</p>
              <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-1 lg:border-l lg:border-line lg:pl-3">
                {toc.map((h, i) => (
                  <li class={`min-w-0 ${h.depth === 3 ? 'lg:pl-3' : ''}`}>
                    <a href={`#${h.slug}`} class="group flex items-baseline gap-2 rounded-sm py-0.5 text-sm text-ink-2 transition-colors hover:text-brand">
                      <span class="mono text-xs text-ink-3 group-hover:text-brand">{String(i + 1).padStart(2, '0')}</span>
                      <span class="truncate">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </Base>
)}
