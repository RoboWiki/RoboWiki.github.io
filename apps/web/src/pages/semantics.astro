---
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'
import semantics from '@/data/semantics.json'
import protocolData from '@/data/protocols.json'

type Field = {
  label: string
  unit?: string
  enum?: string[]
  higher_is_better?: boolean | null
  meaning: string
  missing_means: string
  known_bias?: string
}

const fields = Object.entries(semantics.field_semantics as Record<string, Field>)
const protocols = protocolData.protocols
const steps = [
  { n: 1, title: '先看来源', body: '所有参数按厂商手册或官方数据表订正；公开网页只作补充。来源决定这个数能不能直接拿去做热设计。' },
  { n: 2, title: '再看口径字段', body: 'tau_basis 是 peak 还是 rated、inertia_basis 是 rotor 还是 output。这两个字段读错，后面全错。' },
  { n: 3, title: '缺的要当缺的', body: '— 是「没公布」，不是「不支持」，也不是 0。不要用同类件填补，也不要假设额定 = 峰值 / 2。' },
  { n: 4, title: '最后才比派生量', body: '扭矩密度、峰值/额定比、反射惯量占比是结果不是原因：帮你发现异常，不帮你选型。' },
]
const unitOf = (f: Field) => (f.enum ? f.enum.join(' / ') : f.unit || '—')
const toc = [
  { id: 'steps', label: '读一个数字的四步' },
  { id: 'red-lines', label: '六条物理红线' },
  { id: 'conversions', label: '单位换算' },
  { id: 'comparability', label: '可比性等级' },
  { id: 'protocols', label: '协议语义' },
  { id: 'fields', label: '字段口径' },
  { id: 'trinary', label: '三态判定' },
]
---

<Base title="参数口径 · RoboWiki" description="同一句话在不同厂商嘴里不是同一件事：字段定义、缺口含义、物理红线、单位换算、可比性等级与协议语义。">
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <a href={withBase('/method.html')} class="transition-colors hover:text-brand">方法</a>
      <span aria-hidden="true" class="text-line-strong">/</span>
      <span class="text-ink-2" aria-current="page">参数口径</span>
    </nav>

    <header class="max-w-3xl">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-brand uppercase">参数口径</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">同一个数，在不同厂商嘴里不是同一件事。</h1>
      <p class="mt-3 text-sm leading-7 text-ink-2">
        「峰值扭矩 40 N·m」可能指瞬时 1 秒、也可能指持续堵转；「质量 0.362 kg」可能含线缆、也可能只是定转子。
        本页把字段定义、缺口含义与复核阈值写清楚；机器可读版本见
        <a href={withBase('/api/v1/semantics')} class="mono text-[13px] font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">/api/v1/semantics</a>。
      </p>

      <div class="mt-5 rounded-r-lg border-l-4 border-brand bg-surface-2 p-4">
        <p class="text-sm font-semibold leading-6 text-ink">本站统一的一条硬规则：扭矩与转速一律指输出端（含减速箱）。</p>
        <p class="mt-1 text-xs leading-6 text-ink-2">
          大疆 M3508 手册给的是电机端 0.16 N·m，本站换算成输出端 3.07 N·m（× 19.203208556，协议值 3591/187），
          原始值与算式保留在该条目的 notes 里。
        </p>
      </div>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
      <div class="min-w-0 space-y-10">
        <section aria-labelledby="steps">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">01</span>
            <h2 id="steps" class="text-lg font-bold tracking-tight text-ink">读一个数字的四步</h2>
            <span class="ml-auto text-[11px] text-ink-3">顺序不可跳</span>
          </div>

          <ol class="grid gap-3 sm:grid-cols-2" role="list">
            {steps.map(s => (
              <li class="card flex flex-col gap-2 p-4">
                <div class="flex items-baseline gap-2.5">
                  <span class="mono text-2xl font-bold leading-none text-brand/35" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
                  <h3 class="text-sm font-semibold text-ink">{s.title}</h3>
                </div>
                <p class="text-xs leading-6 text-ink-2">{s.body}</p>
              </li>
            ))}
          </ol>
        </section>

        <section aria-labelledby="red-lines">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">02</span>
            <h2 id="red-lines" class="text-lg font-bold tracking-tight text-ink">六条物理红线</h2>
            <span class="ml-auto text-[11px] text-ink-3">超过阈值先要条件</span>
          </div>

          <p class="mb-3 text-xs leading-6 text-ink-3">超过「需复核」先去要条件；超过「不可信」基本可以认定口径有问题。</p>

          <div class="grid gap-3 md:grid-cols-2">
            {semantics.red_lines.map(rl => (
              <article class="card flex flex-col p-4">
                <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
                  <h3 class="flex flex-wrap items-baseline gap-2 text-sm font-bold text-ink">
                    <span class="mono rounded border border-line bg-surface-3 px-1.5 py-0.5 text-[10px] font-semibold text-ink-3">{rl.id}</span>
                    {rl.name}
                  </h3>
                  {rl.formula && <code class="mono text-[10px] text-ink-3">{rl.formula}</code>}
                </div>

                {rl.review_above != null && (
                  <p class="mono mt-2 text-[11px] font-medium leading-5 text-warning">
                    {rl.review_above} {rl.unit ?? ''} 需复核{rl.absurd_above != null ? ` · ${rl.absurd_above} ${rl.unit ?? ''} 不可信` : ''}
                  </p>
                )}

                <p class="mt-2 text-xs leading-6 text-ink-2">{rl.why}</p>
                {rl.common_trick && (
                  <p class="mt-2 text-xs leading-6 text-ink-3">
                    <span class="font-medium text-ink-2">常见做法</span>：{rl.common_trick}
                  </p>
                )}
                <p class="mt-1 text-xs leading-6 text-ink-3">
                  <span class="font-medium text-ink-2">怎么核</span>：{rl.how_to_check}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="conversions">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">03</span>
            <h2 id="conversions" class="text-lg font-bold tracking-tight text-ink">单位换算</h2>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[40rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="w-24 px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">从</th>
                  <th scope="col" class="w-24 px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">到</th>
                  <th scope="col" class="w-[14rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">公式</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">注意</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {semantics.conversions.map(c => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3 text-xs text-ink">{c.from}</td>
                    <td class="px-3 py-3 text-xs text-ink">{c.to}</td>
                    <td class="px-3 py-3">
                      <code class="mono rounded border border-line bg-surface-2 px-1.5 py-0.5 text-[11px] text-ink-2">{c.formula}</code>
                    </td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-3">{c.warning ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="comparability">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">04</span>
            <h2 id="comparability" class="text-lg font-bold tracking-tight text-ink">可比性等级</h2>
            <span class="ml-auto text-[11px] text-ink-3">A → D</span>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {semantics.comparability.map(g => (
              <article class="card flex gap-3 p-4">
                <span class="mono grid h-7 w-7 shrink-0 place-items-center rounded border border-line bg-surface-3 text-xs font-bold text-ink-2" aria-hidden="true">{g.grade}</span>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-ink">{g.name}</h3>
                  <p class="mt-1 text-xs leading-6 text-ink-2">{g.condition}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="protocols">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">05</span>
            <h2 id="protocols" class="text-lg font-bold tracking-tight text-ink">协议语义：同一个「电流」是四个不同的量</h2>
          </div>

          <p class="mb-3 text-xs leading-6 text-ink-3">{protocolData._meta.why}</p>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[46rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">驱动</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">总线</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">控制频率</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">电流编码</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">满量程</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">控制模式</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {protocols.map(p => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3">
                      <span class="block text-xs font-semibold text-ink">{p.driver}</span>
                      <span class="block text-[11px] text-ink-3">{p.vendor}</span>
                    </td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{p.bus}</td>
                    <td class="mono px-3 py-3 text-xs text-ink-2">{p.ctrl_freq_hz} Hz</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{p.current_encoding}</td>
                    <td class="mono px-3 py-3 text-xs text-ink">±{p.current_full_scale_A} A</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{p.control_modes.join('、')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-3 space-y-2">
            {protocols.map(p => (
              <details class="group card px-3 py-2">
                <summary class="flex cursor-pointer list-none items-center gap-2 text-xs font-semibold text-ink-2 transition-colors hover:text-ink">
                  <span class="mono text-[10px] text-ink-3 transition-transform group-open:rotate-90 group-open:text-brand" aria-hidden="true">▸</span>
                  {p.driver}：注意与证据
                </summary>
                <p class="mt-2 text-xs leading-6 text-ink-2">{p.notes}</p>
                <p class="mono mt-1 text-[11px] leading-5 text-ink-3">{p.evidence}</p>
              </details>
            ))}
          </div>

          <h3 class="mb-2 mt-6 text-sm font-bold text-ink">对照检查清单</h3>
          <ul class="grid gap-2 sm:grid-cols-2" role="list">
            {protocolData.checklist.map(item => (
              <li class="flex gap-2 rounded-lg border border-line bg-surface-2 px-3 py-2 text-xs leading-6 text-ink-2">
                <span class="mt-1.5 text-[10px] text-brand" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="fields">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">06</span>
            <h2 id="fields" class="text-lg font-bold tracking-tight text-ink">字段口径</h2>
            <span class="ml-auto text-[11px] text-ink-3">{fields.length} 个字段</span>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line bg-surface">
            <table class="w-full min-w-[44rem] border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-surface-2">
                  <th scope="col" class="w-[11rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">字段</th>
                  <th scope="col" class="w-[9rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">单位 / 取值</th>
                  <th scope="col" class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">含义</th>
                  <th scope="col" class="w-[13rem] px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-3 uppercase">缺失时</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {fields.map(([key, f]) => (
                  <tr class="align-top transition-colors hover:bg-surface-2">
                    <td class="px-3 py-3">
                      <span class="block text-xs font-semibold text-ink">{f.label}</span>
                      <code class="mono block text-[10px] text-ink-3">{key}</code>
                    </td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">{unitOf(f)}</td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-2">
                      {f.meaning}
                      {f.known_bias && <span class="mt-1 block text-[11px] text-warning">已知偏差：{f.known_bias}</span>}
                    </td>
                    <td class="px-3 py-3 text-xs leading-6 text-ink-3">{f.missing_means}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="trinary">
          <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
            <span class="mono text-[11px] font-semibold text-ink-3">07</span>
            <h2 id="trinary" class="text-lg font-bold tracking-tight text-ink">判定只有三种结论</h2>
          </div>

          <div class="flex flex-wrap gap-2">
            {semantics.trinary.values.map(v => (
              <span class="mono rounded-full border border-line bg-surface-2 px-3 py-1 text-xs font-semibold text-ink-2">{v}</span>
            ))}
          </div>

          <div class="prose mt-4 max-w-none">
            <p>{semantics.trinary.why}</p>
            <ul>
              {semantics.trinary.rules.map(rule => <li>{rule}</li>)}
            </ul>
          </div>

          <p class="mt-4 text-xs leading-6 text-ink-3">
            机器可读全文：<a href={withBase('/api/v1/semantics')} class="mono text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">/api/v1/semantics</a>
            （版本 {semantics.version}）· 来源与溯源规则见
            <a href={withBase('/sources.html')} class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">数据来源</a>。
          </p>
        </section>
      </div>

      <aside aria-labelledby="toc-title" class="min-w-0">
        <nav class="lg:sticky lg:top-24" aria-labelledby="toc-title">
          <p id="toc-title" class="text-[11px] font-semibold tracking-[0.14em] text-ink-3 uppercase">本页目录</p>
          <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-1 lg:border-l lg:border-line lg:pl-3">
            {toc.map((item, i) => (
              <li class="min-w-0">
                <a href={`#${item.id}`} class="group flex items-baseline gap-2 rounded-sm py-0.5 text-[13px] text-ink-2 transition-colors hover:text-brand">
                  <span class="mono text-[10px] text-ink-3 group-hover:text-brand">{String(i + 1).padStart(2, '0')}</span>
                  <span class="truncate">{item.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-4 hidden border-t border-line pt-3 text-[11px] leading-5 text-ink-3 lg:block">
            <span class="mono text-ink-2">semantics.json</span>
            <span class="mono block">v{semantics.version}</span>
          </p>
        </nav>
      </aside>
    </div>
  </div>
</Base>
