---
import Base from '@/layouts/Base.astro'
import { catalog, dataVersion, featuredParts, imageUrl, topCategories } from '@/lib/catalog'
import { bestOfferPrice, formatPrice, partHref, withBase } from '@/lib/utils'
import { partFacts } from '@/lib/partFacts'
import { BRAIN_LAYER, POSITIONING, SKELETON_LAYERS } from '@/lib/layers'
import robotsData from '@/data/robots.json'
import materialsData from '@/data/materials.json'
import softwareData from '@/data/software.json'
import suppliersData from '@/data/suppliers.json'
import learnData from '@/data/learn.json'

const resourcesCount = (learnData.resources || []).length

// Tailwind 只能识别源码里的完整类名；tone 在 content 包里动态拼接不会被扫描到。
const layerBar: Record<string, string> = {
  mechanical: 'bg-layer-mech',
  hardware: 'bg-layer-hw',
  embedded: 'bg-layer-emb',
  algorithm: 'bg-layer-algo',
}

const equipmentCount = catalog.parts.filter((p: any) => p.category === 'equipment').length
const partCount = catalog.count - equipmentCount

const stats = [
  { label: '部件库', value: partCount, href: '/catalog.html' },
  { label: '设备库', value: equipmentCount, href: '/equipment.html' },
  { label: '整机', value: robotsData.count, href: '/robots.html' },
  { label: '材料与工艺', value: materialsData.count, href: '/materials.html' },
  { label: '软件', value: softwareData.count, href: '/software.html' },
  { label: '采购库', value: suppliersData.count, href: '/suppliers.html' },
  { label: '教程库', value: resourcesCount, href: '/learn/index.html' },
]

const steps = [
  { k: '查参数', v: '进部件库核对参数、来源与实测评价', href: '/catalog.html' },
  { k: '看方案', v: '对着整机与 BOM 确认怎么组合、能不能复现', href: '/builds.html' },
  { k: '试配', v: '用选型台按构型试配 BOM（试验版）', href: '/selector.html' },
  { k: '买与记录', v: '找加工与元件渠道，把实测提交到 GitHub Issue', href: '/suppliers.html' },
]

const faqs = [
  {
    q: '数据准不准？',
    a: '每条参数都按厂商手册或官方数据表订正过，并保留来源与核对日期。读不到的值写 null，不猜、不用同类填补。',
  },
  {
    q: '多久更新一次？',
    a: '数据以 data-v* 版本发布，页面标注当前版本号。纠正与新增走投稿，审核后进入下一个版本；站点不跟 main 分支，只消费已发布的版本。',
  },
  {
    q: '来源怎么核对？',
    a: '优先厂商手册、官方数据表与官方仓库；公开页面只作补充。每个条目都记录来源和最近核对时间，发现错误可以直接提交纠正。',
  },
  {
    q: '可以商用吗？',
    a: '代码与整理成果按 AGPL-3.0 发布，允许商用；厂商手册与商品图版权归原方。本站自身不做售卖、不收佣金、不卖数据。',
  },
]
---

<Base>
  <section class="relative overflow-hidden rounded-lg border border-line bg-surface">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.55] dark:opacity-40"
      style="background-image:linear-gradient(to right, var(--rw-border) 1px, transparent 1px),linear-gradient(to bottom, var(--rw-border) 1px, transparent 1px);background-size:44px 44px;mask-image:radial-gradient(ellipse at 70% 0%,#000 20%,transparent 72%)"
      aria-hidden="true"
    >
    </div>
    <div class="relative grid gap-10 px-6 py-12 sm:px-10 sm:py-16 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
      <div>
        <div class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-line bg-surface-2 px-3 py-1 text-xs text-ink-2">
          <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
          <span class="mono">{dataVersion}</span>
          <span class="text-ink-3">·</span>
          <span class="mono tabular">{partCount}</span> 个部件
          <span class="text-ink-3">·</span>
          <span class="mono tabular">{equipmentCount}</span> 台设备
          <span class="text-ink-3">·</span>
          <span class="mono tabular">{robotsData.count}</span> 套方案
        </div>

        <h1 class="mt-5 text-[32px] leading-[1.15] font-extrabold tracking-tight text-ink sm:text-[46px]">
          机器人知识库（内测）
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-ink-2 sm:text-base">
          教程库看教程，选型台试配 BOM，部件库查参数、评分与实测；方案库看开源生态与 BOM，采购库找加工和商家，设备库找工具仪器；评分与实测统一走数据仓 GitHub Issue。
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={withBase('/catalog.html')}
            class="inline-flex h-11 items-center rounded-md bg-brand px-5 text-sm font-semibold text-brand-fg transition-colors hover:bg-brand-hover"
          >
            进入部件库
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={withBase('/selector.html')}
            class="inline-flex h-11 items-center rounded-md border border-line bg-surface px-5 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2"
          >
            选型台（试验版）
          </a>
          <a
            href={withBase('/learn/index.html')}
            class="inline-flex h-11 items-center px-2 text-sm font-medium text-ink-2 transition-colors hover:text-brand"
          >
            从教程库入门
          </a>
        </div>

        <form action={withBase('/search.html')} method="get" role="search" class="mt-7 max-w-md">
          <label for="hero-search" class="sr-only">搜索部件、厂商或型号</label>
          <div class="relative">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
              aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <input
              id="hero-search"
              name="q"
              type="search"
              placeholder="搜索全站：型号、厂商、品类，例如 DM4310"
              autocomplete="off"
              class="h-11 w-full rounded-md border border-line bg-surface pl-9 pr-24 text-sm text-ink placeholder:text-ink-3 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
            />
            <button
              type="submit"
              class="absolute right-1 top-1 inline-flex h-9 items-center rounded-sm bg-brand px-3.5 text-xs font-semibold text-brand-fg hover:bg-brand-hover"
            >
              搜索
            </button>
          </div>
        </form>
      </div>

      <div class="relative">
        <div class="rounded-lg border border-line bg-surface-2 p-4 sm:p-5">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold tracking-wide text-ink-3 uppercase">能力分层</span>
            <span class="mono text-xs text-ink-3">4 层 + 1 大脑</span>
          </div>
          <ol class="mt-4 space-y-2">
            {SKELETON_LAYERS.map(layer => (
              <li>
                <a
                  href={withBase(`/method.html#layers`)}
                  class="group flex items-center gap-3 rounded-md border border-line bg-surface px-3 py-2.5 transition-colors hover:border-line-strong"
                >
                  <span class="mono text-xs text-ink-3">{layer.index}</span>
                  <span class={`h-6 w-px ${layerBar[layer.id]}`} aria-hidden="true"></span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold text-ink">{layer.name}</span>
                    <span class="block text-xs leading-5 text-ink-3">{layer.tagline}</span>
                  </span>
                  <span class="shrink-0 text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>

          <div class="mx-auto h-3 w-px bg-line-strong" aria-hidden="true"></div>

          {BRAIN_LAYER && (
            <a
              href={withBase(`/method.html#layers`)}
              class="group block rounded-md border border-brand/25 bg-brand-soft px-3 py-3 transition-colors hover:border-brand/40"
            >
              <div class="flex items-center gap-2">
                <span class="mono text-xs font-bold text-layer-sys" aria-hidden="true">★</span>
                <span class="text-sm font-semibold text-ink">{BRAIN_LAYER.name} · 大脑</span>
                <span class="ml-auto shrink-0 text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              <p class="mt-1 text-xs leading-5 text-ink-2">横贯四层：需求 / 接口 / 预算 / 联调</p>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-6 overflow-hidden rounded-lg border border-line bg-surface">
    <dl class="grid grid-cols-2 gap-px bg-line sm:grid-cols-4 lg:grid-cols-7">
      {stats.map(s => (
        <a href={withBase(s.href)} class="group bg-surface px-4 py-3.5 transition-colors hover:bg-surface-2">
          <dt class="text-xs text-ink-3">{s.label}</dt>
          <dd class="mono tabular mt-0.5 text-xl font-bold text-ink group-hover:text-brand">{s.value}</dd>
        </a>
      ))}
    </dl>
    <p class="border-t border-line px-4 py-2.5 text-xs text-ink-3">
      所有条目均已按厂商资料订正；参数缺失一律写 <span class="mono">null</span>，不猜、不用同类填补。
    </p>
  </section>

  <section class="mt-12">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-ink">从哪进去</h2>
        <p class="mt-1 text-sm text-ink-3">七个入口，按使用阶段排。</p>
      </div>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { href: '/learn/index.html', title: '教程库', desc: '经典 PDF 与导读，按方向筛选', count: `${resourcesCount} 份资料`, eg: '例：传动机构简述' },
        { href: '/selector.html', title: '选型台', desc: '按构型与功能试配 BOM 与 MJCF（试验版）', count: '试验版', eg: '例：四足 12 DOF' },
        { href: '/catalog.html', title: '部件库', desc: '参数带来源，缺失写 null', count: `${partCount} 个部件`, eg: '例：DM4310 参数' },
        { href: '/builds.html', title: '方案库', desc: '可复现方案，含 BOM 与步骤', count: `${robotsData.count} 套`, eg: '例：四足 5k 方案' },
        { href: '/suppliers.html', title: '采购库', desc: '按加工品类找店，先看有没有坑', count: `${suppliersData.count} 家`, eg: '例：嘉立创打样' },
        { href: '/equipment.html', title: '设备库', desc: '做机器人的工具与仪器', count: `${equipmentCount} 台设备`, eg: '例：拓竹 A1、优利德 UT89X' },
        { href: 'https://github.com/RoboWiki/RoboWiki/issues', title: '参与方式', desc: '评分、实测、纠错与投稿统一走 GitHub Issue', count: 'GitHub', eg: '无需站内注册' },
      ].map(item => (
        <a href={withBase(item.href)} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined} class="card card-hover group flex flex-col p-5">
          <div class="flex items-start justify-between">
            <span class="text-base font-semibold text-ink group-hover:text-brand">{item.title}</span>
            <span class="text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </div>
          <p class="mt-2 text-xs leading-5 text-ink-3">{item.desc}</p>
          <div class="mt-auto flex items-baseline justify-between gap-2 border-t border-line pt-3 text-xs">
            <span class="mono tabular text-ink-2">{item.count}</span>
            <span class="truncate text-ink-3">{item.eg}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 grid gap-4 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div class="card p-6">
      <h2 class="text-lg font-bold tracking-tight text-ink">怎么用本站</h2>
      <p class="mt-1.5 text-sm leading-6 text-ink-3">先在部件库核对参数与来源，再看方案、用选型台试配，最后找渠道并把实测提交到 GitHub Issue。</p>
      <ol class="mt-5 grid gap-2 sm:grid-cols-2">
        {steps.map((s, i) => (
          <li>
            <a href={withBase(s.href)} class="group flex h-full flex-col rounded-md border border-line bg-surface-2 p-4 transition-colors hover:border-line-strong hover:bg-surface">
              <span class="mono text-xs text-ink-3">0{i + 1}</span>
              <span class="mt-1.5 text-sm font-semibold text-ink group-hover:text-brand">{s.k}</span>
              <span class="mt-1 text-xs leading-5 text-ink-3">{s.v}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="card p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold tracking-tight text-ink">按品类浏览</h2>
        <a href={withBase('/catalog.html')} class="text-xs font-medium text-brand hover:underline">全部 →</a>
      </div>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {topCategories.map(c => (
          <a
            href={`${withBase('/catalog.html')}?category=${c.id}`}
            class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface px-3 text-xs text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
          >
            {c.name}
            <span class="mono tabular text-xs text-ink-3">{c.count || 0}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-12">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-ink">值得先看</h2>
        <p class="mt-1 text-sm text-ink-3">来源清楚、参数完整、GitHub 评分与实测可追溯。</p>
      </div>
      <a href={withBase('/catalog.html')} class="text-sm font-medium text-brand hover:underline">全部部件 →</a>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featuredParts.map(p => (
        <a href={partHref(p)} class="card card-hover group flex h-full flex-col overflow-hidden">
          <div class="flex h-32 items-center justify-center border-b border-line bg-surface-2">
            {p.image ? (
              <img
                src={imageUrl(p)}
                alt={`${p.vendor} ${p.model}`}
                loading="lazy"
                class="h-full w-full object-contain p-4 transition-transform duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <span class="text-xs text-ink-3">暂无产品图</span>
            )}
          </div>
          <div class="flex flex-1 flex-col gap-2 p-4">
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="text-xs font-medium text-ink-3">{p.vendor}</span>
            </div>
            <div class="text-sm font-semibold text-ink">{p.model}</div>
            <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5">
              {partFacts(p).map(f => (
                <div class="min-w-0">
                  <dt class="text-xs leading-4 text-ink-3">{f.label}</dt>
                  <dd class="mono tabular truncate text-xs leading-5 text-ink-2">{f.value}</dd>
                </div>
              ))}
            </dl>
            <div class="mt-auto flex items-baseline justify-between border-t border-line pt-2 text-xs">
              <span class="flex flex-col">
                {(() => {
                  const offer = bestOfferPrice(p.offers)
                  const regular = typeof p.price === 'number' ? p.price : null
                  return (
                    <>
                      <span class={`mono tabular ${offer !== null ? 'font-semibold text-brand' : 'text-ink-2'}`}>
                        {formatPrice(offer ?? regular)}
                        {offer !== null && <span class="ml-1 text-xs font-normal">优惠价</span>}
                      </span>
                      {offer !== null && regular !== null && offer < regular && (
                        <span class="mono tabular text-xs text-ink-3 ">参考 {formatPrice(regular)}</span>
                      )}
                    </>
                  )
                })()}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 grid gap-3 sm:grid-cols-3">
    <a href="https://github.com/RoboWiki/RoboWiki/issues" target="_blank" rel="noopener" class="card card-hover p-5">
      <div class="text-sm font-semibold text-ink">实测与评价</div>
      <p class="mt-1.5 text-sm leading-6 text-ink-3">每个部件页下都有用过的人写的实测与评价；选型前先看具体差在哪，而不是只看均分。</p>
    </a>
    <a href={withBase('/submit.html')} class="card card-hover p-5">
      <div class="text-sm font-semibold text-ink">纠正与补全</div>
      <p class="mt-1.5 text-sm leading-6 text-ink-3">参数写错、价格过期、链接失效，都可以直接提交纠正。</p>
    </a>
    <a href={withBase('/contributors.html')} class="card card-hover p-5">
      <div class="text-sm font-semibold text-ink">贡献者</div>
      <p class="mt-1.5 text-sm leading-6 text-ink-3">谁整理了这些数据、谁提供了实测记录，逐条可查。</p>
    </a>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold tracking-tight text-ink">常见问题</h2>
    <div class="mt-4 overflow-hidden rounded-lg border border-line bg-surface divide-y divide-line">
      {faqs.map(item => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-3.5 text-sm font-medium text-ink hover:bg-surface-2">
            {item.q}
            <span class="text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <p class="px-5 pb-4 text-sm leading-6 text-ink-3">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-12 overflow-hidden rounded-lg border border-line bg-surface">
    <div class="flex flex-col gap-5 p-7 sm:flex-row sm:items-center sm:justify-between sm:p-9">
      <div>
        <h2 class="text-lg font-bold tracking-tight text-ink">你知道某个参数的真实值，或者踩过坑？</h2>
        <p class="mt-1.5 text-sm leading-6 text-ink-3">
          一条纠正、一次实测、一个加工厂的报价，都会进入下一个 <span class="mono">data-v*</span> 版本。
        </p>
      </div>
      <div class="flex shrink-0 gap-2">
        <a
          href={withBase('/submit.html')}
          class="inline-flex h-10 items-center rounded-md bg-brand px-5 text-sm font-semibold text-brand-fg transition-colors hover:bg-brand-hover"
        >
          参与投稿
        </a>
        <a
          href="https://github.com/RoboWiki/RoboWiki/issues"
          target="_blank" rel="noopener"
          class="inline-flex h-10 items-center rounded-md border border-line px-4 text-sm text-ink transition-colors hover:bg-surface-2"
        >
          去 GitHub Issue
        </a>
      </div>
    </div>
  </section>
</Base>
