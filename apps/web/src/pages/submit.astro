---
import Base from '@/layouts/Base.astro'

const repo = 'https://github.com/RoboWiki/RoboWiki'
const issue = (template: string, title: string) =>
  `${repo}/issues/new?template=${template}&title=${encodeURIComponent(title)}`

const cards = [
  {
    title: '写评分',
    desc: '给一个部件打 1–5 分，填是否装过机、使用时长和一句理由。一人一件一票，编辑原 issue 即可改分。',
    href: issue('rate-part.yml', '[评分] '),
    who: '用过或买过的人 · 约 30 秒',
  },
  {
    title: '写实测',
    desc: '装上什么机器、跑多大负载、多久、温升多少、坏没坏。工况比结论重要。',
    href: issue('review-part.yml', '[实测] '),
    who: '真装机跑过的人 · 约 5 分钟',
  },
  {
    title: '纠参数 / 补数据',
    desc: '哪个件、哪个字段、现在是什么、应该是什么、来源链接。维护者按数据发布流程处理。',
    href: issue('data-fix.yml', '[纠错] '),
    who: '发现错误或手上有官方资料的人 · 约 2 分钟',
  },
  {
    title: '投稿文章 / 教程',
    desc: '选型方法、踩坑记录、开源项目拆解。要有可核对的数字和适用边界。',
    href: issue('article.yml', '[文章] '),
    who: '愿意把经验写清楚的人',
  },
]
---
<Base title="参与 · RoboWiki" description="通过 GitHub Issue 提交评分、实测、纠错与文章；站点不提供站内账号。">
  <header class="max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">参与</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink sm:text-[34px]">所有内容都走 GitHub Issue。</h1>
    <p class="mt-2 text-sm leading-6 text-ink-2">
      本站不做站内账号，也不保存邮箱或密码。评分、实测、纠错和投稿都提交到数据仓的 Issue；
      维护者审核后，数据改动进入下一次 <span class="mono">data-v*</span> 发布。
    </p>
  </header>

  <div class="mt-8 grid gap-3 sm:grid-cols-2">
    {cards.map(card => (
      <a href={card.href} target="_blank" rel="noopener"
        class="card card-hover flex flex-col p-5">
        <div class="flex items-start justify-between gap-2">
          <span class="font-semibold text-ink">{card.title}</span>
          <span aria-hidden="true" class="text-ink-3">↗</span>
        </div>
        <p class="mb-0 mt-2 flex-1 text-sm leading-6 text-ink-2">{card.desc}</p>
        <p class="mb-0 mt-3 border-t border-line pt-3 text-xs text-ink-3">{card.who}</p>
      </a>
    ))}
  </div>

  <section class="mt-8 card p-5">
    <h2 class="m-0 text-sm font-semibold text-ink">需要批量改数据？</h2>
    <p class="mt-2 text-sm leading-6 text-ink-2">
      批量新增型号、字段结构调整或口径定义，直接向数据仓提交 PR。CI 会先跑数据校验；
      不太熟 Git 也可以先开一个纠错 issue，把资料链接放进去。
    </p>
    <div class="mt-3 flex flex-wrap gap-2 text-sm">
      <a href={`${repo}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener"
        class="inline-flex h-9 items-center rounded-md border border-line px-3 font-medium text-ink hover:border-line-strong">
        数据仓贡献说明 ↗
      </a>
      <a href={`${repo}/issues`} target="_blank" rel="noopener"
        class="inline-flex h-9 items-center rounded-md border border-line px-3 font-medium text-ink hover:border-line-strong">
        查看全部 Issue ↗
      </a>
    </div>
  </section>

  <p class="mt-6 max-w-3xl text-xs leading-5 text-ink-3">
    参与需要 GitHub 账号；这是唯一的身份门槛。站点不读取你的邮箱、密码或私信，
    Issue 里的公开用户名会随内容一起展示。
  </p>
</Base>
