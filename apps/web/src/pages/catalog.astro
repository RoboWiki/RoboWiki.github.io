---
import Base from '@/layouts/Base.astro'
import CatalogExplorer from '@/components/CatalogExplorer'
import { catalog, parts as allParts } from '@/lib/catalog'
import { withBase } from '@/lib/utils'
import materialsData from '@/data/materials.json'

// 设备库已独立成页（/equipment.html）：部件库只装「进机器人身体」的零件，
// equipment 品类从这里剔除，两个库的筛选、统计、导航不再互相串。
const partCategories = (catalog.categories || []).filter(c => c.id !== 'equipment')
const parts = allParts.filter(p => p.category !== 'equipment')

// 材料工艺库并入部件库：常用材料合成一个品类，卡片直接给适用场景；
// 加工工艺仍留在材质库页面。
// 部件库里的「常用加工材料」只放这张收敛清单；材质库仍保留全量材料。
const COMMON_MATERIAL_IDS = new Set([
  'mat-alu-6061-t6', 'mat-alu-7075-t6', 'mat-alu-5052-h32', 'mat-ti-tc4',
  'mat-steel-sus304', 'mat-steel-sus316', 'mat-steel-45',
  'mat-pla', 'mat-petg', 'mat-abs-fdm', 'mat-pla-cf', 'mat-tpu',
  'mat-cfrp-t300', 'mat-gfrp', 'mat-fr4', 'mat-bakelite',
])
const groupOrder = new Map(materialsData.groups.map((group, index) => [group.id, index]))
const materials = materialsData.materials
  .filter(m => COMMON_MATERIAL_IDS.has(m.id))
  .sort((a, b) => (groupOrder.get(a.group) ?? groupOrder.size) - (groupOrder.get(b.group) ?? groupOrder.size))
  .map(m => ({
    id: m.id,
    group_label: m.group_label,
    family_label: m.family_label,
    title: m.title,
    name_en: m.name_en,
    aliases: m.aliases,
    notes: m.notes,
    applications: m.applications,
    specs: {
      density_g_cm3: m.specs.density_g_cm3 ?? null,
      modulus_GPa: m.specs.modulus_GPa ?? null,
      service_temp_C: m.specs.service_temp_C ?? null,
    },
    _href: m._href,
  }))
const categories = [
  ...partCategories,
  { id: 'materials', name: '常用加工材料' },
]

const vendors = new Set(parts.map(p => p.vendor).filter(Boolean)).size
const stats = [
  { label: '部件库', value: parts.length },
  { label: '厂商', value: vendors },
  { label: '品类', value: partCategories.length },
]
---
<Base title="部件库 · RoboWiki" description={`${parts.length} 个机器人硬件部件，按品类、厂商与参数筛选。`}>
  <header class="mb-6">
    <nav class="text-xs text-ink-3" aria-label="面包屑">
      <a href="/" class="hover:text-ink">首页</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-ink-2">部件库</span>
    </nav>

    <div class="mt-3 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">按任务找件，不按广告找件。</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-3">
          所有条目均已按厂商资料订正；价格缺就写询价，参数缺就写 null。
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <a href={withBase('/compare.html')} class="font-medium text-brand hover:underline">并排对比 2–4 个部件 →</a>
          <a href={withBase('/open.html')} class="text-ink-2 hover:text-brand">只看带开源仓库的</a>
          <a href={withBase('/equipment.html')} class="text-ink-2 hover:text-brand">焊台、电源与仪器去设备库</a>
        </div>
      </div>
      <dl class="grid shrink-0 grid-cols-3 gap-px overflow-hidden rounded-md border border-line bg-line">
        {stats.map(s => (
          <div class="bg-surface px-3 py-3">
            <dt class="text-xs text-ink-3">{s.label}</dt>
            <dd class="mono tabular mt-0.5 text-lg font-bold text-ink">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <CatalogExplorer client:load parts={parts} categories={categories} materials={materials} />
</Base>
