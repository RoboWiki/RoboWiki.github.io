---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/community/Breadcrumbs.astro'
import IslandFallback from '@/components/community/IslandFallback.astro'
import CommunityFeed from '@/components/community/community-feed'
---
<Base
  title="社区 · RoboWiki"
  description="机器人硬件的真实使用反馈：关节、主控、传感器的实测数据与踩坑记录。"
>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '社区' }]} />

  <header class="mb-5 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">社区</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink sm:text-[34px]">提出您的宝贵建议</h1>
    <p class="mt-2 text-sm leading-6 text-ink-2">
      您的每一个评价，都会让后来者少走弯路
    </p>
  </header>

  <div class="min-h-[60vh]">
    <IslandFallback label="正在加载社区帖子…" rows={3} />
    <CommunityFeed client:only="react" />
  </div>
</Base>
