---
import Base from '@/layouts/Base.astro'

const target = '/app/#/pages/account/index'
---
<Base title="账号 · RoboWiki" description="账号中心已迁移到 RoboWiki 互动端。">
  <section class="card mx-auto max-w-xl p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">账号</p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-ink">账号中心</h1>
    <p class="mt-2 text-sm leading-6 text-ink-2">
      资料、密码、会话与通知已统一到互动端，打开后会自动进入账号页。
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <a href={target}
        class="inline-flex h-11 items-center rounded-md bg-brand px-5 text-sm font-medium text-brand-fg transition-colors hover:bg-brand-hover">
        打开账号中心 →
      </a>
      <a href="/community.html" class="text-[13px] text-ink-3 transition-colors hover:text-ink">先去社区</a>
    </div>

    <p class="mt-4 border-t border-line pt-3 text-[11.5px] text-ink-3">
      没有自动跳转？<a href={target} class="text-brand hover:underline">点这里</a>。
    </p>
  </section>
  <script>
    location.replace('/app/#/pages/account/index')
  </script>
</Base>
