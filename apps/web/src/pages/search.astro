---
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'

const hot = [
  { label: 'DM-J4310', q: 'DM-J4310' },
  { label: 'M3508', q: 'M3508' },
  { label: '达妙', q: '达妙' },
  { label: '宇树', q: '宇树' },
  { label: '激光雷达', q: '激光雷达' },
  { label: '四足', q: '四足' },
  { label: '轴承', q: '轴承' },
  { label: '开源', q: '开源' },
]
---

<Base
  title="搜索 · RoboWiki"
  description="一次搜全站：部件、方案、材料工艺、工具、渠道、指南与竞赛资料。"
  noindex
>
  <nav class="mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-ink-3" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-brand">首页</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <span class="text-ink-2" aria-current="page">搜索</span>
  </nav>

  <header class="max-w-3xl">
    <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-[32px]">搜索全站</h1>
    <p class="mt-2 text-sm leading-7 text-ink-2">
      部件、方案、材料工艺、工具、渠道、指南与竞赛资料，一次搜完。
    </p>
  </header>

  <form id="search-form" role="search" class="mt-6 max-w-2xl" action={withBase('/search.html')} method="get">
    <label for="q" class="sr-only">搜索关键词</label>
    <div class="relative">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
        aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-3">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
      </svg>
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="型号、厂商、品类、材料、渠道…"
        class="h-12 w-full rounded-md border border-line bg-surface pl-11 pr-24 text-[15px] text-ink placeholder:text-ink-3 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
      />
      <button
        type="submit"
        class="absolute right-1.5 top-1.5 inline-flex h-9 items-center rounded-sm bg-brand px-4 text-[13px] font-semibold text-brand-fg hover:bg-brand-hover"
      >
        搜索
      </button>
    </div>
  </form>

  <div class="mt-3 flex flex-wrap items-center gap-1.5" id="hot-row">
    <span class="text-[11px] text-ink-3">试试</span>
    {hot.map(item => (
      <a
        href={`${withBase('/search.html')}?q=${encodeURIComponent(item.q)}`}
        data-q={item.q}
        class="inline-flex h-7 items-center rounded-full border border-line bg-surface px-2.5 text-[12px] text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
      >
        {item.label}
      </a>
    ))}
  </div>

  <p id="search-status" class="mt-6 text-[13px] text-ink-3" role="status" aria-live="polite"></p>

  <div id="results" class="mt-4 space-y-6"></div>

  <template id="result-template">
    <a class="group flex items-start gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-surface-2">
      <span class="mt-0.5 shrink-0 rounded-sm border border-line bg-surface-2 px-1.5 py-0.5 text-[10px] text-ink-3" data-kind></span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-medium text-ink group-hover:text-brand" data-title></span>
        <span class="mt-0.5 block truncate text-[11px] text-ink-3" data-sub></span>
      </span>
      <span class="mt-1 shrink-0 text-ink-3 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
    </a>
  </template>

  <script>
    const BASE = import.meta.env.BASE_URL
    const KIND_LABEL: Record<string, string> = {
      part: '部件',
      build: '方案',
      material: '材料',
      tool: '工具',
      supplier: '渠道',
      doc: '文档',
      page: '页面',
    }
    const KIND_ORDER = ['part', 'build', 'material', 'tool', 'doc', 'supplier', 'page']
    const PER_GROUP = 8

    type Entry = { k: string; t: string; d: string; u: string; x: string }

    const form = document.getElementById('search-form') as HTMLFormElement | null
    const input = document.getElementById('q') as HTMLInputElement | null
    const status = document.getElementById('search-status')
    const results = document.getElementById('results')
    const template = document.getElementById('result-template') as HTMLTemplateElement | null

    let index: Entry[] | null = null
    let loading: Promise<Entry[]> | null = null

    const load = (): Promise<Entry[]> => {
      if (index) return Promise.resolve(index)
      if (loading) return loading
      loading = fetch(`${BASE}search-index.json`)
        .then(r => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((data: { entries: Entry[] }) => {
          index = data.entries || []
          return index
        })
        .catch(error => {
          loading = null
          throw error
        })
      return loading
    }

    // 型号里的连字符/空格不该影响命中：DM4310 要能搜到 DM-J4310-2EC。
    const norm = (value: string) => value.toLowerCase().replace(/[\s\-_/.]+/g, '')

    type Row = { entry: Entry; hay: string; hayN: string; titleN: string }

    let rowsCache: Row[] | null = null
    const rowsOf = (entries: Entry[]): Row[] => {
      if (rowsCache) return rowsCache
      rowsCache = entries.map(entry => {
        const hay = `${entry.t} ${entry.d} ${entry.x}`.toLowerCase()
        return { entry, hay, hayN: norm(hay), titleN: norm(entry.t) }
      })
      return rowsCache
    }

    const hits = (row: Row, tokens: string[]) =>
      tokens.every(token => {
        const plain = token.toLowerCase()
        const tight = norm(token)
        return row.hay.includes(plain) || (tight.length > 1 && row.hayN.includes(tight))
      })

    // 允许每两个命中字符之间最多跳过 2 个字符；用于「漏打一个字母」的型号。
    const looseContains = (hay: string, needle: string, maxSkip = 2) => {
      let pos = 0
      for (const ch of needle) {
        const idx = hay.indexOf(ch, pos)
        if (idx < 0 || idx - pos > maxSkip) return false
        pos = idx + 1
      }
      return true
    }

    const score = (row: Row, needle: string) => {
      if (row.titleN === needle) return 0
      if (row.titleN.startsWith(needle)) return 1
      if (row.titleN.includes(needle)) return 2
      if (row.hayN.includes(needle)) return 3
      return 4
    }

    const render = (entries: Entry[], query: string) => {
      if (!results || !status || !template) return
      results.innerHTML = ''
      const needle = query.trim().toLowerCase()

      if (!needle) {
        status.textContent = '输入关键词开始搜索。索引覆盖 600+ 条目，本地匹配，不上传查询。'
        return
      }

      const tokens = needle.split(/\s+/).filter(Boolean)
      const rows = rowsOf(entries)
      const needleN = norm(needle)
      let matched = rows.filter(row => hits(row, tokens))
      let loose = false

      // 精确匹配为空时退一步：允许漏掉少量字符（DM4310 能命中 DM-J4310）。
      if (!matched.length && needleN.length >= 3) {
        matched = rows.filter(row => tokens.every(token => {
          const tight = norm(token)
          return tight.length > 2 && looseContains(row.hayN, tight)
        }))
        loose = matched.length > 0
      }

      matched.sort((a, b) => score(a, needleN) - score(b, needleN))

      if (!matched.length) {
        status.textContent = `没有匹配「${query.trim()}」的条目。换个型号或厂商试试，也可以去部件库按品类筛。`
        return
      }

      status.textContent = loose
        ? `没有精确匹配，以下是 ${matched.length} 条近似结果（可能不是你想要的，换关键词更准）`
        : `找到 ${matched.length} 条结果`

      for (const kind of KIND_ORDER) {
        const group = matched.filter(row => row.entry.k === kind)
        if (!group.length) continue
        const shown = group.slice(0, PER_GROUP)

        const section = document.createElement('section')
        const heading = document.createElement('h2')
        heading.className = 'text-[11px] font-semibold tracking-wide text-ink-3 uppercase'
        heading.textContent = `${KIND_LABEL[kind] ?? kind} · ${group.length}`
        section.appendChild(heading)

        const list = document.createElement('div')
        list.className = 'mt-2 overflow-hidden rounded-lg border border-line bg-surface'
        for (const { entry } of shown) {
          const node = template.content.cloneNode(true) as DocumentFragment
          const link = node.querySelector('a') as HTMLAnchorElement
          link.href = entry.u
          ;(node.querySelector('[data-kind]') as HTMLElement).textContent = KIND_LABEL[entry.k] ?? entry.k
          ;(node.querySelector('[data-title]') as HTMLElement).textContent = entry.t
          ;(node.querySelector('[data-sub]') as HTMLElement).textContent = entry.d
          list.appendChild(node)
        }
        section.appendChild(list)

        if (group.length > shown.length) {
          const more = document.createElement('p')
          more.className = 'mt-1.5 px-3 text-[11px] text-ink-3'
          more.textContent = `还有 ${group.length - shown.length} 条同类结果，用更具体的关键词缩小范围。`
          section.appendChild(more)
        }
        results.appendChild(section)
      }
    }

    const sync = (value: string) => {
      if (typeof window === 'undefined') return
      const url = new URL(window.location.href)
      if (value) url.searchParams.set('q', value)
      else url.searchParams.delete('q')
      window.history.replaceState(null, '', `${url.pathname}${url.search}`)
    }

    const run = async (value: string, updateUrl = false) => {
      if (updateUrl) sync(value)
      try {
        const entries = await load()
        render(entries, value)
      } catch {
        if (status) status.textContent = '索引加载失败，请刷新重试。'
      }
    }

    const initial = new URLSearchParams(window.location.search).get('q') || ''
    if (input) input.value = initial
    run(initial)

    if (input) {
      let timer: number | undefined
      input.addEventListener('input', () => {
        window.clearTimeout(timer)
        const value = input.value
        timer = window.setTimeout(() => run(value, true), 120)
      })
      input.focus()
      input.setSelectionRange(input.value.length, input.value.length)
    }

    if (form) {
      form.addEventListener('submit', event => {
        event.preventDefault()
        run(input?.value ?? '', true)
      })
    }
  </script>
</Base>
