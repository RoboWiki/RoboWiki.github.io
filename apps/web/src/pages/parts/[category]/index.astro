---
import Base from '@/layouts/Base.astro'
import { categoryGroups, categoryLabel, parts } from '@/lib/catalog'
import { bestOfferPrice, formatPrice, partHref, withBase } from '@/lib/utils'

export function getStaticPaths() {
  const categories = [...new Set(parts.map(p => p.category))]
  return categories.map(category => ({ params: { category }, props: { category } }))
}

const { category } = Astro.props as { category: string }
const categoryParts = parts.filter(p => p.category === category)
const groups = categoryGroups[category] || []
const title = `${categoryLabel(category)} · RoboWiki`
const description = `${categoryLabel(category)} 共 ${categoryParts.length} 个型号的参数、价格、来源与真实使用经验。`
const tierCounts = categoryParts.reduce<Record<string, number>>((acc, p) => {
  if (p.tier) acc[p.tier] = (acc[p.tier] || 0) + 1
  return acc
}, {})
---

<Base title={title} description={description}>
  <nav class="mb-4 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-ink-3" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-brand">首页</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <a href={withBase('/catalog.html')} class="hover:text-brand">部件库</a>
    <span class="text-line-strong" aria-hidden="true">/</span>
    <span class="text-ink-2" aria-current="page">{categoryLabel(category)}</span>
  </nav>

  <header class="mb-7 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{categoryLabel(category)}</h1>
      <p class="mt-1.5 text-sm text-ink-3">
        共 <span class="mono tabular font-semibold text-ink">{categoryParts.length}</span> 个型号 ·
        <span class="mono tabular font-semibold text-ink">{groups.length}</span> 个分组
      </p>
      <div class="mt-2 flex items-center gap-1.5">
        {tierCounts.A && <span class="tier tier-a">A {tierCounts.A}</span>}
        {tierCounts.B && <span class="tier tier-b">B {tierCounts.B}</span>}
        {tierCounts.C && <span class="tier tier-c">C {tierCounts.C}</span>}
      </div>
    </div>
    <a href={`${withBase('/catalog.html')}?category=${category}`} class="text-sm font-medium text-brand hover:underline">
      在部件库筛选 →
    </a>
  </header>

  {groups.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-sm font-semibold text-ink">按分组找</h2>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
        {groups.map(g => (
          <a href={withBase(`/parts/${category}/${g.key}.html`)} class="card card-hover group p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="text-sm font-semibold text-ink">{g.label}</span>
              <span class="text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </div>
            <div class="mono tabular mt-1.5 text-xs text-ink-3">{g.slugs.length} 个型号</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="mb-3 text-sm font-semibold text-ink">全部型号</h2>
    <div class="overflow-hidden rounded-lg border border-line bg-surface">
      <ul class="divide-y divide-line">
        {categoryParts.map(p => (
          <li>
            <a href={partHref(p)} class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 transition-colors hover:bg-surface-2">
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-ink">{p.model}</span>
                <span class="block truncate text-xs text-ink-3">{p.vendor}</span>
              </span>
              {p.subtypeLabel && <span class="rounded-full border border-line px-2 py-0.5 text-[11px] text-ink-2">{p.subtypeLabel}</span>}
              <span class="flex w-28 flex-col items-end text-right">
                {(() => {
                  const offer = bestOfferPrice(p.offers)
                  const regular = typeof p.price === 'number' ? p.price : null
                  return (
                    <>
                      <span class={`mono tabular text-xs ${offer !== null ? 'font-semibold text-brand' : 'text-ink-2'}`}>
                        {formatPrice(offer ?? regular)}
                        {offer !== null && <span class="ml-1 text-[10px] font-normal">活动价</span>}
                      </span>
                      {offer !== null && regular !== null && offer < regular && (
                        <span class="mono tabular text-[10px] text-ink-3 line-through">参考 {formatPrice(regular)}</span>
                      )}
                    </>
                  )
                })()}
              </span>
              <span class="w-14 text-right">
                {p.tier && (
                  <span class={p.tier === 'A' ? 'tier tier-a' : p.tier === 'B' ? 'tier tier-b' : 'tier tier-c'}>{p.tier}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
