---
import Base from '@/layouts/Base.astro'
import { Badge } from '@/components/ui/badge'
import { categoryGroups, categoryLabel, parts } from '@/lib/catalog'
import { formatPrice, partHref, withBase } from '@/lib/utils'

export function getStaticPaths() {
  const categories = [...new Set(parts.map(p => p.category))]
  return categories.map(category => ({ params: { category }, props: { category } }))
}

const { category } = Astro.props as { category: string }
const categoryParts = parts.filter(p => p.category === category)
const groups = categoryGroups[category] || []
const title = `${categoryLabel(category)} · RoboWiki`
const description = `${categoryLabel(category)} 共 ${categoryParts.length} 个型号的参数、价格、来源与真实使用经验。`
---

<Base title={title} description={description}>
  <nav class="mb-4 flex items-center gap-2 text-xs text-slate-500" aria-label="面包屑">
    <a href={withBase('/')} class="hover:text-blue-700">首页</a><span>/</span>
    <a href={withBase('/catalog.html')} class="hover:text-blue-700">部件库</a><span>/</span>
    <span class="text-slate-700">{categoryLabel(category)}</span>
  </nav>

  <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-950">{categoryLabel(category)}</h1>
      <p class="mt-1 text-sm text-slate-500">共 {categoryParts.length} 个型号 · {groups.length} 个分组</p>
    </div>
    <a href={`${withBase('/catalog.html')}?category=${category}`} class="text-sm font-medium text-blue-700 hover:underline">在部件库筛选 →</a>
  </header>

  {groups.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-lg font-bold text-slate-900">按分组找</h2>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
        {groups.map(g => (
          <a href={withBase(`/parts/${category}/${g.key}.html`)} class="rounded-xl border border-slate-200 bg-white p-4 transition hover:border-blue-200 hover:shadow-sm">
            <div class="text-sm font-semibold text-slate-900">{g.label}</div>
            <div class="mt-1 text-xs text-slate-500">{g.slugs.length} 个型号</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="mb-3 text-lg font-bold text-slate-900">全部型号</h2>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <ul class="divide-y divide-slate-100">
        {categoryParts.map(p => (
          <li>
            <a href={partHref(p)} class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3 transition hover:bg-slate-50">
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-slate-900">{p.model}</span>
                <span class="block truncate text-xs text-slate-500">{p.vendor}</span>
              </span>
              {p.subtypeLabel && <Badge variant="outline">{p.subtypeLabel}</Badge>}
              <span class="w-20 text-right text-xs tabular-nums text-slate-600">{formatPrice(p.price)}</span>
              <span class="w-16 text-right text-xs text-slate-400">{p.tier ? `来源 ${p.tier}` : ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
