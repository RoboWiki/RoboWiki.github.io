---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import materialsData from '@/data/materials.json'
import { withBase } from '@/lib/utils'

type Form = { form: string; spec?: string | null; note?: string | null }
type Item = {
  id: string
  category: 'material' | 'process'
  group: string
  group_label: string
  family_label: string
  title: string
  name_en?: string | null
  aliases?: string[]
  notes?: string | null
  applications?: string[] | null
  forms?: Form[] | null
  source_tier?: string | null
  verified?: number
  specs: Record<string, unknown>
  _href: string
}

const materials = materialsData.materials as unknown as Item[]
const processes = materialsData.processes as unknown as Item[]
const sections = materialsData.groups
  .map(group => ({
    ...group,
    items: [
      ...materials.filter(item => item.group === group.id),
      ...(group.id === 'process' ? processes : []),
    ],
  }))
  .filter(group => group.items.length > 0)
const total = materials.length + processes.length

function summary(item: Item): Array<{ label: string; value: string }> {
  const specs = item.specs
  const out: Array<{ label: string; value: string }> = []
  if (item.category === 'process') {
    if (specs.tolerance_mm != null) out.push({ label: '公差', value: `±${specs.tolerance_mm} mm` })
    if (specs.lead_time) out.push({ label: '交期', value: String(specs.lead_time) })
  } else {
    if (specs.density_g_cm3 != null) out.push({ label: '密度', value: `${specs.density_g_cm3} g/cm³` })
    if (specs.modulus_GPa != null) out.push({ label: '模量', value: `${specs.modulus_GPa} GPa` })
    if (specs.service_temp_C != null) out.push({ label: '耐温', value: `${specs.service_temp_C} °C` })
  }
  return out
}

const searchText = (item: Item) =>
  [item.title, item.name_en ?? '', item.family_label, item.group_label, (item.aliases ?? []).join(' ')].join(' ')

const stats = [
  { label: '结构材料', value: materials.length, unit: '种' },
  { label: '加工工艺', value: processes.length, unit: '种' },
  { label: '分类', value: sections.length, unit: '类' },
]
---

<Base
  title="材质库 · RoboWiki"
  description={`${materials.length} 种结构材料与 ${processes.length} 种加工工艺：密度、模量、强度、形态规格与工艺能力边界。`}
>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '材质库' }]} />

  <header class="relative overflow-hidden rounded-lg border border-line bg-surface p-6 sm:p-8">
    <div
      class="pointer-events-none absolute -right-20 -top-28 h-64 w-64 rounded-full bg-brand-soft opacity-80 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <p class="text-xs font-semibold tracking-[0.14em] text-brand uppercase">材质库 / Materials</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">
        先看物理属性，再看工艺能不能做。
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-ink-2">
        收录 {materials.length} 种材料与 {processes.length} 种加工工艺，共 {total} 条。参数取公开资料与供应商典型值；没有公开值的字段显示 —，不用推算值填空。
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-4">
        {stats.map(stat => (
          <div class="bg-surface-2 px-4 py-3">
            <dt class="text-[11px] font-medium tracking-wide text-ink-3">{stat.label}</dt>
            <dd class="mt-1 flex items-baseline gap-1">
              <span class="mono tabular text-xl font-semibold leading-none text-ink">{stat.value}</span>
              <span class="text-[11px] text-ink-3">{stat.unit}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <div class="sticky top-16 z-30 -mx-4 mt-6 border-b border-line bg-bg/90 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="chip-row" role="group" aria-label="按材质分类筛选">
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
          全部<span class="mono tabular text-[11px] opacity-60">{total}</span>
        </button>
        {sections.map(group => (
          <button type="button" class="chip" data-filter={group.id} aria-pressed="false">
            {group.label}<span class="mono tabular text-[11px] opacity-60">{group.items.length}</span>
          </button>
        ))}
      </div>
      <label class="flex h-9 shrink-0 items-center gap-2 rounded-md border border-line bg-surface px-3 text-ink-3 focus-within:border-brand lg:w-60">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <input
          id="material-search"
          type="search"
          placeholder="搜索材料 / 别名 / 工艺"
          aria-label="搜索材料名称、别名或工艺"
          class="w-full bg-transparent text-sm text-ink placeholder:text-ink-3 focus:outline-none"
        />
      </label>
    </div>
    <p class="mt-2 text-xs text-ink-3" aria-live="polite">
      <span id="material-count" class="mono tabular text-ink-2">{total}</span> 条符合当前筛选
    </p>
  </div>

  <div class="mt-8 space-y-10">
    {sections.map(group => (
      <section
        id={`group-${group.id}`}
        data-group={group.id}
        aria-labelledby={`group-${group.id}-title`}
        class="scroll-mt-40"
      >
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2.5">
          <div>
            <h2 id={`group-${group.id}-title`} class="text-lg font-bold tracking-tight text-ink sm:text-xl">
              {group.label}
            </h2>
          </div>
          <span class="mono tabular text-xs text-ink-3">{group.items.length} 条</span>
        </div>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {group.items.map(item => {
            const pairs = summary(item)
            return (
              <li data-item data-group={group.id} data-search={searchText(item)} class="flex">
                <a
                  href={withBase(`/materials/${item._href}.html`)}
                  class="card card-hover group flex h-full w-full flex-col p-4 focus-visible:outline-none"
                >
                  <div class="flex items-start justify-between gap-2">
                    <span
                      class={`inline-flex h-6 items-center rounded-full px-2.5 text-[11px] font-semibold ${
                        item.category === 'process'
                          ? 'bg-warning-soft text-warning'
                          : 'bg-brand-soft text-brand'
                      }`}
                    >
                      {item.category === 'process' ? '加工工艺' : item.family_label}
                    </span>
                                      </div>

                  <h3 class="mt-2.5 text-sm font-semibold leading-5 text-ink transition-colors group-hover:text-brand">
                    {item.title}
                  </h3>
                  {item.name_en && <p class="mt-0.5 line-clamp-1 text-xs text-ink-3">{item.name_en}</p>}

                  {pairs.length > 0 ? (
                    <dl class="mt-3 space-y-1 border-t border-line pt-3 text-xs">
                      {pairs.map(pair => (
                        <div class="flex items-baseline justify-between gap-2">
                          <dt class="text-ink-3">{pair.label}</dt>
                          <dd class="mono tabular font-medium text-ink-2">{pair.value}</dd>
                        </div>
                      ))}
                    </dl>
                  ) : (
                    <p class="mt-3 border-t border-line pt-3 text-xs text-ink-3">暂无公开参数</p>
                  )}

                  {item.notes && (
                    <p class="mt-2.5 line-clamp-2 text-xs leading-5 text-ink-3">{item.notes}</p>
                  )}
                  <span class="mt-auto pt-3 text-xs font-medium text-brand">
                    查看参数<span aria-hidden="true"> →</span>
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
  </div>

  <div id="material-empty" class="card mt-8 p-10 text-center" data-empty hidden>
    <p class="text-sm font-semibold text-ink">没有匹配的条目</p>
    <p class="mt-1 text-xs leading-5 text-ink-3">
      换一个材料名、英文名或别名试试；也可以点「全部」清除分类筛选。
    </p>
  </div>

  <p class="mt-10 rounded-md border border-line bg-surface-2 p-4 text-xs leading-6 text-ink-3">
    物理量是常温典型值；热处理状态、纤维方向、含水率与批次都会让实际值偏离。加工工艺的公差与交期随厂商、批量与结构变化，下单前请以报价单为准。
    <a href={withBase('/method.html')} class="ml-1 font-medium text-brand hover:underline">方法与来源 →</a>
  </p>
</Base>

<style>
  section[hidden],
  li[data-item][hidden],
  [data-empty][hidden] {
    display: none !important;
  }
</style>

<script>
  const search = document.getElementById('material-search') as HTMLInputElement | null
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'))
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-group]'))
  const counter = document.getElementById('material-count')
  const empty = document.getElementById('material-empty')
  let active = 'all'

  const apply = () => {
    const query = (search?.value || '').trim().toLowerCase()
    let visible = 0
    for (const section of sections) {
      const group = section.dataset.group || ''
      if (active !== 'all' && group !== active) {
        section.hidden = true
        continue
      }
      let shown = 0
      for (const item of Array.from(section.querySelectorAll<HTMLElement>('li[data-item]'))) {
        const hit = !query || (item.dataset.search || '').toLowerCase().includes(query)
        item.hidden = !hit
        if (hit) shown += 1
      }
      section.hidden = shown === 0
      visible += shown
    }
    if (counter) counter.textContent = String(visible)
    if (empty) empty.hidden = visible !== 0
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      active = chip.dataset.filter || 'all'
      for (const other of chips) {
        const on = other === chip
        other.classList.toggle('is-active', on)
        other.setAttribute('aria-pressed', String(on))
      }
      apply()
    })
  }
  search?.addEventListener('input', apply)
</script>
