---
import { withBase } from '@/lib/utils'
const target = withBase('/learn/index.html')
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>教程库 · RoboWiki</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target)</script>
  </head>
  <body>
    <p>学习路径已并入 <a href={target}>教程库</a>。</p>
  </body>
</html>
