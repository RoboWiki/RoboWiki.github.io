---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import robotsData from '@/data/robots.json'
import { formatPrice, withBase } from '@/lib/utils'

type Robot = {
  id: string
  subtype?: string | null
  subtype_label?: string | null
  vendor: string
  vendor_cn?: string | null
  model: string
  title: string
  price_cny?: number | null
  source_tier?: string | null
  verified?: number
  specs: Record<string, unknown>
  openness?: 'full' | 'partial' | null
  bom?: Array<{ name: string; qty: number }> | null
  artifacts?: Record<string, string | null> | null
  ecosystem?: {
    count?: number
    projects?: Array<{ name?: string; url?: string; role?: string }>
  } | null
  _slug: string
}

const robots = robotsData.robots as unknown as Robot[]
const ecoCount = (robot: Robot) =>
  Number(robot.ecosystem?.count ?? robot.specs.ecosystem_count ?? 0) || 0
const ecoProjects = (robot: Robot) => (robot.ecosystem?.projects || []).filter(p => p?.url).length
const isFull = (robot: Robot) => robot.openness === 'full'
const artifact = (robot: Robot, key: string) => {
  const value = robot.artifacts?.[key]
  return typeof value === 'string' && value ? value : ''
}
const hasBom = (robot: Robot) => Boolean(robot.bom?.length || artifact(robot, 'bom'))
const FULL_COUNT = robots.filter(isFull).length
const PARTIAL_COUNT = robots.length - FULL_COUNT
const BOM_COUNT = robots.filter(robot => isFull(robot) && hasBom(robot)).length
const CAD_COUNT = robots.filter(robot => Boolean(artifact(robot, 'cad'))).length
/** 卡片上的资料徽标：只列仓库里真有的，不拿“全开源”三个字代替。 */
const packageBadges = (robot: Robot) => {
  if (!isFull(robot)) return []
  const badges: string[] = []
  if (hasBom(robot)) badges.push('BOM')
  if (artifact(robot, 'cad')) badges.push('机械')
  if (artifact(robot, 'hardware')) badges.push('硬件')
  if (artifact(robot, 'firmware')) badges.push('固件')
  if (artifact(robot, 'assembly')) badges.push('装配')
  return badges
}
const defaultSort = [...robots].sort((a, b) =>
  ecoCount(b) - ecoCount(a) || ecoProjects(b) - ecoProjects(a) || a.model.localeCompare(b.model, 'zh-CN'))

const vendorCount = new Set(robots.map(robot => robot.vendor)).size
const pricedCount = robots.filter(robot => robot.price_cny != null).length
const groups = [...new Set(robots.map(robot => robot.subtype_label || '其他'))]
  .map(label => ({ label, count: robots.filter(robot => (robot.subtype_label || '其他') === label).length }))
  .sort((a, b) => b.count - a.count)

const imageSrc = (robot: Robot) =>
  typeof robot.specs.image_url === 'string' ? withBase(robot.specs.image_url) : ''
const specText = (robot: Robot, key: string) => {
  const value = robot.specs[key]
  return value === null || value === undefined || value === '' ? null : String(value)
}
/** 卡片参数格：厂商没公布就写「—」，与部件卡片同一口径，不留空白。 */
const factText = (robot: Robot, key: string, unit = '') => {
  const value = specText(robot, key)
  if (!value) return '—'
  // 值里已带单位（2–4h、4–6h（综合工况））就不再拼一次。
  return unit && !/[A-Za-zµ°]/.test(value) ? `${value}${unit}` : value
}
const num = (robot: Robot, key: string) => {
  const value = Number(robot.specs[key])
  return Number.isFinite(value) ? value : -1
}
const searchText = (robot: Robot) =>
  [robot.model, robot.title, robot.vendor, robot.vendor_cn ?? '', robot.subtype_label ?? '']
    .filter(Boolean).join(' ').toLowerCase()
---

<Base
  title="方案库 · RoboWiki"
  description={`${robots.length} 套整机方案：${FULL_COUNT} 套全开源（BOM、机械设计与硬件资料）与 ${PARTIAL_COUNT} 套半开源（SDK/URDF/训练开放）。`}
>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '方案库' }]} />

  <header class="relative overflow-hidden rounded-lg border border-line bg-surface p-6 sm:p-8">
    <div class="pointer-events-none absolute -right-20 -top-28 h-64 w-64 rounded-full bg-brand-soft opacity-80 blur-3xl" aria-hidden="true"></div>
    <div class="relative">
      <p class="text-xs font-semibold tracking-[0.14em] text-brand uppercase">方案库 / Builds</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">
        先看能不能复现，再看开源生态。
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-ink-2">
        方案分两类：<span class="font-medium text-ink">全开源</span>公开 BOM、机械设计与硬件资料，能照着做一台；
        <span class="font-medium text-ink">半开源</span>开放 SDK、URDF、训练或部署，但机械结构与硬件不公开。
        卡片按仓库里真实存在的资料标 BOM / 机械 / 硬件，不用“全开源”三个字代替证据。
      </p>

      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-4">
        <div class="bg-surface-2 px-4 py-3"><dt class="text-xs font-medium tracking-wide text-ink-3">收录方案</dt><dd class="mt-1 flex items-baseline gap-1"><span class="mono tabular text-xl font-semibold leading-none text-ink">{robots.length}</span><span class="text-xs text-ink-3">套</span></dd></div>
        <div class="bg-surface-2 px-4 py-3"><dt class="text-xs font-medium tracking-wide text-ink-3">全开源</dt><dd class="mt-1 flex items-baseline gap-1"><span class="mono tabular text-xl font-semibold leading-none text-success">{FULL_COUNT}</span><span class="text-xs text-ink-3">套</span></dd></div>
        <div class="bg-surface-2 px-4 py-3"><dt class="text-xs font-medium tracking-wide text-ink-3">有 BOM 表</dt><dd class="mt-1 flex items-baseline gap-1"><span class="mono tabular text-xl font-semibold leading-none text-ink">{BOM_COUNT}</span><span class="text-xs text-ink-3">套</span></dd></div>
        <div class="bg-surface-2 px-4 py-3"><dt class="text-xs font-medium tracking-wide text-ink-3">半开源</dt><dd class="mt-1 flex items-baseline gap-1"><span class="mono tabular text-xl font-semibold leading-none text-ink">{PARTIAL_COUNT}</span><span class="text-xs text-ink-3">套</span></dd></div>
      </dl>
      <p class="mt-2.5 text-xs text-ink-3">
        覆盖 {vendorCount} 家厂商，{CAD_COUNT} 套公开机械 CAD，{pricedCount} 台有厂商公开标价；生态是参考库索引，不等于官方支持。
      </p>
    </div>
  </header>

  <div class="sticky top-16 z-30 -mx-4 mt-6 border-b border-line bg-bg/90 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6">
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <span class="shrink-0 text-xs font-semibold text-ink-3">开源程度</span>
        <div class="chip-row min-w-0 flex-1" role="group" aria-label="按开源程度筛选">
          <button type="button" class="chip is-active" data-openness-filter="all" aria-pressed="true">
            全部<span class="mono tabular text-xs opacity-60">{robots.length}</span>
          </button>
          <button type="button" class="chip" data-openness-filter="full" aria-pressed="false">
            全开源<span class="mono tabular text-xs opacity-60">{FULL_COUNT}</span>
          </button>
          <button type="button" class="chip" data-openness-filter="partial" aria-pressed="false">
            半开源<span class="mono tabular text-xs opacity-60">{PARTIAL_COUNT}</span>
          </button>
        </div>
      </div>
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex min-w-0 items-center gap-2">
          <span class="shrink-0 text-xs font-semibold text-ink-3">形态</span>
          <div class="chip-row min-w-0 flex-1" role="group" aria-label="按整机形态筛选">
            <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
              全部<span class="mono tabular text-xs opacity-60">{robots.length}</span>
            </button>
            {groups.map(group => (
              <button type="button" class="chip" data-filter={group.label} aria-pressed="false">
                {group.label}<span class="mono tabular text-xs opacity-60">{group.count}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
        <label class="flex h-9 shrink-0 items-center gap-2 rounded-md border border-line bg-surface px-3 text-ink-3 focus-within:border-brand lg:w-52">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          <input id="robot-search" type="search" data-guide="builds-search" placeholder="搜索型号 / 厂商" aria-label="搜索整机型号或厂商" class="w-full bg-transparent text-sm text-ink placeholder:text-ink-3 focus:outline-none" />
        </label>
        <label class="flex h-9 items-center gap-2 text-xs text-ink-3">
          排序
          <select id="robot-sort" class="h-8 rounded-md border border-line bg-surface px-2 text-xs text-ink">
            <option value="eco">开源生态丰富度</option>
            <option value="projects">生态项目数</option>
            <option value="dof">自由度</option>
            <option value="mass">质量</option>
            <option value="price">参考价</option>
            <option value="name">型号</option>
          </select>
        </label>
      </div>
    </div>
    <p class="mt-2 text-xs text-ink-3" aria-live="polite">
      <span id="robot-count" class="mono tabular text-ink-2">{robots.length}</span> 台符合当前筛选
    </p>
    </div>
  </div>

  <ul id="build-grid" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {defaultSort.map(robot => (
      <li
        data-item
        data-type={robot.subtype_label || '其他'}
        data-openness={isFull(robot) ? 'full' : 'partial'}
        data-search={searchText(robot)}
        data-eco={ecoCount(robot)}
        data-projects={ecoProjects(robot)}
        data-dof={num(robot, 'dof')}
        data-mass={num(robot, 'mass_kg')}
        data-price={typeof robot.price_cny === 'number' ? robot.price_cny : -1}
        data-name={robot.model}
        class="flex min-w-0"
      >
        <a href={withBase(`/builds/${robot._slug}.html`)} class="card card-hover group flex h-full w-full flex-col overflow-hidden focus-visible:outline-none">
          <div class="relative flex h-40 shrink-0 items-center justify-center overflow-hidden border-b border-line bg-surface-2">
            {imageSrc(robot) ? (
              <img src={imageSrc(robot)} alt={`${robot.vendor} ${robot.model}`} loading="lazy" class="h-full w-full object-contain p-4 transition-transform duration-300 group-hover:scale-[1.03]" />
            ) : (
              <span class="flex flex-col items-center gap-1 text-xs text-ink-3">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="2" /><path d="M12 3v4M9 12h.01M15 12h.01" stroke-linecap="round" /></svg>
                暂无产品图
              </span>
            )}
            <span class={`absolute left-3 top-3 rounded-full border px-2 py-0.5 text-xs font-semibold ${
              isFull(robot)
                ? 'border-success/30 bg-success-soft text-success'
                : 'border-line bg-surface/90 text-ink-2 backdrop-blur'
            }`}>
              {isFull(robot) ? '全开源' : '半开源'}
            </span>
            <span class="absolute right-3 top-3 rounded-full border border-brand/20 bg-brand-soft px-2 py-0.5 text-xs font-semibold text-brand">
              生态 {ecoCount(robot)}
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-3 p-4">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="truncate text-sm font-semibold leading-5 text-ink transition-colors group-hover:text-brand">{robot.model}</h3>
                <p class="mt-0.5 truncate text-xs text-ink-3">{robot.vendor_cn || robot.vendor}</p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-1 text-xs leading-5 text-ink-3">
              <span>{robot.subtype_label || '其他'}</span>
              {isFull(robot) ? (
                packageBadges(robot).length ? (
                  <>
                    {packageBadges(robot).slice(0, 4).map(badge => (
                      <span class="inline-flex rounded-full border border-line bg-surface-2 px-2 py-px text-xs text-ink-2">{badge}</span>
                    ))}
                    {packageBadges(robot).length > 4 && (
                      <span class="inline-flex rounded-full border border-line bg-surface-2 px-2 py-px text-xs text-ink-3">
                        +{packageBadges(robot).length - 4}
                      </span>
                    )}
                  </>
                ) : (
                  <span class="rounded-full border border-dashed border-line px-2 py-px text-xs text-ink-3">资料待补</span>
                )
              ) : (
                <span class="rounded-full border border-line bg-surface-2 px-2 py-px text-xs text-ink-3">SDK / URDF / 训练开放</span>
              )}
            </div>

            <dl class="mt-auto grid grid-cols-3 gap-x-2 gap-y-2 border-t border-line pt-3">
              <div class="min-w-0"><dt class="text-xs text-ink-3">自由度</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{factText(robot, 'dof')}</dd></div>
              <div class="min-w-0"><dt class="text-xs text-ink-3">质量</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{factText(robot, 'mass_kg', ' kg')}</dd></div>
              <div class="min-w-0"><dt class="text-xs text-ink-3">最大速度</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{factText(robot, 'speed_max_mps', ' m/s')}</dd></div>
              <div class="min-w-0"><dt class="text-xs text-ink-3">负载</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{factText(robot, 'payload_kg', ' kg')}</dd></div>
              <div class="min-w-0"><dt class="text-xs text-ink-3">续航</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{factText(robot, 'endurance_h', ' h')}</dd></div>
              <div class="min-w-0"><dt class="text-xs text-ink-3">参考价</dt><dd class="mono tabular mt-0.5 truncate text-sm font-semibold text-ink">{formatPrice(robot.price_cny)}</dd></div>
            </dl>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <div id="robot-empty" class="card mt-8 p-10 text-center" data-empty hidden>
    <p class="text-sm font-semibold text-ink">没有匹配的整机</p>
    <p class="mt-1 text-xs leading-5 text-ink-3">换一个型号或厂商关键词，或点「全部」清除开源程度与形态筛选。</p>
  </div>

  <p class="mt-10 rounded-md border border-line bg-surface-2 p-4 text-xs leading-6 text-ink-3">
    全开源/半开源按官方仓库里实际公开的资料判定：BOM、机械 CAD、硬件/PCB、固件与装配说明分别标注，缺哪项就不亮哪项。
    生态项目数来自参考库索引，只说明「哪些环节有现成开源实现」，不代表官方支持或可直接适配。
    参数与价格来自厂商官网、官方仓库与 URDF；价格只在厂商公开标价时展示，其余写询价。
    <a href={withBase('/method.html')} class="ml-1 font-medium text-brand hover:underline">方法与来源 →</a>
  </p>
</Base>

<script>
  const grid = document.getElementById('build-grid')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'))
  const search = document.getElementById('robot-search') as HTMLInputElement | null
  const sortSelect = document.getElementById('robot-sort') as HTMLSelectElement | null
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'))
  const opennessChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-openness-filter]'))
  const counter = document.getElementById('robot-count')
  const empty = document.getElementById('robot-empty')
  let activeType = 'all'
  let activeOpenness = 'all'

  const number = (card: HTMLElement, key: string) => Number(card.dataset[key] || -1)
  const sortCards = () => {
    const key = sortSelect?.value || 'eco'
    const sorted = [...cards].sort((a, b) => {
      if (key === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'zh-CN')
      if (key === 'mass') {
        const av = number(a, 'mass'), bv = number(b, 'mass')
        if (av < 0 && bv < 0) return 0
        if (av < 0) return 1
        if (bv < 0) return -1
        return av - bv
      }
      return number(b, key) - number(a, key)
    })
    for (const card of sorted) grid?.appendChild(card)
  }

  const apply = () => {
    const needle = (search?.value || '').trim().toLowerCase()
    let visible = 0
    for (const card of cards) {
      const hitType = activeType === 'all' || card.dataset.type === activeType
      const hitOpenness = activeOpenness === 'all' || card.dataset.openness === activeOpenness
      const hitQuery = !needle || (card.dataset.search || '').includes(needle)
      const show = hitType && hitOpenness && hitQuery
      card.hidden = !show
      if (show) visible += 1
    }
    if (counter) counter.textContent = String(visible)
    if (empty) empty.hidden = visible !== 0
    if (grid) grid.hidden = visible === 0
  }

  chips.forEach(button => button.addEventListener('click', () => {
    activeType = button.dataset.filter || 'all'
    for (const other of chips) {
      const on = other.dataset.filter === activeType
      other.classList.toggle('is-active', on)
      other.setAttribute('aria-pressed', String(on))
    }
    apply()
  }))
  opennessChips.forEach(button => button.addEventListener('click', () => {
    activeOpenness = button.dataset.opennessFilter || 'all'
    for (const other of opennessChips) {
      const on = other.dataset.opennessFilter === activeOpenness
      other.classList.toggle('is-active', on)
      other.setAttribute('aria-pressed', String(on))
    }
    apply()
  }))
  search?.addEventListener('input', apply)
  sortSelect?.addEventListener('change', sortCards)
  sortCards()
  apply()
</script>

<style>
  [data-item][hidden],
  [data-empty][hidden] {
    display: none !important;
  }
</style>
