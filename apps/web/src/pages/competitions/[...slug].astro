---
import { getCollection, render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { withBase } from '@/lib/utils'

export async function getStaticPaths() {
  const entries = await getCollection('competitions')
  const paths = entries.map(entry => ({ params: { slug: entry.id }, props: { id: entry.id } }))
  // Astro normalizes /x/index to /x/ while rendering, so the legacy /competitions/<group>/index.html
  // paths also need an item keyed by the parent slug. Both URLs render the same page.
  for (const entry of entries) {
    if (entry.id.endsWith('/index')) {
      paths.push({ params: { slug: entry.id.slice(0, -'/index'.length) }, props: { id: entry.id } })
    }
  }
  return paths
}

const GROUP_LABELS: Record<string, string> = {
  ec: '电控',
  hardware: '硬件',
  mechanical: '机械',
  pm: '项目管理',
  rl: '强化学习',
}

const { id } = Astro.props
const all = await getCollection('competitions')
const entry = all.find(e => e.id === id)
if (!entry) throw new Error(`competitions/${id}.md 缺失`)
const { Content, headings } = await render(entry)

const [group] = entry.id.split('/')
const groupLabel = GROUP_LABELS[group] ?? '实战资料'
const isGroupIndex = !entry.id.includes('/') || entry.id.endsWith('/index')
const groupIndex = all.find(e => e.id === `${group}/index`) ?? all.find(e => e.id === group)
const groupHref = groupIndex ? `/competitions/${groupIndex.id}.html` : '/competitions.html'

const siblings = all
  .filter(e => e.id.startsWith(`${group}/`) && e.id !== entry.id && e.id !== groupIndex?.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'))

const crumbs = isGroupIndex
  ? [{ label: '实战资料', href: '/competitions.html' }, { label: groupLabel }]
  : [
      { label: '实战资料', href: '/competitions.html' },
      { label: groupLabel, href: groupHref },
      { label: entry.data.title },
    ]
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
---

<Base title={`${entry.data.title} · RoboWiki`} description={entry.data.description}>
  <div class="mx-auto max-w-6xl">
    <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-3">
      <a href={withBase('/')} class="transition-colors hover:text-brand">首页</a>
      {crumbs.map(c => (
        <>
          <span aria-hidden="true" class="text-line-strong">/</span>
          {c.href ? (
            <a href={withBase(c.href)} class="transition-colors hover:text-brand">{c.label}</a>
          ) : (
            <span class="text-ink-2" aria-current="page">{c.label}</span>
          )}
        </>
      ))}
    </nav>

    <header class="max-w-3xl">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-brand uppercase">
        {isGroupIndex ? `实战资料 · ${groupLabel}` : groupLabel}
      </p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{entry.data.title}</h1>
      {entry.data.description && <p class="mt-3 text-sm leading-7 text-ink-2">{entry.data.description}</p>}
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
      <article class="min-w-0">
        <div class="prose max-w-3xl [&_h2]:scroll-mt-24 [&_h3]:scroll-mt-24 [&_table]:block [&_table]:overflow-x-auto">
          <Content />
        </div>

        {isGroupIndex && siblings.length > 0 && (
          <section class="mt-12 max-w-3xl border-t border-line pt-6" aria-labelledby="group-articles">
            <h2 id="group-articles" class="text-sm font-semibold text-ink">本组文章</h2>
            <ul class="mt-3 grid list-none gap-2 p-0 sm:grid-cols-2" role="list">
              {siblings.map(item => (
                <li class="min-w-0">
                  <a
                    href={withBase(`/competitions/${item.id}.html`)}
                    class="card card-hover flex h-full flex-col gap-1 px-3 py-2.5"
                  >
                    <span class="text-[13px] font-medium text-ink">{item.data.title}</span>
                    {item.data.description && (
                      <span class="line-clamp-2 text-[11px] leading-5 text-ink-3">{item.data.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {!isGroupIndex && (
          <nav aria-label="返回模块" class="mt-12 flex max-w-3xl flex-wrap gap-2 border-t border-line pt-6">
            <a href={withBase(groupHref)} class="chip">← 返回{groupLabel}</a>
            <a href={withBase('/competitions.html')} class="chip">全部竞赛资料</a>
          </nav>
        )}
      </article>

      {toc.length > 1 && (
        <aside aria-labelledby="toc-title" class="min-w-0">
          <nav class="lg:sticky lg:top-24" aria-labelledby="toc-title">
            <p id="toc-title" class="text-[11px] font-semibold tracking-[0.14em] text-ink-3 uppercase">本篇目录</p>
            <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-1 lg:border-l lg:border-line lg:pl-3">
              {toc.map((h, i) => (
                <li class={`min-w-0 ${h.depth === 3 ? 'lg:pl-3' : ''}`}>
                  <a href={`#${h.slug}`} class="group flex items-baseline gap-2 rounded-sm py-0.5 text-[13px] text-ink-2 transition-colors hover:text-brand">
                    <span class="mono text-[10px] text-ink-3 group-hover:text-brand">{String(i + 1).padStart(2, '0')}</span>
                    <span class="truncate">{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
  </div>
</Base>
