---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import { specRows } from '@/components/library/specs'
import materialsData from '@/data/materials.json'
import { withBase } from '@/lib/utils'

type Form = { form: string; spec?: string | null; note?: string | null }
type Ref = { id: string; name: string; _href: string }
type SupplierRef = {
  id: string
  name: string
  category?: string | null
  fine?: string | null
  role?: string | null
  price_level?: string | null
  note?: string | null
}
type Item = {
  id: string
  category: 'material' | 'process'
  group_label: string
  family_label: string
  name: string
  name_en?: string | null
  title: string
  aliases?: string[]
  url?: string | null
  sources?: Array<{ url: string; kind?: string; checked_on?: string }>
  source_tier?: string | null
  verified?: number
  last_checked?: string | null
  origin?: string | null
  specs: Record<string, unknown>
  forms?: Form[] | null
  applications?: string[] | null
  pros?: string | null
  cons?: string | null
  notes?: string | null
  _href: string
  _processes?: Ref[]
  _materials?: Ref[]
  _suppliers?: SupplierRef[]
}
type Entry = Item & { kind: 'material' | 'process' }

export function getStaticPaths() {
  const entries: Entry[] = [
    ...(materialsData.materials as unknown as Item[]).map(item => ({ ...item, kind: 'material' as const })),
    ...(materialsData.processes as unknown as Item[]).map(item => ({ ...item, kind: 'process' as const })),
  ]
  return entries.map(entry => ({ params: { slug: entry._href }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Entry }
const isProcess = entry.kind === 'process'
const forms = entry.forms ?? []
const applications = entry.applications ?? []
const related = isProcess ? (entry._materials ?? []) : (entry._processes ?? [])
const suppliers = entry._suppliers ?? []
const sources = (entry.sources ?? []).filter(source => source.url)
const rows = specRows(isProcess ? 'process' : 'material', entry.specs)
const filled = rows.filter(row => row.value !== '—').length
const priceNote = typeof entry.specs.price_note === 'string' ? entry.specs.price_note : null
const priceLevel = typeof entry.specs.price_level === 'string' ? entry.specs.price_level : null
const simNote = typeof entry.specs.sim_note === 'string' ? entry.specs.sim_note : null
const toleranceNote = typeof entry.specs.tolerance_note === 'string' ? entry.specs.tolerance_note : null
const docUrl = typeof entry.specs.doc_url === 'string' ? entry.specs.doc_url : null

const chipClass =
  'inline-flex items-center whitespace-nowrap rounded-full border border-line bg-surface px-2.5 py-0.5 text-xs text-ink-2'
const linkChipClass =
  'inline-flex items-center rounded-full border border-line bg-surface px-3 py-1 text-xs text-ink-2 transition-colors hover:border-brand hover:text-brand'
---

<Base
  title={`${entry.title} · 材质库 · RoboWiki`}
  description={`${entry.title}（${entry.family_label}）的公开参数、形态规格、加工工艺与来源。`}
>
  <Breadcrumbs
    items={[
      { label: '首页', href: '/' },
      { label: '材质库', href: '/materials.html' },
      { label: entry.title },
    ]}
  />

  <header class="card p-5 sm:p-7">
    <div class="chip-row">
      <span
        class={`inline-flex h-6 items-center rounded-full px-2.5 text-xs font-semibold ${
          isProcess ? 'bg-warning-soft text-warning' : 'bg-brand-soft text-brand'
        }`}
      >
        {isProcess ? '加工工艺' : entry.group_label}
      </span>
      <span class={chipClass}>{entry.family_label}</span>
    </div>

    <h1 class="mt-3.5 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{entry.title}</h1>
    {entry.name_en && <p class="mt-1.5 text-sm text-ink-2">{entry.name_en}</p>}
    {entry.aliases && entry.aliases.length > 0 && (
      <p class="mt-2 text-xs text-ink-3">别名：{entry.aliases.join(' / ')}</p>
    )}

    <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-4 text-xs">
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-3">最近核对</dt>
        <dd class="mono tabular font-medium text-ink">{entry.last_checked || '—'}</dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-3">{isProcess ? '可加工材料' : '相关工艺'}</dt>
        <dd class="mono tabular font-medium text-ink">{related.length}</dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-3">{isProcess ? '形态' : '形态规格'}</dt>
        <dd class="mono tabular font-medium text-ink">{forms.length}</dd>
      </div>
      <div class="flex items-baseline gap-2">
        <dt class="text-ink-3">来源</dt>
        <dd class="mono tabular font-medium text-ink">{sources.length}</dd>
      </div>
    </dl>
  </header>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="space-y-5">
      {entry.notes && (
        <section class="card p-5 sm:p-6" aria-labelledby="intro">
          <h2 id="intro" class="text-base font-bold tracking-tight text-ink">简介</h2>
          <p class="mt-2.5 text-sm leading-7 text-ink-2">{entry.notes}</p>
        </section>
      )}

      <section class="card p-5 sm:p-6" aria-labelledby="specs">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="specs" class="text-base font-bold tracking-tight text-ink">
            {isProcess ? '工艺能力' : '物理属性与仿真'}
          </h2>
          <span class="mono tabular text-xs text-ink-3">{filled} / {rows.length} 项有公开值</span>
        </div>
        <p class="mt-1 text-xs leading-5 text-ink-3">
          {isProcess
            ? '公差、交期与成本随厂商、批量与结构变化，下单前以报价单为准。'
            : '数值为常温典型值；热处理状态、纤维方向与批次会让实际值偏离。'}
        </p>
        <dl class="mt-4 grid gap-x-8 sm:grid-cols-2">
          {rows.map(row => (
            <div class="flex items-start justify-between gap-4 border-b border-line py-2 text-sm">
              <dt class="shrink-0 text-ink-3">{row.label}</dt>
              <dd class="tabular text-right font-medium text-ink">{row.value}</dd>
            </div>
          ))}
        </dl>
        {(isProcess ? toleranceNote : simNote) && (
          <p class="mt-4 rounded-md border border-line bg-surface-2 p-3 text-xs leading-6 text-ink-2">
            {isProcess ? toleranceNote : simNote}
          </p>
        )}
      </section>

      {forms.length > 0 && (
        <section class="card p-5 sm:p-6" aria-labelledby="forms">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="forms" class="text-base font-bold tracking-tight text-ink">形态与规格</h2>
            <span class="mono tabular text-xs text-ink-3">{forms.length} 种形态</span>
          </div>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full min-w-[480px] text-left text-sm">
              <caption class="sr-only">{entry.title} 可提供的形态与对应规格</caption>
              <thead>
                <tr class="border-b border-line-strong text-xs text-ink-3">
                  <th scope="col" class="py-2 pr-4 font-medium">形态</th>
                  <th scope="col" class="py-2 pr-4 font-medium">规格</th>
                  <th scope="col" class="py-2 font-medium">说明</th>
                </tr>
              </thead>
              <tbody>
                {forms.map(form => (
                  <tr class="border-b border-line align-top last:border-b-0">
                    <th scope="row" class="py-2.5 pr-4 font-semibold text-ink">{form.form}</th>
                    <td class="mono tabular py-2.5 pr-4 text-ink-2">{form.spec || '—'}</td>
                    <td class="py-2.5 leading-6 text-ink-3">{form.note || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {(entry.pros || entry.cons) && (
        <div class="grid gap-4 sm:grid-cols-2">
          {entry.pros && (
            <section class="rounded-lg border border-line bg-success-soft p-5" aria-labelledby="pros">
              <h2 id="pros" class="flex items-center gap-2 text-sm font-bold text-success">
                <span class="grid h-5 w-5 place-items-center rounded-full bg-success text-xs font-bold text-brand-fg" aria-hidden="true">+</span>
                优点
              </h2>
              <p class="mt-2 text-sm leading-6 text-ink-2">{entry.pros}</p>
            </section>
          )}
          {entry.cons && (
            <section class="rounded-lg border border-line bg-warning-soft p-5" aria-labelledby="cons">
              <h2 id="cons" class="flex items-center gap-2 text-sm font-bold text-warning">
                <span class="grid h-5 w-5 place-items-center rounded-full bg-warning text-xs font-bold text-brand-fg" aria-hidden="true">−</span>
                限制
              </h2>
              <p class="mt-2 text-sm leading-6 text-ink-2">{entry.cons}</p>
            </section>
          )}
        </div>
      )}

      <section class="card p-5 sm:p-6" aria-labelledby="suppliers">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="suppliers" class="text-base font-bold tracking-tight text-ink">渠道与价格</h2>
          <a href={withBase('/suppliers.html')} class="text-xs font-medium text-brand hover:underline">采购库 →</a>
        </div>
        {priceNote || priceLevel ? (
          <p class="mt-2 text-sm leading-6 text-ink-2">
            参考价格档：<strong class="mono font-semibold text-ink">{priceLevel || '—'}</strong>
            {priceNote ? `。${priceNote}` : ''}
          </p>
        ) : null}
        {suppliers.length > 0 ? (
          <>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full min-w-[560px] text-left text-sm">
                <caption class="sr-only">与本条目相关的社区渠道记录，仅作线索，不构成推荐</caption>
                <thead>
                  <tr class="border-b border-line-strong text-xs text-ink-3">
                    <th scope="col" class="py-2 pr-4 font-medium">渠道</th>
                    <th scope="col" class="py-2 pr-4 font-medium">品类 / 工艺</th>
                    <th scope="col" class="py-2 pr-4 font-medium">价格档</th>
                    <th scope="col" class="py-2 font-medium">社区备注</th>
                  </tr>
                </thead>
                <tbody>
                  {suppliers.map(supplier => (
                    <tr class="border-b border-line align-top last:border-b-0">
                      <th scope="row" class="py-2.5 pr-4 font-semibold text-ink">{supplier.name}</th>
                      <td class="py-2.5 pr-4 text-ink-2">{supplier.category || supplier.role || '—'}</td>
                      <td class="mono tabular py-2.5 pr-4 text-ink-2">{supplier.price_level || '—'}</td>
                      <td class="py-2.5 leading-6 text-ink-3">{supplier.note || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-ink-3">社区记录仅供找店线索，本站不背书、不代购。</p>
          </>
        ) : (
          <p class="mt-2 text-sm leading-6 text-ink-3">
            暂无可靠渠道收录 —— 这不等于买不到，只是还没找到可核对的店。欢迎在
            <a href={withBase('/suppliers.html')} class="font-medium text-brand hover:underline">采购库</a>补充。
          </p>
        )}
      </section>

      {applications.length > 0 && (
        <section class="card p-5 sm:p-6" aria-labelledby="applications">
          <h2 id="applications" class="text-base font-bold tracking-tight text-ink">典型应用</h2>
          <ul class="chip-row mt-3" role="list">
            {applications.map(item => <li class={chipClass}>{item}</li>)}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-4 lg:sticky lg:top-20">
      <section class="card p-5" aria-labelledby="data-version">
        <h2 id="data-version" class="text-sm font-bold tracking-tight text-ink">数据版本</h2>
        <dl class="mt-3 space-y-2.5 text-sm">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-ink-3">最近核对</dt>
            <dd class="mono tabular font-medium text-ink">{entry.last_checked || '—'}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-ink-3">公开参数</dt>
            <dd class="mono tabular font-medium text-ink">{filled} / {rows.length}</dd>
          </div>
        </dl>
        {entry.origin && (
          <p class="mt-3 rounded-md border border-line bg-surface-2 p-3 text-xs leading-5 text-ink-2">{entry.origin}</p>
        )}
      </section>

      {related.length > 0 && (
        <section class="card p-5" aria-labelledby="related">
          <h2 id="related" class="text-sm font-bold tracking-tight text-ink">
            {isProcess ? '可加工材料' : '加工工艺'}
            <span class="mono tabular ml-1.5 text-xs font-normal text-ink-3">{related.length}</span>
          </h2>
          <ul class="mt-3 space-y-1" role="list">
            {related.map(item => (
              <li>
                <a
                  href={withBase(`/materials/${item._href}.html`)}
                  class="-mx-2 flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-ink-2 transition-colors hover:bg-surface-3 hover:text-brand"
                >
                  <span class="min-w-0 truncate">{item.name}</span>
                  <span class="shrink-0 text-xs text-ink-3" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(sources.length > 0 || entry.url || (docUrl && docUrl !== entry.url)) && (
        <section class="card p-5" aria-labelledby="source-list">
          <h2 id="source-list" class="text-sm font-bold tracking-tight text-ink">来源清单</h2>
          <ul class="mt-3 space-y-1.5 text-xs leading-5" role="list">
            {entry.url && (
              <li>
                <a href={entry.url} target="_blank" rel="noopener" class="flex items-baseline gap-1 text-brand hover:underline">
                  主要来源<span class="sr-only">（新窗口打开）</span><span aria-hidden="true">↗</span>
                </a>
              </li>
            )}
            {docUrl && docUrl !== entry.url && (
              <li>
                <a href={docUrl} target="_blank" rel="noopener" class="flex items-baseline gap-1 text-brand hover:underline">
                  公开资料<span class="sr-only">（新窗口打开）</span><span aria-hidden="true">↗</span>
                </a>
              </li>
            )}
            {sources.map(source => (
              <li>
                <a href={source.url} target="_blank" rel="noopener" class="break-all text-brand hover:underline">
                  {source.kind || '参考'}{source.checked_on ? ` · ${source.checked_on}` : ''} ↗
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="rounded-md border border-line bg-surface-2 p-5" aria-labelledby="fix">
        <h2 id="fix" class="text-sm font-bold tracking-tight text-ink">纠错入口</h2>
        <p class="mt-2 text-xs leading-5 text-ink-3">
          参数或渠道信息有误？带上供应商报价单或官方资料提交，核对后更新这一页。
        </p>
        <a
          href={withBase('/submit.html')}
          class="mt-3 inline-flex h-9 items-center rounded-md bg-brand px-3.5 text-sm font-semibold text-brand-fg transition-colors hover:bg-brand-hover"
        >
          提交纠错
        </a>
      </section>
    </aside>
  </div>
</Base>
