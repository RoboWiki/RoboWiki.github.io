---
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/library/Breadcrumbs.astro'
import SpecTable from '@/components/library/SpecTable.astro'
import { specRows } from '@/components/library/specs'
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import materialsData from '@/data/materials.json'
import { withBase } from '@/lib/utils'

type Form = { form: string; spec?: string | null; note?: string | null }
type Ref = { id: string; name: string; _href: string }
type SupplierRef = {
  id: string
  name: string
  category?: string | null
  fine?: string | null
  role?: string | null
  price_level?: string | null
  note?: string | null
}
type Item = {
  id: string
  category: 'material' | 'process'
  group_label: string
  family_label: string
  name: string
  name_en?: string | null
  title: string
  aliases?: string[]
  url?: string | null
  sources?: Array<{ url: string; kind?: string; checked_on?: string }>
  source_tier?: string | null
  verified?: number
  last_checked?: string | null
  origin?: string | null
  specs: Record<string, unknown>
  forms?: Form[] | null
  applications?: string[] | null
  pros?: string | null
  cons?: string | null
  notes?: string | null
  _href: string
  _processes?: Ref[]
  _materials?: Ref[]
  _suppliers?: SupplierRef[]
}
type Entry = Item & { kind: 'material' | 'process' }

export function getStaticPaths() {
  const entries: Entry[] = [
    ...(materialsData.materials as unknown as Item[]).map(item => ({ ...item, kind: 'material' as const })),
    ...(materialsData.processes as unknown as Item[]).map(item => ({ ...item, kind: 'process' as const })),
  ]
  return entries.map(entry => ({ params: { slug: entry._href }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Entry }
const isProcess = entry.kind === 'process'
const forms = entry.forms ?? []
const applications = entry.applications ?? []
const related = isProcess ? (entry._materials ?? []) : (entry._processes ?? [])
const suppliers = entry._suppliers ?? []
const sources = (entry.sources ?? []).filter(source => source.url)
const priceNote = typeof entry.specs.price_note === 'string' ? entry.specs.price_note : null
const priceLevel = typeof entry.specs.price_level === 'string' ? entry.specs.price_level : null
const simNote = typeof entry.specs.sim_note === 'string' ? entry.specs.sim_note : null
const toleranceNote = typeof entry.specs.tolerance_note === 'string' ? entry.specs.tolerance_note : null
const docUrl = typeof entry.specs.doc_url === 'string' ? entry.specs.doc_url : null
const chipClass =
  'inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs text-slate-600'
const linkChipClass = `${chipClass} hover:border-blue-300 hover:text-blue-700`
---

<Base
  title={`${entry.title} · 材质库 · RoboWiki`}
  description={`${entry.title}（${entry.family_label}）的公开参数、形态规格、加工工艺与来源。`}
>
  <Breadcrumbs
    items={[
      { label: '首页', href: '/' },
      { label: '材质库', href: '/materials.html' },
      { label: entry.title },
    ]}
  />

  <header class="mb-6">
    <div class="flex flex-wrap items-center gap-1.5">
      <Badge variant={isProcess ? 'warning' : 'secondary'}>{isProcess ? '加工工艺' : entry.group_label}</Badge>
      <Badge variant="outline">{entry.family_label}</Badge>
      {entry.source_tier && <Badge variant="outline">来源 {entry.source_tier} 级</Badge>}
      <Badge variant={entry.verified ? 'success' : 'secondary'}>{entry.verified ? '已核对' : '待复核'}</Badge>
    </div>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">{entry.title}</h1>
    {entry.name_en && <p class="mt-1 text-sm text-slate-500">{entry.name_en}</p>}
    {entry.aliases && entry.aliases.length > 0 && (
      <p class="mt-2 text-xs text-slate-400">别名：{entry.aliases.join(' / ')}</p>
    )}
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-6">
      {entry.notes && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="intro">
          <h2 id="intro" class="font-semibold text-slate-900">简介</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{entry.notes}</p>
        </section>
      )}

      <SpecTable
        id="specs"
        title={isProcess ? '工艺能力' : '物理属性与仿真'}
        rows={specRows(isProcess ? 'process' : 'material', entry.specs)}
        note={isProcess ? toleranceNote : simNote}
        hint={isProcess ? '公差、交期与成本随厂商、批量与结构变化，下单前以报价单为准。' : '数值为常温典型值；热处理状态、纤维方向与批次会让实际值偏离。'}
      />

      {forms.length > 0 && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="forms">
          <h2 id="forms" class="font-semibold text-slate-900">形态与规格</h2>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[480px] text-left text-sm">
              <caption class="sr-only">{entry.title} 可提供的形态与对应规格</caption>
              <thead>
                <tr class="border-b border-slate-200 text-xs text-slate-500">
                  <th scope="col" class="py-2 pr-3 font-medium">形态</th>
                  <th scope="col" class="py-2 pr-3 font-medium">规格</th>
                  <th scope="col" class="py-2 font-medium">说明</th>
                </tr>
              </thead>
              <tbody>
                {forms.map(form => (
                  <tr class="border-b border-slate-100 align-top">
                    <th scope="row" class="py-2 pr-3 font-medium text-slate-800">{form.form}</th>
                    <td class="py-2 pr-3 text-slate-600">{form.spec || '—'}</td>
                    <td class="py-2 text-slate-500">{form.note || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="related">
          <h2 id="related" class="font-semibold text-slate-900">{isProcess ? '可加工材料' : '加工工艺'}</h2>
          <ul class="mt-3 flex flex-wrap gap-2" role="list">
            {related.map(item => (
              <li>
                <a href={withBase(`/materials/${item._href}.html`)} class={linkChipClass}>{item.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {applications.length > 0 && (
        <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="applications">
          <h2 id="applications" class="font-semibold text-slate-900">典型应用</h2>
          <ul class="mt-3 flex flex-wrap gap-2" role="list">
            {applications.map(item => <li class={chipClass}>{item}</li>)}
          </ul>
        </section>
      )}

      {(entry.pros || entry.cons) && (
        <div class="grid gap-4 sm:grid-cols-2">
          {entry.pros && (
            <section class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-5" aria-labelledby="pros">
              <h2 id="pros" class="text-sm font-semibold text-emerald-800">优点</h2>
              <p class="mt-2 text-sm leading-6 text-slate-700">{entry.pros}</p>
            </section>
          )}
          {entry.cons && (
            <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5" aria-labelledby="cons">
              <h2 id="cons" class="text-sm font-semibold text-amber-800">限制</h2>
              <p class="mt-2 text-sm leading-6 text-slate-700">{entry.cons}</p>
            </section>
          )}
        </div>
      )}

      <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="suppliers">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="suppliers" class="font-semibold text-slate-900">渠道与价格</h2>
          <a href={withBase('/suppliers.html')} class="text-xs text-blue-700 hover:underline">渠道库 →</a>
        </div>
        {priceNote || priceLevel ? (
          <p class="mt-2 text-sm leading-6 text-slate-600">
            参考价格档：<strong>{priceLevel || '—'}</strong>
            {priceNote ? `。${priceNote}` : ''}
          </p>
        ) : null}
        {suppliers.length > 0 ? (
          <>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full min-w-[560px] text-left text-sm">
                <caption class="sr-only">与本条目相关的社区渠道记录，仅作线索，不构成推荐</caption>
                <thead>
                  <tr class="border-b border-slate-200 text-xs text-slate-500">
                    <th scope="col" class="py-2 pr-3 font-medium">渠道</th>
                    <th scope="col" class="py-2 pr-3 font-medium">品类 / 工艺</th>
                    <th scope="col" class="py-2 pr-3 font-medium">价格档</th>
                    <th scope="col" class="py-2 font-medium">社区备注</th>
                  </tr>
                </thead>
                <tbody>
                  {suppliers.map(supplier => (
                    <tr class="border-b border-slate-100 align-top">
                      <th scope="row" class="py-2 pr-3 font-medium text-slate-800">{supplier.name}</th>
                      <td class="py-2 pr-3 text-slate-600">{supplier.category || supplier.role || '—'}</td>
                      <td class="py-2 pr-3 text-slate-600">{supplier.price_level || '—'}</td>
                      <td class="py-2 text-slate-500">{supplier.note || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-slate-400">社区记录仅供找店线索，本站不背书、不代购。</p>
          </>
        ) : (
          <p class="mt-2 text-sm leading-6 text-slate-500">
            暂无可靠渠道收录 —— 这不等于买不到，只是还没找到可核对的店。欢迎在
            <a href={withBase('/suppliers.html')} class="text-blue-700 hover:underline">渠道库</a>补充。
          </p>
        )}
      </section>
    </div>

    <aside class="space-y-4">
      <Card>
        <CardContent className="space-y-3 text-sm">
          <h2 class="font-semibold text-slate-900">数据口径</h2>
          <dl class="space-y-2">
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">来源等级</dt>
              <dd class="font-medium">{entry.source_tier ? `${entry.source_tier} 级` : '—'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">核对状态</dt>
              <dd class="font-medium">{entry.verified ? '已核对' : '待复核'}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">最近核对</dt>
              <dd class="font-medium tabular-nums">{entry.last_checked || '—'}</dd>
            </div>
          </dl>
          {entry.origin && (
            <p class="rounded-lg bg-slate-50 p-3 text-xs leading-5 text-slate-600">{entry.origin}</p>
          )}
          {entry.url && (
            <a href={entry.url} target="_blank" rel="noopener" class="inline-flex text-blue-700 hover:underline">
              查看主要来源<span class="sr-only">（新窗口打开）</span> ↗
            </a>
          )}
          {docUrl && docUrl !== entry.url && (
            <a href={docUrl} target="_blank" rel="noopener" class="inline-flex text-blue-700 hover:underline">
              公开资料<span class="sr-only">（新窗口打开）</span> ↗
            </a>
          )}
          {sources.length > 0 && (
            <div class="border-t border-slate-100 pt-3">
              <h3 class="text-xs font-semibold text-slate-700">来源清单</h3>
              <ul class="mt-2 space-y-1.5 text-xs leading-5" role="list">
                {sources.map(source => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener" class="break-all text-blue-700 hover:underline">
                      {source.kind || '参考'}{source.checked_on ? ` · ${source.checked_on}` : ''} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <a href={withBase('/method.html')} class="block border-t border-slate-100 pt-3 text-xs text-slate-500 hover:text-blue-700">
            来源等级怎么算 →
          </a>
        </CardContent>
      </Card>
    </aside>
  </div>
</Base>
