---
import '../styles/global.css'
import SeoJsonLd from '@/components/SeoJsonLd.astro'
import SitePet from '@/components/pets/SitePet.astro'

// GitHub Pages 支持根路径，也支持项目页（/repo/）。链接统一走 BASE_URL，避免写死。
const base = import.meta.env.BASE_URL
const homeHref = base
const catalogHref = `${base}catalog.html`
const title = '页面走丢了 · 404 · RoboWiki'
const description = '这个地址没有对应页面。回到 RoboWiki 首页，或者去部件库按品类找件。'
const links = [
  { href: catalogHref, title: '部件库', desc: '按品类、厂商与参数筛选硬件。' },
  { href: `${base}builds.html`, title: '方案库', desc: '看可复现方案的结构、电控与踩坑。' },
  { href: `${base}learn/index.html`, title: '教程库', desc: '经典 PDF 与本站导读，按方向筛选。' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement
          const modes = ['warm', 'dark', 'ios', 'ios-dark', 'test', 'test-dark']
          let mode = localStorage.getItem('rw-theme') || 'warm'
          if (mode === 'light' || mode === 'system' || mode === 'contrast') mode = 'warm'
          if (!modes.includes(mode)) mode = 'warm'
          const theme = mode
          root.dataset.theme = theme
          root.dataset.themeMode = theme
          root.classList.toggle('dark', theme === 'dark' || theme === 'ios-dark' || theme === 'test-dark')
          root.style.colorScheme = theme === 'dark' || theme === 'ios-dark' || theme === 'test-dark' ? 'dark' : 'light'
        } catch {}
      })()
    </script>
    <script is:inline src={`${base}vendor/ds-pet/mount.js`} data-base={base} defer></script>
  </head>
  <body class="min-h-screen bg-bg text-ink antialiased">
    <header class="sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
        <a href={homeHref} class="flex items-center gap-2.5 font-bold tracking-tight">
          <img
            src={`${base}logo-mark.png`}
            alt=""
            width="40"
            height="28"
            class="h-7 w-10 object-contain dark:invert"
          />
          <span class="text-base">RoboWiki</span>
        </a>
        <nav class="ml-2 hidden items-center gap-0.5 lg:flex" aria-label="主导航">
          <a href={homeHref} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">首页</a>
          <a href={`${base}learn/index.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">教程库</a>
          <a href={`${base}selector.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">选型台</a>
          <a href={catalogHref} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">部件库</a>
          <a href={`${base}builds.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">方案库</a>
          <a href={`${base}suppliers.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">采购库</a>
          <a href={`${base}equipment.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">设备库</a>
          <a href={`${base}community.html`} class="rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 hover:text-ink">社区</a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a href="https://github.com/RoboWiki/RoboWiki" class="hidden rounded-md px-3 py-1.5 text-sm text-ink-2 hover:bg-surface-3 sm:flex" target="_blank" rel="noopener">GitHub 仓库</a>
          <a href={`${base}account.html`} class="rounded-md bg-brand px-3.5 py-1.5 text-sm font-semibold text-brand-fg hover:bg-brand-hover">账号</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16">
      <section class="card relative overflow-hidden px-6 py-12 sm:px-10 sm:py-16">
        <div
          class="pointer-events-none absolute inset-0 opacity-50 dark:opacity-30"
          style="background-image:linear-gradient(to right, var(--rw-border) 1px, transparent 1px),linear-gradient(to bottom, var(--rw-border) 1px, transparent 1px);background-size:44px 44px;mask-image:radial-gradient(ellipse at 30% 0%,#000 20%,transparent 70%)"
          aria-hidden="true"
        >
        </div>
        <div class="relative max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 px-3 py-1 text-xs text-ink-2">
            <span class="mono">HTTP 404</span>
            <span class="text-ink-3">·</span>
            没有这个页面
          </div>
          <h1 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-5xl">
            这个地址没有对应内容。
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-7 text-ink-2">
            链接可能过期，或者型号已经改名。回首页重新进入，或者直接去部件库按品类找件。
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={homeHref} class="inline-flex h-11 items-center rounded-md bg-brand px-6 text-sm font-semibold text-brand-fg transition-colors hover:bg-brand-hover">
              返回首页 →
            </a>
            <a href={catalogHref} class="inline-flex h-11 items-center rounded-md border border-line bg-surface px-6 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-2">
              浏览部件库
            </a>
          </div>
        </div>
      </section>

      <section class="mt-6 grid gap-3 sm:grid-cols-3">
        {links.map(link => (
          <a href={link.href} class="card card-hover p-5">
            <div class="text-sm font-semibold text-ink">{link.title} →</div>
            <p class="mt-1.5 text-sm leading-6 text-ink-3">{link.desc}</p>
          </a>
        ))}
      </section>

      <SeoJsonLd type="WebPage" title={title} description={description} url={Astro.url} />
    </main>

    <SitePet />

    <footer class="mt-16 border-t border-line bg-surface">
      <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-8 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>RoboWiki · 机器人制作工程知识库 · 教程、方案、采购、设备、社区与部件库都在同一站。不卖零件，不收佣金。</p>
        <p>AGPL-3.0 · 内容与数据来源见页面底部说明</p>
      </div>
    </footer>
  </body>
</html>
