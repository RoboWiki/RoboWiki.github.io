# 使用 Docker 内置的 Dockerfile 前端：这里没有用到 1.7 专有特性，
# 不写 `# syntax=` 可以少一次对 registry 的前端镜像解析（离线/受限网络更稳）。

# 前端全部由 GitHub Pages 构建；API 镜像只跑 FastAPI，不再打包 console。
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 先装依赖，利用层缓存；代码变更不重装依赖
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app

RUN useradd --create-home --uid 10001 app \
    && chown -R app:app /app
USER app

EXPOSE 8000

# API 只在内网（宿主机回环），1Panel OpenResty 是唯一入口；
# 信任其 X-Forwarded-For 才能按真实客户端限流
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips=*"]
