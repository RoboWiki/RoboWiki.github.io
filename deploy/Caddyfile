# RoboWiki 单机入口：静态由 Caddy 直出，API/控制台/MCP 反代到 FastAPI。
# 主域与 TLS 由 SITE_DOMAIN 控制；本地不设时用 localhost。
{
	auto_https {$AUTO_HTTPS:on}
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	header -Server
	header -Via

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# VitePress 有少量内联脚本（主题/暗色模式），因此脚本与样式保留
		# 'unsafe-inline'；外部脚本源仍被完全禁止。收紧到 nonce/hash 是后续工作。
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# 只读目录没有上传接口；给请求体一个上限，防止异常大包拖垮反代。
	request_body {
		max_size 10MB
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@images path /parts/*.png /parts/*.jpg /parts/*.webp /icon-*.png /og-*.png
	header @images Cache-Control "public, max-age=86400"
	@share path /share/*
	header @share Cache-Control "public, max-age=300"
	@revalidate path /sw.js /registerSW.js /manifest.webmanifest /console /console/ /console/index.html
	header @revalidate Cache-Control "no-cache"
	@console-assets path /console/assets/*
	header @console-assets Cache-Control "public, max-age=31536000, immutable"
	@html path *.html / /catalog /learn/* /method /submit /robots /software /suppliers /sources /contributors /semantics /notice /competitions/* /en/* /parts/*/
	header @html Cache-Control "public, max-age=300"
	@api path /api/*
	header @api Cache-Control "no-store"

	handle /api {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /mcp/* {
		reverse_proxy api:8000
	}

	redir /console /console/ 308

	handle /console/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		# 404 用站点自己的页面，而不是纯文本；状态码仍是 404。
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		root * /srv
		file_server
	}
}
