# 复制为 .env 后修改；不要提交 .env
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=change-me-strong
SECRET_KEY=change-me-at-least-32-bytes-long-000000
DATA_VERSION=data-v2026.11.0

# JSON 数组；生产加上主域
CORS_ORIGINS=["http://localhost:5173"]

# 静态站 dist（先 cd wiki && npm ci && npm run build）
STATIC_DIR=../wiki/docs/.vitepress/dist
# 核心仓数据 release（先 bash ../scripts/fetch-data-release.sh）
DATA_DIR=../.data/data
SCHEMA_DIR=../.data/schema

TAG=dev
