# 复制为 .env 后修改；不要提交 .env
SITE_DOMAIN=localhost
# 生产域名保持 on（自动证书）；本地 :80 明文测试用 off
# 本地小程序联调：AUTO_HTTPS=off + HTTP_PORT=8080，API 走 http://127.0.0.1:8080/api/v1
AUTO_HTTPS=on
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=change-me-strong
SECRET_KEY=change-me-at-least-32-bytes-long-000000
# 留空跟随 data.lock.json；只有临时覆盖才填
DATA_VERSION=
SITE_URL=https://robowiki.org.cn
# 群机器人共享令牌；留空则 /api/v1/bot/answer 关闭
BOT_TOKEN=

# 邮箱验证 / 找回密码：log 只打印到容器日志；生产用 smtp
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RoboWiki <no-reply@example.com>
SMTP_STARTTLS=true

# 生产关闭 Swagger UI；OpenAPI JSON 仍可用于生成 SDK
EXPOSE_DOCS=false

# 首次启动创建/更新站务账号；生产必须设置，密码由部署环境掌握
ADMIN_HANDLE=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=站务

# worker 发布：dryrun 只写本地产物；github 才会开 PR
PUBLISH_MODE=dryrun
# 细粒度 token：仅核心仓 contents:write + pull_requests:write
GITHUB_TOKEN=
CORE_REPO=RoboWiki/RoboWiki
CORE_BRANCH=main

# JSON 数组；生产加上主域
CORS_ORIGINS=["http://localhost:5173"]

# 静态站 dist（先 cd wiki && npm ci && npm run build）
STATIC_DIR=../wiki/docs/.vitepress/dist
# 核心仓数据 release（先 bash ../scripts/fetch-data-release.sh）
DATA_DIR=../.data/data
SCHEMA_DIR=../.data/schema

TAG=dev
