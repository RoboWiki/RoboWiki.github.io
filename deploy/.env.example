# 复制为 .env 后修改；不要提交 .env。
# 生产必须把三个密钥填成随机值（示例留空，compose 的 :? 会拒绝空值启动）：
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
#   SECRET_KEY=$(openssl rand -hex 32)
#   ADMIN_PASSWORD=$(openssl rand -base64 18)

# API 只发布到宿主机回环，供 1Panel OpenResty 反代；不要改成 0.0.0.0。
API_PORT=8080

POSTGRES_PASSWORD=
SECRET_KEY=
# 留空跟随 data.lock.json；只有临时覆盖才填
DATA_VERSION=
SITE_URL=https://robowiki.org.cn
# 群机器人共享令牌；留空则 /api/v1/bot/answer 关闭
BOT_TOKEN=

# ── 账号 / 第三方登录 ─────────────────────────────────────────────────────
# 两项都填才会出现在 /api/v1/auth/providers（github=true）并启用登录按钮；
# 任意一项留空 = 按钮禁用，请求直接 503，不会外跳。
# GitHub OAuth App 的 Authorization callback URL 填：
#   https://robowiki.org.cn/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 反代后回调的对外根；留空跟随请求 host，生产建议显式填主域
OAUTH_REDIRECT_BASE=

# 微信小程序登录（可选）：AppSecret 只放服务端，不要进小程序包。
# 两项都填才会在 providers 里返回 wechat_mini=true。
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# 邮箱验证 / 找回密码：log 只打印到容器日志（令牌会进日志，仅限开发）；
# 生产必须用 smtp，否则验证/重置邮件不会真正发出。
# EMAIL_MODE=smtp 时必填：SMTP_HOST、SMTP_PORT、SMTP_FROM；
# 服务商要求认证时再加 SMTP_USER + SMTP_PASSWORD（STARTTLS 保持 true）。
# 发信失败会抛 MailError：验证邮件接口回 503 并写 robowiki.mailer 日志；
# 找回密码仍回 202（防邮箱枚举），失败原因只进日志，不会静默当成功。
# 自测命令见 deploy/README.md「邮件与第三方登录」。
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RoboWiki <no-reply@robowiki.org.cn>
SMTP_STARTTLS=true

# 生产关闭 Swagger UI；OpenAPI JSON 仍可用于生成 SDK
EXPOSE_DOCS=false

# 首次启动创建/更新站务账号；生产必须设置，密码由部署环境掌握。
# 每次启动都会把库里的密码重置为这里的值，改密要改 env 再重启。
ADMIN_HANDLE=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=站务

# worker 发布：dryrun 只写本地产物；github 才会开 PR。
# github 模式要求 worker 能读到 /data（compose 已挂载）且 token 有核心仓
# contents:write + pull_requests:write。
PUBLISH_MODE=dryrun
GITHUB_TOKEN=
CORE_REPO=RoboWiki/RoboWiki
CORE_BRANCH=main

# JSON 数组；生产填主域（同域反代其实不需要 CORS，这里主要给本地 dev 用）
CORS_ORIGINS=["http://localhost:5173","https://robowiki.org.cn"]

# 核心仓数据 release（先 bash scripts/fetch-data-release.sh）
DATA_DIR=../.data/data
SCHEMA_DIR=../.data/schema
# Linux 宿主上 worker（uid 10001）需要写这个目录：
#   mkdir -p var/outbox && sudo chown -R 10001:10001 var/outbox

TAG=dev
