# 复制为 .env 后修改；不要提交 .env
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=change-me-strong
SECRET_KEY=change-me-at-least-32-bytes-long-000000
DATA_VERSION=data-v2026.11.0
SITE_URL=https://robowiki.org
# 群机器人共享令牌；留空则 /api/v1/bot/answer 关闭
BOT_TOKEN=

# worker 发布：dryrun 只写本地产物；github 才会开 PR
PUBLISH_MODE=dryrun
# 细粒度 token：仅核心仓 contents:write + pull_requests:write
GITHUB_TOKEN=
CORE_REPO=RoboWiki/RoboWiki
CORE_BRANCH=main

# JSON 数组；生产加上主域
CORS_ORIGINS=["http://localhost:5173"]

# 静态站 dist（先 cd wiki && npm ci && npm run build）
STATIC_DIR=../wiki/docs/.vitepress/dist
# 核心仓数据 release（先 bash ../scripts/fetch-data-release.sh）
DATA_DIR=../.data/data
SCHEMA_DIR=../.data/schema

TAG=dev
