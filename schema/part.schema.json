{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/RoboWiki/RoboWiki.github.io/schema/part.schema.json",
 "title": "部件（data/catalog/<品类>/<厂商>.json 中的一条）",
 "description": "PR、issue 表单、API 入参共用这一份定义。改字段先改这里。",
 "type": "object",
 "required": [
  "category",
  "subtype",
  "id",
  "vendor",
  "model",
  "title",
  "source_tier",
  "verified",
  "specs"
 ],
 "additionalProperties": true,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[^\\s/]{2,96}$",
   "description": "稳定标识。一经发布不要改：评分、讨论、外链都挂在它上面。"
  },
  "category": {
   "enum": [
    "actuator",
    "servo",
    "sensor",
    "controller_high",
    "controller_low",
    "remote_controller",
    "esc",
    "imu",
    "lidar",
    "camera",
    "battery",
    "connector",
    "module",
    "chip"
   ]
  },
  "subtype": {
   "type": "string"
  },
  "vendor": {
   "type": "string",
   "minLength": 1
  },
  "vendor_cn": {
   "type": [
    "string",
    "null"
   ]
  },
  "model": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string",
   "minLength": 2
  },
  "url": {
   "type": [
    "string",
    "null"
   ],
   "format": "uri"
  },
  "source_tier": {
   "enum": [
    "A",
    "B",
    "C"
   ],
   "description": "A=逐项核对过厂商手册；B=公开网页；C=转述。等级决定敢不敢拿它做热设计。"
  },
  "verified": {
   "type": "boolean"
  },
  "last_checked": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "price_cny": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0
  },
  "origin": {
   "type": [
    "string",
    "null"
   ]
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  },
  "specs": {
   "type": "object",
   "description": "缺失字段写 null，不要省略 key —— 省略会让读侧分不清「没公布」和「没这个属性」。",
   "properties": {
    "tau_peak_Nm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "tau_rated_Nm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "tau_stall_Nm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "tau_basis": {
     "enum": [
      "peak",
      "rated",
      null
     ]
    },
    "gear": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 1,
     "maximum": 300
    },
    "mass_kg": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "rotor_inertia_kgm2": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "inertia_basis": {
     "enum": [
      "rotor",
      "output",
      null
     ]
    },
    "armature_kgm2": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "voltage_V": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 1,
     "maximum": 1000
    },
    "speed_noload_rpm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "speed_rated_rpm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "kt_Nm_per_A": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "pole_pairs": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 1
    },
    "encoder": {
     "type": [
      "string",
      "null"
     ]
    },
    "comm": {
     "type": [
      "string",
      "null"
     ]
    },
    "ip": {
     "type": [
      "string",
      "null"
     ]
    },
    "image_url": {
     "type": [
      "string",
      "null"
     ]
    },
    "image_source": {
     "type": [
      "string",
      "null"
     ]
    },
    "doc_url": {
     "type": [
      "string",
      "null"
     ],
     "description": "厂商官方文档页"
    },
    "doc_pdf": {
     "type": [
      "string",
      "null"
     ],
     "description": "官方手册 / 数据手册 PDF 直链"
    },
    "repo_urls": {
     "type": [
      "array",
      "null"
     ],
     "description": "相关开源仓库（官方 SDK、驱动、例程）",
     "items": {
      "type": "string"
     }
    },
    "imu": {
     "type": [
      "string",
      "null"
     ],
     "description": "板载 IMU 型号（相机等模组用）"
    },
    "channels": {
     "type": [
      "number",
      "null"
     ],
     "description": "遥控器通道数"
    },
    "frequency_ghz": {
     "type": [
      "number",
      "null"
     ],
     "description": "遥控器频段（GHz）"
    },
    "control_range_m": {
     "type": [
      "number",
      "null"
     ],
     "description": "遥控距离（m），按厂商口径记录"
    },
    "protocol": {
     "type": [
      "string",
      "null"
     ],
     "description": "输出协议 / 总线协议"
    },
    "battery": {
     "type": [
      "string",
      "null"
     ],
     "description": "电池或支持电池规格"
    },
    "can_speed_mbps": {
     "type": [
      "number",
      "null"
     ],
     "description": "CAN / CAN FD 速率（Mbps）"
    },
    "canfd": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "isolation": {
     "type": [
      "boolean",
      "null"
     ],
     "description": "总线是否电气隔离"
    },
    "connector": {
     "type": [
      "string",
      "null"
     ],
     "description": "接线端子 / 接头规格"
    },
    "repo_license": {
     "type": [
      "string",
      "null"
     ],
     "description": "引用仓库的许可（MIT/Apache-2.0/BSD-3-Clause/…）。读不到写 null，表示未核，不猜。"
    },
    "positions": {
     "type": ["number", "null"],
     "minimum": 1,
     "maximum": 100,
     "description": "触点数。2+2 混合连接器填总触点数，电源/信号拆分见 power_positions / signal_positions。"
    },
    "positions_options": {
     "type": ["array", "null"],
     "items": {"type": "integer", "minimum": 1},
     "description": "同一系列可选触点数；代表位数写在 positions。"
    },
    "pitch_mm": {
     "type": ["number", "null"],
     "exclusiveMinimum": 0,
     "description": "相邻触点中心距（mm）；RF/混合连接器可能不适用。"
    },
    "current_rated_A": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "连接器每触点标称电流；必须配 current_basis 说明测试条件。"
    },
    "voltage_rated_V": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "厂商标称的电压等级；与 withstand_voltage_V（耐压试验）区分。"
    },
    "current_basis": {
     "type": ["string", "null"],
     "description": "电流口径：UL 额定 / MAX / 温升试验值，以及线规、温升条件。"
    },
    "contact_resistance_mohm": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "接触电阻（mΩ）。"
    },
    "insulation_resistance_mohm": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "绝缘电阻（MΩ）。"
    },
    "withstand_voltage_V": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "介质耐压试验电压（V），不是工作电压。"
    },
    "mating_cycles": {
     "type": ["integer", "null"],
     "minimum": 0,
     "description": "插拔寿命（次）。"
    },
    "temp_range_C": {
     "type": ["string", "null"],
     "description": "工作温度范围，例如 -40~+105。"
    },
    "wire_awg": {
     "type": ["string", "null"],
     "description": "适用线规范围，例如 AWG 30–26。"
    },
    "mount_type": {
     "type": ["string", "null"],
     "description": "线端 / 板端 / 直插 / 弯插 / 面板等安装方式。"
    },
    "lock_type": {
     "type": ["string", "null"],
     "description": "锁扣方式：摩擦锁 / 卡扣 / 螺纹 / 卡口。"
    },
    "power_positions": {
     "type": ["integer", "null"],
     "minimum": 0,
     "description": "混合连接器的电源触点数。"
    },
    "signal_positions": {
     "type": ["integer", "null"],
     "minimum": 0,
     "description": "混合连接器的信号触点数。"
    },
    "signal_current_rated_A": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "信号针标称电流（A）。"
    },
    "contact_layout": {
     "type": ["string", "null"],
     "description": "触点布局，例如 2 电源 + 2 信号（2+2）。"
    },
    "instantaneous_current_A": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "短时/瞬时电流（A）；持续时间和温升条件写在 current_basis。"
    },
    "use_cases": {
     "type": ["array", "null"],
     "items": {"type": "string"},
     "description": "编辑整理的适用场景，不是厂商规格；不参与数值比较。"
    },
    "impedance_ohm": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "射频连接器特性阻抗（Ω）。"
    },
    "freq_max_ghz": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "射频连接器最高工作频率（GHz）。"
    },
    "length_m": {
     "type": ["number", "null"],
     "minimum": 0,
     "description": "成品线束长度（m）。"
    },
    "awg": {
     "type": ["string", "null"],
     "description": "成品线束线规。"
    }
   }
  }
 }
}
