__pycache__/
*.pyc
.pytest_cache/
robowiki.db
robowiki.db-wal
robowiki.db-shm
node_modules/
.venv/
.env
*.egg-info/
.pnpm-store/

# 开发期的一次性产物：截图、探针脚本、日志 —— 不进库
shot-*.*
_dev.log
_*.py
_*.js
_*.txt
audit-*.png

# 测试用的一次性沙箱
.tmp-validate/

# 核心仓数据发布物（Pages/本地构建时下载，不提交）
.data/
.data.new/
.data.prev/
.data.lock
.openapi.tmp.json
deploy/.deployed-rev

# 厂商原始 PDF / 抓取缓存（40 MB）：可由归档文档复现，不入库
data/raw/

# VitePress 文档站：内容由 pipeline/build_site.py 生成，产物不入库

# 派生的归档 JSONL（10.4 MB）：可由 tools/inventory_archive.py + normalize_archive.py
# 从本地归档重建，不入库。词表与报告留着小，方便直接读。
data/_inventory/*.jsonl

# inbox 是丢图的暂存区：图片认领后进 data/assets/parts，暂存区只留说明
inbox/*
!inbox/README.md

# 历史归档与旧采集产物（仓库外：00_open/roboselect-archive，见其 MANIFEST.md）
data/_backup/
data/motors.json
data/motors_zju.json
data/focus.json
ui-*.png
.pytest-tmp/

# 只忽略**仓库根目录**的图片（截图核对用），public/ 下的素材图不受影响
/*.png
/*.jpg
/*.jpeg

# 浏览器调试产物
.playwright-cli/

# 数据快照导出产物（tools/export_data.py）：tar.gz / MANIFEST 属发布物，
# 走 GitHub Release 分发，不进仓库历史。规则见 docs/DATA-VERSIONING.md
dist/
.tmp-data-export/

# TypeScript 增量构建缓存

# 数据备份（可能含 PII）
deploy/backup/*.dump
deploy/backup/*.dump.tmp
deploy/backup/robowiki-media-*.tar.gz

# 可选卫星社区（NodeBB）的本地配置：含 secret 与数据库口令
deploy/community/

# outbox 运行时产物（测试/生产）
deploy/var/outbox/*.json

# 微信开发者工具个人设置（关闭域名校验等，不入库）

# 评论配图（P1 媒体上传）
deploy/var/media/

# Astro / Taro build caches
apps/*/.astro/
apps/*/.swc/

# VitePress 构建临时文件

# 生成物：pipeline web_export 写入，构建时重新生成
apps/web/src/data/*.json
apps/web/public/parts/
apps/web/public/share/
apps/web/public/llms.txt
apps/web/public/*.json

# pipeline 的中间产物（不再对外发布）
.build/
