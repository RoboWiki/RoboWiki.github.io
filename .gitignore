__pycache__/
*.pyc
.pytest_cache/
roboselect.db
roboselect.db-wal
roboselect.db-shm
node_modules/
frontend/dist/
.venv/
.env

# 开发期的一次性产物：截图、探针脚本、日志 —— 不进库
shot-*.*
_dev.log
_*.py
_*.js

# 测试用的一次性沙箱
.tmp-validate/

# 厂商原始 PDF / 抓取缓存（40 MB）：可由 docs/ref-zju-wiki.md §5 复现，不入库
data/raw/
frontend/public/parts/*.pdf

# VitePress 文档站：内容由 pipeline/build_site.py 生成，产物不入库
wiki/node_modules/
wiki/docs/.vitepress/dist/
wiki/docs/.vitepress/cache/

# 文档站的产品图由 pipeline/build_site.py 从 frontend/public/parts 同步
wiki/docs/public/parts/
wiki/docs/public/catalog.json
# 派生的归档 JSONL（10.4 MB）：可由 tools/inventory_archive.py + normalize_archive.py
# 从本地归档重建，不入库。词表与报告留着小，方便直接读。
data/_inventory/*.jsonl

# inbox 是丢图的暂存区：图片认领后进 frontend/public/parts，暂存区只留说明
inbox/*
!inbox/README.md

# 历史归档与旧采集产物（仓库外：00_open/roboselect-archive，见其 MANIFEST.md）
data/_backup/
data/motors.json
data/motors_zju.json
data/focus.json
