{
    "description": "RoboWiki 目录（微信小程序）：只读查询 + 登录评分/讨论",
    "compileType": "miniprogram",
    "setting": {
        "urlCheck": true,
        "es6": true,
        "enhance": true,
        "postcss": true,
        "minified": true,
        "minifyWXML": true,
        "minifyWXSS": true,
        "showShadowRootInWxmlPanel": true,
        "babelSetting": {
            "ignore": [],
            "disablePlugins": [],
            "outputPath": ""
        },
        "coverView": false,
        "packNpmRelationList": [],
        "ignoreUploadUnusedFiles": true
    },
    "editorSetting": {
        "tabIndent": "insertSpaces",
        "tabSize": 4
    },
    "libVersion": "3.17.6",
    "packOptions": {
        "ignore": [
            {
                "value": "tests",
                "type": "folder"
            },
            {
                "value": "node_modules",
                "type": "folder"
            },
            {
                "value": "project.private.config.json",
                "type": "file"
            },
            {
                "value": "README.md",
                "type": "file"
            }
        ],
        "include": []
    },
    "appid": "wx13bffd77b0b597e2"
}