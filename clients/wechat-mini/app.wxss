page { background: #f8fafc; color: #0f172a; font-family: -apple-system, "PingFang SC", sans-serif; }
.wrap { padding: 24rpx; }
.card { background: #fff; border: 1rpx solid #e2e8f0; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.muted { color: #64748b; font-size: 24rpx; }
.tag { display: inline-block; padding: 4rpx 12rpx; border-radius: 999rpx; background: #e0f2fe; color: #0369a1; font-size: 22rpx; margin-right: 8rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f1f5f9; font-size: 26rpx; }
.row:last-child { border-bottom: 0; }
.search { background: #fff; border: 1rpx solid #cbd5e1; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx; border-radius: 12rpx; background: #fff; border: 1rpx solid #e2e8f0; font-size: 26rpx; }
.tab.on { background: #0b1220; color: #fff; border-color: #0b1220; }
.empty { text-align: center; color: #94a3b8; padding: 80rpx 0; font-size: 26rpx; }
