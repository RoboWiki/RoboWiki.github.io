/* 讨论正文里的本站配图：文本段 + <image mode="widthFix"> 混排。 */
.comment-image {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.comment-links {
  display: flex;
  padding: 8rpx 0;
}

.comment-links text { margin-right: 28rpx; }

.comment-links .danger { color: #b91c1c; }
