<view class="wrap">
  <view class="hero">
    <view class="hero-kicker">ROBOWIKI · 只读目录</view>
    <view class="hero-title">机器人硬件，先查清再买</view>
    <view class="hero-sub">参数有来源，未知就写未知；不卖零件、不收佣金。</view>
    <view class="hero-note">A 级逐项核对 · B 级公开资料汇编 · 缺失写「—」</view>
    <view class="hero-meta">
      <text>{{partCount || '—'}} 件部件</text>
      <text>{{materialCount || '—'}} 材料 / 工艺</text>
      <text wx:if="{{version}}">{{version}}</text>
    </view>
  </view>

  <view class="search-box">
    <input class="search" placeholder="搜型号 / 厂商 / 材料 / 工艺"
      value="{{q}}" bindinput="onSearch" bindconfirm="onSearchConfirm"
      confirm-type="search" />
    <text wx:if="{{q}}" class="search-clear" bindtap="clearSearch">×</text>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'parts' ? 'on' : ''}}" data-tab="parts" bindtap="switchTab">部件库</view>
    <view class="tab {{tab === 'materials' ? 'on' : ''}}" data-tab="materials" bindtap="switchTab">材质库</view>
  </view>

  <view class="share-row">
    <button class="btn share-btn" open-type="share">分享当前筛选</button>
  </view>

  <scroll-view class="cats" scroll-x enable-flex>
    <view wx:for="{{categories}}" wx:key="id"
      class="cat {{category === item.id ? 'on' : ''}}"
      data-id="{{item.id}}" bindtap="selectCategory">
      {{item.label}}<text wx:if="{{item.n}}"> {{item.n}}</text>
    </view>
  </scroll-view>

  <scroll-view wx:if="{{tab === 'materials' && materialGroups.length}}" class="cats" scroll-x enable-flex>
    <view class="cat {{materialGroup === item.id ? 'on' : ''}}"
      data-id="{{item.id}}" bindtap="selectMaterialGroup">
      {{item.label}} {{item.count}}
    </view>
  </scroll-view>

  <scroll-view wx:elif="{{tab === 'parts'}}" class="cats" scroll-x enable-flex>
    <view class="cat {{sort === 'featured' ? 'on' : ''}}" data-sort="featured" bindtap="selectSort">推荐</view>
    <view class="cat {{sort === 'price_asc' ? 'on' : ''}}" data-sort="price_asc" bindtap="selectSort">价格从低</view>
    <view class="cat {{sort === 'price_desc' ? 'on' : ''}}" data-sort="price_desc" bindtap="selectSort">价格从高</view>
  </scroll-view>

  <scroll-view wx:if="{{tab === 'materials'}}" class="cats" scroll-x enable-flex>
    <view class="cat {{materialSort === 'default' ? 'on' : ''}}" data-sort="default" bindtap="selectMaterialSort">默认</view>
    <view class="cat {{materialSort === 'density' ? 'on' : ''}}" data-sort="density" bindtap="selectMaterialSort">密度从高</view>
    <view class="cat {{materialSort === 'modulus' ? 'on' : ''}}" data-sort="modulus" bindtap="selectMaterialSort">模量从高</view>
    <view class="cat {{materialSort === 'tensile' ? 'on' : ''}}" data-sort="tensile" bindtap="selectMaterialSort">抗拉从高</view>
  </scroll-view>

  <view wx:if="{{error}}" class="error">
    {{error}}
    <text class="retry" bindtap="onSearchConfirm">重试</text>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length && !error}}" class="empty">
    没有结果；换个关键词，或切回「全部」
  </view>

  <block wx:for="{{items}}" wx:key="id">
    <view class="card item" data-id="{{item.id}}" bindtap="openItem">
      <image wx:if="{{item.image}}" class="thumb" src="{{item.image}}"
        mode="aspectFill" lazy-load data-index="{{index}}" binderror="onImageError" />
      <view wx:else class="glyph">{{item.glyph || 'R'}}</view>
      <view class="item-body">
        <view class="title">{{item.title || item.name}}</view>
        <view class="subline">{{item.subline}}</view>
        <view class="tags">
          <text class="tag {{item.tierColor}}">{{item.tierLabel}}</text>
          <text wx:if="{{item.verifiedLabel}}" class="tag a">{{item.verifiedLabel}}</text>
          <text wx:if="{{tab === 'materials'}}" class="tag">{{item.category === 'process' ? '工艺' : '材料'}}</text>
          <text wx:if="{{item.ratingCount}}" class="tag a">{{item.ratingAvg}} 分 · {{item.ratingCount}} 人</text>
        </view>
        <view class="item-foot">
          <text wx:if="{{tab === 'parts'}}" class="price">{{item.priceLabel}}</text>
          <text wx:else class="muted">{{item.source_tier === 'A' ? 'A 级典型值 · 已核对' : '公开资料汇编 · 设计前核对'}}</text>
          <text class="muted">{{item.source_tier ? '来源 ' + item.source_tier + ' 级' : ''}}</text>
        </view>
        <view class="card-actions">
          <button class="card-share" hover-class="none" open-type="share"
            data-id="{{item.id}}" catchtap="noop">分享这一条</button>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{items.length && hasMore}}" class="loadmore" bindtap="onReachBottom">
    {{loadingMore ? '加载中…' : '加载更多'}}
  </view>
  <view wx:if="{{items.length && !hasMore}}" class="footer">
    共 {{total}} 条{{version ? ' · ' + version : ''}}
  </view>
  <view class="footer">微信小程序为只读目录 · 投稿与纠错请到网页版</view>
</view>
